<Project>

  <PropertyGroup>
    <!--
      The half of the version a human decides: the product line. Bumping the minor is an editorial
      act — it says this release is different in kind from the last one — so it belongs in the
      repository, in a commit, reviewable. Nothing else in the tree may hardcode it; anything that
      needs it reads it from here (see DockerfileTests for the one place that must mirror it).
    -->
    <MajorMinorVersion>1.0</MajorMinorVersion>

    <!--
      The half a machine decides. release.yml takes the next build number not yet claimed by a
      v$(MajorMinorVersion).* tag and passes -p:BuildNumber=<n>, then tags the commit with the number
      it just built. Nobody types a version, and the tag, the packages and the image carry one number
      because they are all made from this one invocation.

      The suffix is set BEFORE the default below, and reads the caller's value rather than the
      defaulted one: a build with no build number is a local build, and it says so. That is the
      whole mechanism — `1.0.0-dev` is not a release and cannot be mistaken for one, while
      `1.0.0` from CI is the first release of the 1.0 line.
    -->
    <VersionSuffix Condition="'$(BuildNumber)' == ''">dev</VersionSuffix>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>

    <!--
      VersionPrefix rather than Version, deliberately. The SDK derives AssemblyVersion and
      FileVersion from the prefix and composes Version as prefix + suffix; setting Version outright
      would leave those two reading the SDK's own 1.0.0 default and silently disagreeing with the
      number in the package name.
    -->
    <VersionPrefix>$(MajorMinorVersion).$(BuildNumber)</VersionPrefix>

    <!--
      Set by CI to the commit being built. The SDK appends it to AssemblyInformationalVersion as
      "+<sha>", which is what makes a running container traceable to a commit rather than only to a
      version number that several builds may share.
    -->
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''"></SourceRevisionId>
  </PropertyGroup>

  <!--
    Package metadata shared by every packable project. Nothing is packable unless it opts in: the
    default here is off, and the four libraries turn it on individually. That way a new project (a
    test project especially) cannot start publishing itself by existing.

    The package version is the Version above, so a package, the image tag and the git tag are all
    the same number by construction.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>Martin Pospisil</Authors>

    <!--
      The XML comments in this codebase carry the reasoning, not just the signature. They belong in
      the packages, and — the reason this is here rather than beside the packaging metadata in
      .targets — the OpenAPI document is generated from them, so a comment that does not reach a
      .xml file beside its .dll is a description that does not reach a generated client.

      It must be set HERE, before the project body, and not in a condition on IsPackable. The SDK
      turns this flag into a DocumentationFile and into the DocFileItem that copies it next to the
      assembly, and it does both while importing its own targets — which happens BEFORE
      Directory.Build.targets. Setting it there leaves GenerateDocumentationFile reading `true`, the
      compiler writing the file into obj/, and nothing ever copying it to bin/: documentation that
      exists, is reported as enabled, and cannot be found by anything that looks for it. That is how
      every enum in Gleanvolt.Core reached the OpenAPI document with no description at all while the
      build claimed otherwise.

      Unconditional rather than packable-only, deliberately. A per-project opt-in is what produced
      the trap above, and the cost of a documentation file for a test project is a file nobody reads.
      CS1591 goes with it: "missing documentation" on every undocumented public member would bury the
      warnings that mean something.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      CS1591 ("missing XML comment") and CS1573 ("some parameters documented, not all") are both
      silenced, and for the same reason: they fire on a deliberate habit rather than on a mistake.
      Plenty of records here describe their obvious parameters in the summary prose and reserve
      <param> for the ones that need an argument made — ChargingControlDecision is the clearest
      example — and 136 warnings about that would bury the ones that mean something.

      CS1572 and CS1574 are NOT silenced, deliberately. Those are documentation that is *broken*
      rather than absent: a <param> naming a parameter that does not exist, or a <see cref> that does
      not resolve. Both put a dangling reference in the .xml, and therefore in the OpenAPI document
      and in whatever generates a client from it. Seven of them were already in the tree when this
      flag started working; the compiler should keep finding the next one.
    -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <!--
      The file rather than a PackageLicenseExpression: the terms then live inside the artifact
      instead of in a field beside it, and the package says whatever the repository's LICENSE says
      without this line having to be kept in step with it.
    -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/mpospisil/gleanvolt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mpospisil/gleanvolt.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>solax;modbus;solar;inverter;battery;ev-charger;home-assistant</PackageTags>

    <!-- Debugging a package should not mean cloning the repo first. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>

