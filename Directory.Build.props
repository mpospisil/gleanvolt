<Project>

  <PropertyGroup>
    <!--
      A placeholder, deliberately. The git tag is the source of truth for a release version: CI
      passes -p:Version=<tag without the leading v> when building from a v* tag, and the resulting
      number is what the image is tagged with too, so the two can never drift. A local or
      branch build keeps this value and is therefore self-evidently not a release.
    -->
    <Version>0.0.0-dev</Version>

    <!--
      Set by CI to the commit being built. The SDK appends it to AssemblyInformationalVersion as
      "+<sha>", which is what makes a running container traceable to a commit rather than only to a
      version number that several builds may share.
    -->
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''"></SourceRevisionId>
  </PropertyGroup>

  <!--
    Package metadata shared by every packable project. Nothing is packable unless it opts in: the
    default here is off, and the four libraries turn it on individually. That way a new project (a
    test project especially) cannot start publishing itself to nuget.org by existing.

    The package version is the Version above, so a package, the image tag and the git tag are all
    the same number by construction.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>Martin Pospisil</Authors>

    <!--
      The file rather than a PackageLicenseExpression: the terms then live inside the artifact
      instead of in a field beside it, and the package says whatever the repository's LICENSE says
      without this line having to be kept in step with it.
    -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/mpospisil/solax-controller</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mpospisil/solax-controller.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>solax;modbus;solar;inverter;battery;ev-charger;home-assistant</PackageTags>

    <!-- Debugging a package should not mean cloning the repo first. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>

