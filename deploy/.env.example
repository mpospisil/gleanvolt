# Deployment configuration and secrets for the Raspberry Pi stack.
#
# Copy this to /opt/solax/.env ON THE PI and fill it in -- it never leaves that machine and is not
# committed (the repo's .gitignore covers "*.env"). deploy.sh does not copy it.
#
#   scp deploy/.env.example marti@192.168.2.7:/opt/solax/.env
#   ssh marti@192.168.2.7 'chmod 600 /opt/solax/.env && nano /opt/solax/.env'
#
# docker compose reads this file for the ${...} substitutions in docker-compose.yml.

# --- Image -------------------------------------------------------------------------------------
# "latest" tracks main. Pin to a "sha-<short>" tag to roll back to a known-good build:
#   IMAGE_TAG=sha-abc1234 ./deploy/deploy.sh
IMAGE_TAG=latest

# --- Site --------------------------------------------------------------------------------------
TZ=Europe/Prague
INVERTER_HOST=192.168.2.6
EV_CHARGER_HOST=192.168.2.10

# --- MQTT (required) ---------------------------------------------------------------------------
# Must match the credentials in the broker's password file. Create that file with:
#   docker run --rm -v /opt/solax/mosquitto/config:/mosquitto/config eclipse-mosquitto:2 \
#     mosquitto_passwd -c -b /mosquitto/config/passwd solax '<password>'
MQTT_USERNAME=solax
MQTT_PASSWORD=

# --- Solcast (optional) ------------------------------------------------------------------------
# Without these the worker logs a warning and skips forecast refreshes; everything else still runs.
SOLCAST_API_KEY=
SOLCAST_RESOURCE_ID=

# --- Hardware-writing features -----------------------------------------------------------------
# Left at the shipped defaults deliberately: deploying must not start writing to your inverter or
# charger. Enable only after verifying the register addresses against your own device (see README).
#CHARGE_CONTROL_ENABLED=false
#BATTERY_HOLD_ENABLED=false
#BATTERY_HOLD_DRY_RUN=true

# --- Memory limits -----------------------------------------------------------------------------
# Sized for a 1 GB Pi 3 B; the three together leave roughly 170 MB for the OS and page cache.
# Requires cgroup memory accounting to be enabled in /boot/firmware/cmdline.txt -- see README.
#HA_MEM_LIMIT=600m
#CONTROLLER_MEM_LIMIT=200m
#MOSQUITTO_MEM_LIMIT=48m
