      "dayPlan": "any (required)",
      "dryRun": "boolean (required)",
      "evChargerPowerWatts": "number|string(double) (required)",
      "evChargingCurrentAmps": "integer|string(int32) (required)",
      "fastCharge": "any",
      "forecastSolarPowerWatts": "number|string(double) (required)",
