      "id": "string(uuid) (required)",
      "loanedWh": "number|string(double) (required)",
      "peakChargingPowerWatts": "number|string(double) (required)",
      "solarFraction": "number|string(double)? (required)",
      "startBatterySocPercent": "number|string(double) (required)",
