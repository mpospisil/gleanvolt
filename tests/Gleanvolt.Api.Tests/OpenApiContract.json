      "holdingControl": "boolean (required)",
      "loanPowerWatts": "number|string(double) (required)",
      "loanedTodayWh": "number|string(double) (required)",
      "mode": "$ChargeControlMode (required)",
      "sessionEnergyWh": "number|string(double) (required)",
      "solarPowerWatts": "number|string(double) (required)",
      "state": "$ChargeControlState (required)",
      "surplusWatts": "number|string(double)? (required)",
