{
  "title": "Gleanvolt",
  "version": "v1",
  "paths": {
    "/api/v1": {
      "get": {
        "operationId": "getIndex",
        "parameters": [],
        "requestBody": null,
        "responses": [
          "200 application/json $ApiIndexResponse"
        ]
      }
    },
    "/api/v1/battery-hold": {
      "put": {
        "operationId": "setBatteryHold",
        "parameters": [],
        "requestBody": "application/json $BatteryHoldRequest",
        "responses": [
          "200 application/json $ControlActionResponse",
          "409 application/problem\u002Bjson $ProblemDetails"
        ]
      }
    },
    "/api/v1/charging/start": {
      "post": {
        "operationId": "startCharging",
        "parameters": [],
        "requestBody": "application/json $StartChargingRequest",
        "responses": [
          "200 application/json $ControlActionResponse",
          "400 application/problem\u002Bjson $ProblemDetails"
        ]
      }
    },
    "/api/v1/charging/start/targeted": {
      "post": {
        "operationId": "startTargetedCharging",
        "parameters": [],
        "requestBody": "application/json $TargetedChargeRequestBody",
        "responses": [
          "200 application/json $ControlActionResponse",
          "400 application/problem\u002Bjson $ProblemDetails",
          "503 application/problem\u002Bjson $ProblemDetails"
        ]
      }
    },
    "/api/v1/charging/stop": {
      "post": {
        "operationId": "stopCharging",
        "parameters": [],
        "requestBody": null,
        "responses": [
          "200 application/json $ControlActionResponse"
        ]
      }
    },
    "/api/v1/energy/days/{date}": {
      "get": {
        "operationId": "getEnergyDay",
        "parameters": [
          "path:date (required) string(date)"
        ],
        "requestBody": null,
        "responses": [
          "200 application/json $EnergyDayResponse",
          "503 application/problem\u002Bjson $ProblemDetails"
        ]
      }
    },
    "/api/v1/energy/intervals": {
      "get": {
        "operationId": "getEnergyIntervals",
        "parameters": [
          "query:from string(date-time)",
          "query:to string(date-time)"
        ],
        "requestBody": null,
        "responses": [
          "200 application/json $EnergySeriesResponse",
          "400 application/problem\u002Bjson $ProblemDetails",
          "503 application/problem\u002Bjson $ProblemDetails"
        ]
      }
    },
    "/api/v1/forecast": {
      "get": {
        "operationId": "getForecast",
        "parameters": [
          "query:weather boolean"
        ],
        "requestBody": null,
        "responses": [
          "200 application/json $ForecastResponse"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "requestBody": null,
        "responses": [
          "200 application/json $HealthResponse"
        ]
      }
    },
    "/api/v1/plans/targeted/preview": {
      "post": {
        "operationId": "previewTargetedPlan",
        "parameters": [],
        "requestBody": "application/json $TargetedChargeRequestBody",
        "responses": [
          "200 application/json $TargetedPreviewResponse",
          "400 application/problem\u002Bjson $ProblemDetails",
          "503 application/problem\u002Bjson $ProblemDetails"
        ]
      }
    },
    "/api/v1/sessions": {
      "get": {
        "operationId": "getSessions",
        "parameters": [
          "query:from string(date-time)",
          "query:limit integer|string(int32)",
          "query:to string(date-time)"
        ],
        "requestBody": null,
        "responses": [
          "200 application/json $SessionListResponse",
          "400 application/problem\u002Bjson $ProblemDetails",
          "503 application/problem\u002Bjson $ProblemDetails"
        ]
      }
    },
    "/api/v1/sessions/{id}": {
      "get": {
        "operationId": "getSession",
        "parameters": [
          "path:id (required) string(uuid)"
        ],
        "requestBody": null,
        "responses": [
          "200 application/json $SessionDetailResponse",
          "404 application/problem\u002Bjson $ProblemDetails",
          "503 application/problem\u002Bjson $ProblemDetails"
        ]
      }
    },
    "/api/v1/site": {
      "get": {
        "operationId": "getSite",
        "parameters": [],
        "requestBody": null,
        "responses": [
          "200 application/json $SiteResponse"
        ]
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "parameters": [],
        "requestBody": null,
        "responses": [
          "200 application/json $StatusResponse",
          "503 application/problem\u002Bjson $ProblemDetails"
        ]
      }
    },
    "/api/v1/vehicle": {
      "get": {
        "operationId": "getVehicle",
        "parameters": [],
        "requestBody": null,
        "responses": [
          "200 application/json $VehicleResponse"
        ]
      }
    }
  },
  "schemas": {
    "ApiIndexResponse": {
      "authentication": "string (required)",
      "build": "string (required)",
      "documentation": "string (required)",
      "name": "string (required)",
      "operations": "array\u003C$ApiOperationResponse\u003E (required)",
      "version": "string (required)"
    },
    "ApiOperationResponse": {
      "method": "string (required)",
      "path": "string (required)",
      "summary": "string? (required)"
    },
    "BatteryHoldRequest": {
      "hold": "boolean (required)"
    },
    "BatteryHoldResponse": {
      "active": "boolean (required)",
      "enabled": "boolean (required)",
      "requested": "boolean (required)",
      "targetWatts": "number|string(double)? (required)"
    },
    "ChargeControlMode": "enum[off|solar|forecasted|fastNoBattery|targeted]",
    "ChargeControlState": "enum[disabled|idle|charging|paused]",
    "ChargingSessionEndReason": "enum[modeOff|sessionComplete|carUnplugged|serviceStopped|interrupted|]",
    "ChargingSessionEventKind": "enum[sessionStarted|modeChanged|chargingStarted|chargingPaused|targetCurrentChanged|batteryHoldArmed|batteryHoldReleased|planUnusable|planUsable|sessionEnded]",
    "ControlActionResponse": {
      "fast": "any",
      "forecastMovedSinceQuote": "boolean?",
      "message": "string? (required)",
      "status": "any (required)",
      "succeeded": "boolean (required)",
      "target": "any (required)"
    },
    "DayOutlook": "enum[unknown|surplus|tight|shortfall|noChargeToday]",
