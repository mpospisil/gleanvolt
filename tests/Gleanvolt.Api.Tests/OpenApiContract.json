      "notAfter": "string(date-time)?",
      "notBefore": "string(date-time)?",
      "planId": "string?"
    },
    "EnergyDayResponse": {
      "batteryChargeKwh": "number|string(double) (required)",
      "batteryDischargeKwh": "number|string(double) (required)",
      "coverage": "number|string(double) (required)",
      "date": "string(date) (required)",
      "evKwh": "number|string(double) (required)",
      "forecastSolarKwh": "number|string(double)? (required)",
      "from": "string(date-time) (required)",
      "gridExportKwh": "number|string(double) (required)",
      "gridImportKwh": "number|string(double) (required)",
      "houseLoadKwh": "number|string(double) (required)",
      "intervalCount": "integer|string(int32) (required)",
      "otherLoadsKwh": "number|string(double) (required)",
      "socEndPercent": "number|string(double)? (required)",
      "socMaxPercent": "number|string(double)? (required)",
      "socMinPercent": "number|string(double)? (required)",
      "socStartPercent": "number|string(double)? (required)",
      "solarKwh": "number|string(double) (required)",
      "timeZoneId": "string (required)",
      "to": "string(date-time) (required)"
    },
    "EnergyIntervalResponse": {
      "batteryChargeKwh": "number|string(double) (required)",
      "batteryDischargeKwh": "number|string(double) (required)",
      "coverage": "number|string(double) (required)",
      "evKwh": "number|string(double) (required)",
      "forecastSolarKwh": "number|string(double)? (required)",
      "gridExportKwh": "number|string(double) (required)",
      "gridImportKwh": "number|string(double) (required)",
      "houseLoadKwh": "number|string(double) (required)",
      "localDate": "string(date) (required)",
      "otherLoadsKwh": "number|string(double) (required)",
      "periodEnd": "string(date-time) (required)",
      "periodStart": "string(date-time) (required)",
      "sampleCount": "integer|string(int32) (required)",
      "socEndPercent": "number|string(double) (required)",
      "socMaxPercent": "number|string(double) (required)",
      "socMeanPercent": "number|string(double) (required)",
      "socMinPercent": "number|string(double) (required)",
      "socStartPercent": "number|string(double) (required)",
