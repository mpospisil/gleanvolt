<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The driver test kit (issue #319): the replay Modbus client and the conformance tests every inverter
    driver is held to, built-in or not. A library rather than a test project: each driver's test project
    references it and inherits the tests; under tests/ because nothing ships it yet; publishing it with the
    contract is for when two or three drivers have proved both (#316, out of scope).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Gleanvolt.Devices.Testing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.assert" Version="2.9.3" />
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gleanvolt.Devices.Abstractions\Gleanvolt.Devices.Abstractions.csproj" />
  </ItemGroup>

</Project>
