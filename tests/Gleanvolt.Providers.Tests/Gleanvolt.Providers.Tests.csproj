<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gleanvolt.Providers.Server\Gleanvolt.Providers.Server.csproj" />
    <ProjectReference Include="..\..\src\Gleanvolt.Providers.Client\Gleanvolt.Providers.Client.csproj" />
    <ProjectReference Include="..\..\src\Gleanvolt.Providers.Testing\Gleanvolt.Providers.Testing.csproj" />
    <!-- Only to encode the DNS answers Gleanvolt sends, for the SDK's own mDNS parser to read. -->
    <ProjectReference Include="..\..\src\Gleanvolt.Infrastructure\Gleanvolt.Infrastructure.csproj" />
  </ItemGroup>

  <!-- The strongly-typed class for the test-only resx, as the plugins and Gleanvolt.Web generate theirs. -->
  <ItemGroup>
    <NeutralResx Include="Resources\*.resx" Exclude="Resources\*.*.resx" />
    <EmbeddedResource Update="@(NeutralResx)">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>$(RootNamespace).Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>%(Filename)</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)%(Filename).Resources.g.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
