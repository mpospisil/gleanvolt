<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>Gleanvolt.Providers.Client</PackageId>
    <Description>Write an external data provider for Gleanvolt (#386): connects to Gleanvolt over SignalR, says hello after every reconnect, backs off after a refusal, and answers the host's requests. A provider is an ordinary worker service. MIT, so a provider can be written under any licence.</Description>
    <PackageTags>gleanvolt;signalr;provider;tariff;solar-forecast;vehicle</PackageTags>

    <!-- MIT, like the contracts: see Gleanvolt.Providers.Contracts.csproj. -->
    <GleanvoltMitPackage>true</GleanvoltMitPackage>
    <PackageLicenseFile></PackageLicenseFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    For a provider's own page (#410): UseGleanvoltProviderPage is ASP.NET Core middleware. A provider
    without a page runs on the ASP.NET Core runtime too, which is the cost of one package; see
    docs/DECISIONS.md.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <!-- The secret store's Windows half (#416): DPAPI is a package even on Windows. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gleanvolt.Providers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gleanvolt.Providers.Contracts\Gleanvolt.Providers.Contracts.csproj" />
  </ItemGroup>

</Project>
