<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>Gleanvolt.Providers.Contracts</PackageId>
    <Description>The wire contract between Gleanvolt and an external data provider (#386): the handshake, the per-kind hub and client interfaces and their data. No dependencies. MIT, so a provider can be written under any licence.</Description>
    <PackageTags>gleanvolt;signalr;provider;tariff</PackageTags>

    <!--
      MIT, unlike the rest of the repository (see docs/DECISIONS.md): a provider author references only
      this package and Gleanvolt.Providers.Client, and must be free to choose their own licence. The
      licence and readme are this directory's own, not the repository's; Directory.Build.targets leaves
      the shared ones out when this is set.
    -->
    <GleanvoltMitPackage>true</GleanvoltMitPackage>
    <PackageLicenseFile></PackageLicenseFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
