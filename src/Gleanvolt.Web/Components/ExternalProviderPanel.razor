@implements IDisposable
@inject IExternalProviders Providers
@inject NavigationManager Navigation
@inject TimeProvider Time

@*
    One kind of external data provider (#386): where a provider connects and its session, live. Any
    kind's Settings section hosts it; the kind decides elsewhere what turns it on (for the tariff,
    choosing External and saving).

    The token is one for every kind (#406) and lives in ExternalProvidersForm; this panel only points
    there, as a warning while there is none.
*@

@if (Providers.Find(Kind) is { } status)
{
    <div class="external-provider" id="external-@status.Kind">
        <p class="muted">@SettingsText.ExternalProviderIntro</p>

        <dl class="external-provider-address">
            <dt>@SettingsText.ExternalAddress</dt>
            <dd><code id="external-@(status.Kind)-address">@BaseAddress</code></dd>
            <dt>@SettingsText.ExternalHub</dt>
            <dd><code id="external-@(status.Kind)-hub">@status.HubPath</code></dd>
        </dl>

        <h3>@SettingsText.ExternalToken</h3>

        @* One token for every kind (#406): made and shown in the External providers section. *@
        <p class="@(status.HasToken ? "muted" : "warning")" id="external-@(status.Kind)-token-state">
            @Localized.Rich(status.HasToken ? SettingsText.ExternalTokenShared : SettingsText.ExternalTokenSharedMissing,
                @<a href="/settings#external-providers">@SettingsText.ExternalProviders</a>)
        </p>

        <h3>@SettingsText.ExternalStatus</h3>

        <p id="external-@(status.Kind)-state" class="@(status.State == ExternalProviderState.Connected ? "muted" : "warning")">
            @State(status)
        </p>

        <p class="muted" id="external-@(status.Kind)-data">
            @(status.LastDataAt is { } at ? Localized.Format(SettingsText.ExternalLastData, When(at)) : SettingsText.ExternalNoDataYet)
        </p>

        @if (status.Unanswered)
        {
            <p class="warning" id="external-@(status.Kind)-unanswered">@SettingsText.ExternalUnanswered</p>
        }

        @if (status.Healthy == false)
        {
            <p class="@(status.NeedsOwner ? "error" : "warning")" id="external-@(status.Kind)-unhealthy">
                @Localized.Format(status.NeedsOwner ? SettingsText.ExternalNeedsOwner : SettingsText.ExternalUnhealthy, status.StatusMessage ?? string.Empty)
            </p>
        }

        @if (status.LastProblem is { Count: > 0 } problems)
        {
            <p class="error">@SettingsText.ExternalLastProblem</p>
            <ul class="error" id="external-@(status.Kind)-problems">
                @for (var i = 0; i < problems.Count; i++)
                {
                    <li>@Localized.Say(status.LastProblemPhrases is { } phrases && i < phrases.Count ? phrases[i] : null, problems[i], Time.LocalTimeZone)</li>
                }
            </ul>
        }
    </div>
}

@code {
    /// <summary>The kind's id, e.g. <c>tariff</c>.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = string.Empty;

    /// <summary>True when the page has no login. Kept for the hosts that pass it; nothing here changes anything.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    // What a provider is configured with: the SDK adds the hub path itself.
    private string BaseAddress => Navigation.BaseUri.TrimEnd('/');

    protected override void OnInitialized() => Providers.Changed += Refresh;

    public void Dispose() => Providers.Changed -= Refresh;

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private string State(ExternalProviderStatus status) => ExternalProviderStateText.Describe(status, Time.LocalTimeZone);

    private string When(DateTimeOffset? at) => ExternalProviderStateText.When(at, Time.LocalTimeZone);
}
