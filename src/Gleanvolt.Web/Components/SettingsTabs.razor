@*
    The Settings page's tabs (#255's navigation): the installation -- the PV system, the charger,
    the integrations --, the external providers (the plugins' token and sessions, a tab of their own
    since it crowded the top of both others), and the controller's own health. Pages behind one header
    link rather than one component, because they render differently: Health follows the poll live, the
    installation is a form. Links, like the Charging plan tabs, so each half is a real URL. The old /pv-system and
    /health addresses still answer, for bookmarks.
*@
<nav class="tabs settings-tabs" aria-label="@SharedText.SettingsTabsLabel">
    <a class="tab @(Current == SettingsTab.Installation ? "active" : null)" href="/settings"
       aria-current="@(Current == SettingsTab.Installation ? "page" : null)">@SharedText.SettingsInstallation</a>
    <a class="tab @(Current == SettingsTab.ExternalProviders ? "active" : null)" href="/settings/providers"
       aria-current="@(Current == SettingsTab.ExternalProviders ? "page" : null)">@SharedText.SettingsExternalProviders</a>
    <a class="tab @(Current == SettingsTab.Health ? "active" : null)" href="/settings/health"
       aria-current="@(Current == SettingsTab.Health ? "page" : null)">@SharedText.SettingsHealth</a>
</nav>

@code {
    /// <summary>Which tab is open.</summary>
    [Parameter, EditorRequired] public SettingsTab Current { get; set; }
}
