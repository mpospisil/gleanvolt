@*
    The Settings page's tabs, one per kind of thing and in the order an installation is set up (2026-11-27):
    the installation itself, the plugins that connect to it, the forecast and the prices that make the plans
    better, the links to other systems, and the controller's own state with its restart. Links rather than
    one component, so each tab is a real URL the manual can point at. The old /pv-system, /settings/health
    and /health addresses still answer, for bookmarks.
*@
<nav class="tabs settings-tabs" aria-label="@SharedText.SettingsTabsLabel">
    @foreach (var (tab, href, label) in Tabs)
    {
        <a class="tab @(Current == tab ? "active" : null)" href="@href"
           aria-current="@(Current == tab ? "page" : null)">@label</a>
    }
</nav>

@code {
    /// <summary>Which tab is open.</summary>
    [Parameter, EditorRequired] public SettingsTab Current { get; set; }

    private static (SettingsTab Tab, string Href, string Label)[] Tabs =>
    [
        (SettingsTab.Installation, "/settings", SharedText.SettingsInstallation),
        (SettingsTab.ExternalProviders, "/settings/providers", SharedText.SettingsExternalProviders),
        (SettingsTab.ForecastPrices, "/settings/forecast-prices", SharedText.SettingsForecastPrices),
        (SettingsTab.Integrations, "/settings/integrations", SharedText.SettingsIntegrations),
        (SettingsTab.System, "/settings/system", SharedText.SettingsSystem),
    ];
}
