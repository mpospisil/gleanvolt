@page "/sessions"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IChargingSessionStore Store
@inject TimeProvider Time

@*
    Phase 4 (#49). SessionStore already records every controlled session to SQLite -- this is the
    first way to look at any of it. Read-only: IChargingSessionStore's query members (GetSessionsAsync,
    ExportAsync) already existed for this, so nothing here reaches past the interface into SQLite.
*@

<SiteTitle Page="@HistoryText.SessionsPageTitle" />

<h1>@HistoryText.SessionsTitle</h1>

<div class="control range-control">
    <label for="range">@HistoryText.Show</label>
    <select id="range" @bind="_rangeDays" @bind:after="LoadAsync">
        <option value="7">@HistoryText.Last7Days</option>
        <option value="30">@HistoryText.Last30Days</option>
        <option value="90">@HistoryText.Last90Days</option>
        <option value="365">@HistoryText.LastYear</option>
    </select>
</div>

@if (_error)
{
    <p class="muted">@HistoryText.HistoryUnavailable</p>
}
else if (_sessions is null)
{
    <p class="muted">@HistoryText.Loading</p>
}
else if (_sessions.Count == 0)
{
    <p class="muted">@HistoryText.NoSessions</p>
}
else
{
    <table class="sessions">
        <thead>
            <tr>
                <th>@HistoryText.Started</th>
                <th>@HistoryText.Duration</th>
                <th>@HistoryText.Strategy</th>
                <th>@HistoryText.Delivered</th>
                <th>@HistoryText.SolarShare</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var session in _sessions)
            {
                <tr>
                    <td>
                        <a href="@($"/sessions/{session.Id}")">@Local(session.StartedAt)</a>
                        @if (session.IsOpen)
                        {
                            <span class="muted">&nbsp;@HistoryText.InProgressParenthesised</span>
                        }
                    </td>
                    <td>@Units.Duration(session.Duration(Time.GetUtcNow()))</td>
                    <td>@session.FormatStrategy()</td>
                    <td>@Units.Kwh(session.EnergyDeliveredWh, 2)</td>
                    <td>@Units.Fraction(session.SolarFraction)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private int _rangeDays = 30;
    private IReadOnlyList<ChargingSession>? _sessions;
    private bool _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = false;
        try
        {
            var to = Time.GetUtcNow();
            var from = to - TimeSpan.FromDays(_rangeDays);
            _sessions = await Store.GetSessionsAsync(from, to, CancellationToken.None);
        }
        catch (Exception)
        {
            // The store isn't ready -- SessionStore:Enabled is false, or the file couldn't be opened
            // -- and that must read as "not available", not crash the page. Recording's own failures
            // are already silent by design (SessionRecordingWorker); browsing degrades the same way.
            _sessions = null;
            _error = true;
        }
    }

    private string Local(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, Time.LocalTimeZone).ToString(SharedText.DateTimePattern, System.Globalization.CultureInfo.CurrentCulture);
}
