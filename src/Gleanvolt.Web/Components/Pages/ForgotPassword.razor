@page "/forgot-password"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject WebPasswordState Password
@inject WebPasswordService Passwords

@*
    A forgotten password, reset without signing in (#301). Static server-side rendering, like the login
    and setup pages: every form is a real POST handled inside its request, and nothing here needs a
    circuit.

    Two ways, both proving something a stranger on the LAN does not have: the recovery key shown when
    the password was set, or access to the host, where a one-time code is written. The code is never
    sent to this page. All of it is rate-limited by the service, and every reset signs every browser out.
*@

<PageTitle>@SharedText.ForgotTitle</PageTitle>

<div class="login-card">
    @if (_recoveryKey is not null)
    {
        <h1>@SharedText.PasswordReset</h1>
        <RecoveryKeyPanel Key="@_recoveryKey" Intro="@SharedText.ResetDoneIntro"
                          ContinueHref="/login" ContinueText="@SharedText.RecoveryKeySaved" />
    }
    else if (!Password.IsSet)
    {
        <h1>@SharedText.ResetPassword</h1>
        <p>@Localized.Rich(SharedText.ResetNoPassword, @<a href="/setup">@SharedText.SetPassword</a>)</p>
    }
    else
    {
        <h1>@SharedText.ResetPassword</h1>

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }

        @if (Passwords.HasRecoveryKey)
        {
            <section>
                <h2>@SharedText.ResetWithKey</h2>
                <EditForm Model="KeyInput" method="post" FormName="reset-key" OnValidSubmit="ResetWithKey">
                    <DataAnnotationsValidator />
                    <label>
                        @SharedText.RecoveryKeyLabel
                        <InputText @bind-Value="KeyInput!.Secret" autocomplete="off" spellcheck="false" />
                    </label>
                    <label>
                        @SharedText.NewPassword
                        <RevealInput>
                            <InputText type="password" @bind-Value="KeyInput!.Password" autocomplete="new-password" />
                        </RevealInput>
                    </label>
                    <label>
                        @SharedText.RepeatPassword
                        <RevealInput>
                            <InputText type="password" @bind-Value="KeyInput!.Confirm" autocomplete="new-password" />
                        </RevealInput>
                    </label>
                    <ValidationSummary />
                    <button type="submit">@SharedText.ResetButton</button>
                </EditForm>
            </section>
        }

        <section>
            <h2>@SharedText.ResetWithCode</h2>
            <p>@Localized.Rich(SharedText.ResetCodeIntro, @<code>@Passwords.CodeFilePath</code>)</p>

            <EditForm Model="RequestInput" method="post" FormName="reset-request" OnSubmit="RequestCode">
                <button type="submit" class="secondary">@SharedText.RequestCode</button>
            </EditForm>

            @if (_codeMessage is not null)
            {
                <p class="muted" role="status">@_codeMessage</p>
            }

            <EditForm Model="CodeInput" method="post" FormName="reset-code" OnValidSubmit="ResetWithCode">
                <DataAnnotationsValidator />
                <label>
                    @SharedText.CodeLabel
                    <InputText @bind-Value="CodeInput!.Secret" autocomplete="one-time-code" spellcheck="false" />
                </label>
                <label>
                    @SharedText.NewPassword
                    <RevealInput>
                        <InputText type="password" @bind-Value="CodeInput!.Password" autocomplete="new-password" />
                    </RevealInput>
                </label>
                <label>
                    @SharedText.RepeatPassword
                    <RevealInput>
                        <InputText type="password" @bind-Value="CodeInput!.Confirm" autocomplete="new-password" />
                    </RevealInput>
                </label>
                <ValidationSummary />
                <button type="submit">@SharedText.ResetButton</button>
            </EditForm>
        </section>

        <p><a href="/login">@SharedText.BackToSignIn</a></p>
    }
</div>

@code {
    /// <summary>Where the page lives, for the link on the sign-in page and the setup gate.</summary>
    public const string Path = "/forgot-password";

    [SupplyParameterFromForm(FormName = "reset-key")]
    private ResetInput? KeyInput { get; set; }

    [SupplyParameterFromForm(FormName = "reset-code")]
    private ResetInput? CodeInput { get; set; }

    [SupplyParameterFromForm(FormName = "reset-request")]
    private RequestCodeInput? RequestInput { get; set; }

    private string? _error;
    private string? _codeMessage;
    private string? _recoveryKey;

    protected override void OnInitialized()
    {
        KeyInput ??= new();
        CodeInput ??= new();
        RequestInput ??= new();
    }

    private void ResetWithKey() =>
        Finish(KeyInput!, () => Passwords.ResetWithRecoveryKey(KeyInput!.Secret, KeyInput.Password));

    private void ResetWithCode() =>
        Finish(CodeInput!, () => Passwords.ResetWithCode(CodeInput!.Secret, CodeInput.Password));

    private void RequestCode() =>
        _codeMessage = Passwords.RequestCode() switch
        {
            CodeRequestResult.Issued => SharedText.CodeIssued,
            CodeRequestResult.TooSoon => SharedText.CodeTooSoon,
            _ => null,
        };

    private void Finish(ResetInput input, Func<PasswordChangeResult> reset)
    {
        if (input.Password != input.Confirm)
        {
            _error = SharedText.PasswordsDiffer;
            return;
        }

        var result = reset();

        if (!result.Succeeded)
        {
            _error = Describe(result.Error);
            return;
        }

        _recoveryKey = result.RecoveryKey;
    }

    /// <summary>The sentence for a refused change, shared with the change on Settings.</summary>
    public static string Describe(PasswordError? error) => error switch
    {
        PasswordError.TooShort => SharedText.PasswordTooShort,
        PasswordError.WrongPassword => SharedText.WrongPassword,
        PasswordError.WrongKey => SharedText.WrongRecoveryKey,
        PasswordError.WrongCode => SharedText.WrongCode,
        PasswordError.TooManyAttempts => SharedText.TooManyAttempts,
        _ => SharedText.PasswordNotSaved,
    };

    private sealed class ResetInput
    {
        [Required(ErrorMessageResourceType = typeof(SharedText), ErrorMessageResourceName = nameof(SharedText.EnterKeyOrCode))]
        public string Secret { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(SharedText), ErrorMessageResourceName = nameof(SharedText.EnterPassword))]
        [MinLength(WebPasswordService.MinimumLength, ErrorMessageResourceType = typeof(SharedText), ErrorMessageResourceName = nameof(SharedText.PasswordTooShort))]
        public string Password { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(SharedText), ErrorMessageResourceName = nameof(SharedText.RepeatThePassword))]
        public string Confirm { get; set; } = "";
    }

    // A form needs a model even when all it posts is the button.
    private sealed class RequestCodeInput;
}
