@page "/setup"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using Gleanvolt.Core.Interfaces
@using Gleanvolt.Web.Auth
@using Microsoft.AspNetCore.Components.Forms
@inject WebPasswordState Password
@inject IWebPasswordStore Store
@inject NavigationManager Navigation

@*
    Static server-side rendering, like the login page and for the same reason: the form is a real HTTP
    POST handled inside the request, which is what a page that has to work before any circuit exists
    needs. See App.razor.
*@

<PageTitle>@SharedText.SetupTitle</PageTitle>

<div class="login-card">
    @if (Password.IsSet)
    {
        @* Reachable by typing the URL after setup is done. Says so rather than offering to
           re-set the password: changing it is not this page's job, and an unauthenticated page
           that could change it would be the hole this one closes. *@
        <h1>@SharedText.AlreadySetUp</h1>
        <p>@Localized.Rich(SharedText.AlreadySetUpText, @<a href="/login">@SharedText.SignIn</a>)</p>
    }
    else
    {
        <h1>@SharedText.SetPassword</h1>

        <p>
            @SharedText.SetupIntro
        </p>

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }

        <EditForm Model="Input" method="post" FormName="setup" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <label>
                @SharedText.PasswordLabel
                <InputText type="password" @bind-Value="Input!.Password" autofocus />
            </label>

            <label>
                @SharedText.RepeatPassword
                <InputText type="password" @bind-Value="Input!.Confirm" />
            </label>

            <ValidationSummary />

            <button type="submit">@SharedText.SetThePassword</button>
        </EditForm>

        <p class="muted">
            @SharedText.SetupNote
        </p>
    }
</div>

@code {
    [SupplyParameterFromForm]
    private SetupInput? Input { get; set; }

    private string? _error;

    protected override void OnInitialized() => Input ??= new();

    private void SaveAsync()
    {
        var password = Input?.Password ?? "";

        if (password != (Input?.Confirm ?? ""))
        {
            _error = SharedText.PasswordsDiffer;
            return;
        }

        var hash = WebPasswordHasher.Hash(password);

        // Persisted before it is believed. A hash held only in memory would be a password that
        // quietly stopped existing on the next restart, leaving the UI open again with nobody told.
        if (!Store.Save(hash))
        {
            _error = SharedText.PasswordNotSaved;
            return;
        }

        Password.Set(hash);

        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private sealed class SetupInput
    {
        // Eight is not a policy so much as a floor. This guards one appliance on a home network, and
        // a length rule long enough to be annoying is a length rule people write on the router.
        [Required(ErrorMessageResourceType = typeof(SharedText), ErrorMessageResourceName = nameof(SharedText.EnterPassword))]
        [MinLength(8, ErrorMessageResourceType = typeof(SharedText), ErrorMessageResourceName = nameof(SharedText.PasswordTooShort))]
        public string Password { get; set; } = "";

        [Required(ErrorMessageResourceType = typeof(SharedText), ErrorMessageResourceName = nameof(SharedText.RepeatThePassword))]
        public string Confirm { get; set; } = "";
    }
}
