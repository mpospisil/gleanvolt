@page "/forecast"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ISolarForecastService Forecasts
@inject IJSRuntime JS
@inject TimeProvider Time

@*
    What the roof is going to do, today and tomorrow (#219). The Energy page's shape on purpose: the
    two days drawn, then the same two days printed, one row per forecast period, both built from one
    list so the picture cannot disagree with the numbers.

    It reads ISolarForecastService in-process, as the dashboard does -- the cached forecast the poll
    loop is already deciding on -- and *never triggers a fetch*. Solcast's free tier is about ten calls
    a day and the refresh worker spends half of them; a page that fetched on every visit would be the
    one thing that could exhaust that.

    Three surfaces show forecast and each owns a different question. The dashboard's table owns the
    glance: two rows, four numbers, in a place somebody is already looking. This page owns the detail,
    and is the only place tomorrow has a *shape*. The Forecasted tab owns the car's share of today --
    surplus after the house and the battery. A day total and a day's shape are different objects.
*@

<SiteTitle Page="@HistoryText.ForecastPageTitle" />

<h1>@HistoryText.ForecastTitle</h1>

<NotConfiguredCard Setting="OptionalSetting.Solcast" />

@if (!_anything)
{
    @* Not an error: a controller with no Solcast key is a supported installation, and so is one that
       started a minute ago. Both look identical from here, so the sentence names both. *@
    <p class="muted">
        @Localized.Rich(HistoryText.NoForecastHeld, @<a href="/settings#solcast-editor">@HistoryText.NoForecastHeld_0</a>)
    </p>
}
else
{
    <section class="chart-section">
        <h2>@HistoryText.TheTwoDays</h2>
        <div id="forecast-chart" class="chart forecast"></div>
        <p class="muted chart-note">
            @Localized.Rich(HistoryText.ForecastChartNote, @<text>@(Time.LocalTimeZone.Id)</text>, @<strong>@HistoryText.ForecastChartNote_1</strong>, @<strong>@HistoryText.ForecastChartNote_2</strong>)
            @if (!_fullBand)
            {
                <text>
                    @Localized.Rich(HistoryText.NoRangeNote, @<strong>@HistoryText.NoRangeNote_0</strong>)
                </text>
            }
        </p>
    </section>

    @if (_morningMissing is { } from)
    {
        <p class="muted table-note">
            @Localized.Rich(HistoryText.MorningMissing, @<strong>@Localized.Format(HistoryText.TodayStartsAt, Local(from))</strong>)
        </p>
    }

    <table class="sessions energy forecast-periods">
        <thead>
            <tr>
                <th>@HistoryText.Period</th>
                <th class="num">@HistoryText.ColExpected</th>
                <th class="num">@HistoryText.ColLow</th>
                <th class="num">@HistoryText.ColHigh</th>
                <th class="num">@HistoryText.ColEnergy</th>
            </tr>
        </thead>
        @foreach (var day in _days)
        {
            <tbody>
                @*
                    The day's figures above its periods rather than below them: they are the dashboard's
                    own row, read from the same GetDaySummary the dashboard reads, and written out in
                    words so that energy in kWh and peak in kW can sit in a table whose columns are
                    watts without either having to pretend to be the other.
                *@
                <tr class="day-heading">
                    <th colspan="5">
                        @day.Label
                        <span class="muted forecast-date">@day.Date.ToString(SharedText.DayMonthPattern, System.Globalization.CultureInfo.CurrentCulture)</span>
                        @if (day.Summary is { } summary)
                        {
                            <span class="day-totals">
                                @Localized.Format(HistoryText.DayTotals, Units.Kwh(summary.ExpectedWh, 2), Units.Kwh(summary.LowWh, 2, unit: false), Units.Kwh(summary.HighWh, 2, unit: false), Units.Kw(summary.PeakWatts, 2))
                            </span>
                        }
                    </th>
                </tr>
                @if (day.Periods.Count == 0)
                {
                    <tr class="empty-day">
                        <td colspan="5" class="muted">@HistoryText.NothingHeld</td>
                    </tr>
                }
                @foreach (var period in day.Periods)
                {
                    <tr>
                        <td>@Local(period.PeriodStart)–@Local(period.PeriodEnd)</td>
                        <td class="num">@Units.Watts(period.EstimatedPowerWatts, unit: false)</td>
                        @* An em dash, not the median: the provider sent no p10 for this half hour,
                           which is a different fact from one it is as sure of as its middle guess. *@
                        <td class="num">@Units.Watts(period.EstimatedPowerWattsP10, unit: false)</td>
                        <td class="num">@Units.Watts(period.EstimatedPowerWattsP90, unit: false)</td>
                        <td class="num">@Units.Kwh(period.EnergyWattHours, 2, unit: false)</td>
                    </tr>
                }
            </tbody>
        }
    </table>

    <p class="muted table-note">
        @Localized.Rich(HistoryText.ForecastTableNote, @<text>@(Time.LocalTimeZone.Id)</text>, @<em>@HistoryText.ForecastTableNote_1</em>, @<strong>@HistoryText.ForecastTableNote_2</strong>, @<strong>@HistoryText.ForecastTableNote_3</strong>)
        @if (_retrievedAt is { } retrieved)
        {
            <text> @Localized.Rich(HistoryText.LastFetched, @<strong>@Local(retrieved)</strong>, @<text>@(TimeZoneInfo.ConvertTime(retrieved, Time.LocalTimeZone).ToString(SharedText.DayMonthPattern, System.Globalization.CultureInfo.CurrentCulture))</text>)</text>
        }
        @Localized.Rich(HistoryText.ForecastHorizonNote, @<a href="/#solar-forecast">@HistoryText.ForecastHorizonNote_0</a>)
    </p>
}

@code {
    /// <summary>One day of the page: its name, its date, the periods held for it and the day's figures.</summary>
    private sealed record Day(
        string Label,
        DateOnly Date,
        IReadOnlyList<SolarForecastPeriod> Periods,
        SolarDayForecastSummary? Summary);

    private IReadOnlyList<Day> _days = [];
    private ForecastChartSeries? _chart;
    private DateTimeOffset? _retrievedAt;

    // Where today's held forecast actually begins, when that is after local midnight. Null when the
    // whole day is covered -- which is the ordinary case for a controller that has been up overnight.
    private DateTimeOffset? _morningMissing;

    private bool _anything;
    private bool _fullBand = true;

    // See Energy.razor for why these are two flags and not one: _chartRendered guards the draw,
    // _chartCreated is the only thing that can answer whether there is anything to tear down.
    private bool _chartRendered;
    private bool _chartCreated;

    protected override void OnInitialized()
    {
        var zone = Time.LocalTimeZone;
        var now = Time.GetUtcNow();
        var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(now, zone).DateTime);
        var tomorrow = today.AddDays(1);

        var todayForecast = Forecasts.GetDayForecast(today);
        var tomorrowForecast = Forecasts.GetDayForecast(tomorrow);

        _days =
        [
            new Day(HistoryText.Today, today, todayForecast?.Periods ?? [], Forecasts.GetDaySummary(today)),
            new Day(HistoryText.Tomorrow, tomorrow, tomorrowForecast?.Periods ?? [], Forecasts.GetDaySummary(tomorrow)),
        ];

        _retrievedAt = todayForecast?.RetrievedAt ?? tomorrowForecast?.RetrievedAt;

        var periods = _days.SelectMany(d => d.Periods).ToList();
        _anything = periods.Count > 0;
        if (!_anything)
        {
            return;
        }

        _fullBand = periods.All(p => p is { EstimatedPowerWattsP10: not null, EstimatedPowerWattsP90: not null });

        var (windowStart, midnight, windowEnd) = Window(today, zone);

        // The earliest period *of today's block*, which is the one that can be missing a morning:
        // tomorrow is always forecast whole, being entirely ahead of every refresh that has landed.
        var earliest = _days[0].Periods.Count == 0 ? null : (DateTimeOffset?)_days[0].Periods.Min(p => p.PeriodStart);
        _morningMissing = earliest > windowStart ? earliest : null;

        _chart = ForecastChartSeries.From(periods, windowStart, midnight, windowEnd, now, zone);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartRendered || _chart is null)
        {
            return;
        }

        _chartRendered = true;

        // Set before the call, not after: if the interop is cut off mid-flight the chart may already
        // exist on the other side, and disposing one that isn't there is a no-op anyway.
        _chartCreated = true;

        await JS.InvokeVoidAsync("solaxCharts.renderForecastChart", "forecast-chart", _chart, ChartText.Current());
    }

    public async ValueTask DisposeAsync()
    {
        if (!_chartCreated)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("solaxCharts.dispose", "forecast-chart");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone (e.g. the browser tab closed) -- nothing left to clean up.
        }
    }

    /// <summary>
    /// Today's midnight, tomorrow's, and the one after — as instants. Built from the zone's offset at
    /// each boundary rather than from fixed 24-hour steps, so a clocks-change day is the 23 or 25
    /// hours it really is and the divider lands on the midnight it means.
    /// </summary>
    private static (DateTimeOffset Start, DateTimeOffset Midnight, DateTimeOffset End) Window(DateOnly today, TimeZoneInfo zone)
    {
        DateTimeOffset At(int days)
        {
            var local = today.AddDays(days).ToDateTime(TimeOnly.MinValue);
            return new DateTimeOffset(local, zone.GetUtcOffset(local));
        }

        return (At(0), At(1), At(2));
    }

    private string Local(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, Time.LocalTimeZone).ToString("HH:mm");
}
