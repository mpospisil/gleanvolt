@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ChargeControlStatusHolder StatusHolder
@inject IVehicleTelemetry Vehicle
@inject VehicleDisplayOptions VehicleDisplay
@inject IVehicleStateRefresh VehicleRefresh
@inject EvInfo Car
@inject ConfiguredVehicleFeed VehicleFeed
@inject ISolarForecastService Forecasts
@inject ITariffSchedule Tariff
@inject TimeProvider Time
@inject IJSRuntime JS
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@*
    The dashboard reports; it no longer decides (#98). Every control that used to sit under these
    numbers lives on the Charging plan page, next to the mode it belongs to. Since #255 it is laid out
    as the overview (see the comment under the title); the car and the forecast table below it are the
    two sections that kept their shape:

      Vehicle         -- the car: the charger's own view of whether one is connected, plus whatever
                         the car's one feed last said about itself (#73, #140, #212). Read-only,
                         and nothing in the control logic consumes the cloud half yet.
      Solar forecast  -- today and tomorrow as a table, with what each column means in the tip beside
                         its heading: these figures are read against each other -- tomorrow against
                         today, the cautious band against the median -- not one at a time.

    Follows StatusHolder.Updated exactly like the health page: seeded from Current before
    subscribing, so a browser that arrives between two polls sees the last one rather than nothing,
    then pushed a new value down the circuit on every completed poll.
*@

<SiteTitle Page="@DashboardText.PageTitle" />

@*
    The overview (#255, direction 1a with 1b's prose status). One question per block, in the order
    they are asked:

      the headline    -- what the controller is doing and why, in words (OverviewNarrative), and
                         under it the tariff now (TariffNarrative), when one is set up (#265).
      the figures     -- Solar, House, Battery, Car, Grid: each one's power now and its energy so far
                         today. "So far today" comes from the energy monitor's store when it is on, and
                         is simply left off when it is not.
      the mode        -- only while no mode is driving: a strip of links into the Charging plan tabs.
                         Still read-only: this page reports and the plan page decides (#98), so the strip
                         is a way to the controls rather than a second copy of them. A mode that is
                         driving is named at the top of This session instead, with its way back to the
                         plan page.
      the side cards  -- Today's plan, when a mode has published one, and This session.

    Then the car and the day's forecast. Every figure's meaning is one tap away, in the (i) beside its
    label (InfoTip): the strip is meant to be read at a glance, and README's entity table is what those
    sentences are drawn from.
*@

<header class="overview-head">
    <h1>@DashboardText.Title</h1>
    @if (_status is not null)
    {
        <span class="tag accent">@DashboardText.Live</span>
        <span class="muted">
            @Localized.Format(DashboardText.Updated, TimeZoneInfo.ConvertTime(_status.Timestamp, Time.LocalTimeZone).ToString("HH:mm:ss"))
        </span>
    }
</header>

@if (_status is null)
{
    <p class="muted">@DashboardText.NoPollYet</p>
}
else
{
    var house = HouseWatts(_status);
    var tab = ChargeModeTabs.For(_status.Mode);

    <div class="overview">
        <div class="overview-main">
            <p class="headline" id="overview-headline">
                @string.Join(" ", OverviewNarrative.Describe(_status, Time.LocalTimeZone))
            </p>

            @* Read on every render, which is every poll: the schedule is cached until midnight or a save,
               so a tariff saved on Settings shows here by the next poll. *@
            @if (TariffNarrative.Describe(Tariff.Timeline, Tariff.Unavailable, Tariff.Currency, Time.GetUtcNow(), Time.LocalTimeZone) is { } tariff)
            {
                <p class="tariff-line @(Tariff.Timeline is null ? "warning" : "muted")" id="overview-tariff">@tariff</p>
            }

            <section class="figures" aria-label="@DashboardText.FiguresLabel">
                <div class="figure solar">
                    <div class="figure-label">
                        @DashboardText.Solar
                        <InfoTip Topic="@DashboardText.SolarTopic">
                            <p>@DashboardText.SolarTip1</p>
                            <p>@Localized.Rich(DashboardText.SolarTip2, @<strong>@DashboardText.SolarTip2_0</strong>)</p>
                            <p>@Localized.Rich(DashboardText.SolarTip3, @<strong>@DashboardText.SolarTip3_0</strong>)</p>
                        </InfoTip>
                    </div>
                    <div class="figure-now">@Flow(_status.SolarPowerWatts)</div>
                    <div class="figure-sub">@Localized.Format(DashboardText.ForecastNow, Flow(_status.ForecastSolarPowerWatts))</div>
                    @if (_status.SurplusWatts is { } surplus)
                    {
                        <div class="figure-sub">@Localized.Format(DashboardText.SurplusNow, Flow(surplus))</div>
                    }
                    <div class="figure-today">@Today(t => t.SolarKwh)</div>
                </div>
                <div class="figure house">
                    <div class="figure-label">
                        @DashboardText.House
                        <InfoTip Topic="@DashboardText.HouseTopic">
                            <p>@DashboardText.HouseTip1</p>
                            <p>@DashboardText.HouseTip2</p>
                        </InfoTip>
                    </div>
                    @* Below zero is not a house exporting: the grid meter cannot see one phase, so while the
                       car draws, part of its load is missing from the sum. A dash, not a wrong number. *@
                    @if (house >= 0)
                    {
                        <div class="figure-now">@Flow(house)</div>
                        <div class="figure-sub">@DashboardText.WithoutCar</div>
                    }
                    else
                    {
                        <div class="figure-now">@Units.Missing</div>
                        <div class="figure-sub">@DashboardText.NotMeasurable</div>
                    }
                    <div class="figure-today">@Today(t => t.HouseKwh)</div>
                </div>
                <div class="figure battery">
                    <div class="figure-label">
                        @DashboardText.Battery
                        <InfoTip Topic="@DashboardText.BatteryTopic">
                            <p>@DashboardText.BatteryTip1</p>
                            <p>@DashboardText.BatteryTip2</p>
                        </InfoTip>
                    </div>
                    <div class="figure-now">@Flow(_status.BatteryPowerWatts)</div>
                    <div class="figure-sub">@(_status.BatteryPowerWatts switch { > 0 => DashboardText.BatteryCharging, < 0 => DashboardText.BatterySupplying, _ => DashboardText.BatteryIdle }) · @Units.Percent(_status.BatterySocPercent)</div>
                    <div class="figure-today">@TodayInOut(t => t.BatteryInKwh, t => t.BatteryOutKwh, DashboardText.In, DashboardText.Out)</div>
                </div>
                <div class="figure ev">
                    <div class="figure-label">
                        @DashboardText.Car
                        <InfoTip Topic="@DashboardText.CarTopic" End="true">
                            <p>@DashboardText.CarTip</p>
                        </InfoTip>
                    </div>
                    <div class="figure-now">@Flow(_status.EvChargerPowerWatts)</div>
                    <div class="figure-sub">@(_status.CarConnected ? DashboardText.PluggedIn : DashboardText.NotPluggedIn)</div>
                    <div class="figure-today">@Today(t => t.EvKwh)</div>
                </div>
                <div class="figure grid-flow">
                    <div class="figure-label">
                        @DashboardText.Grid
                        <InfoTip Topic="@DashboardText.GridTopic" End="true">
                            <p>@DashboardText.GridTip</p>
                        </InfoTip>
                    </div>
                    <div class="figure-now">@Flow(_status.GridPowerWatts)</div>
                    <div class="figure-sub">@(_status.GridPowerWatts switch { > 0 => DashboardText.Importing, < 0 => DashboardText.Exporting, _ => DashboardText.Balanced })</div>
                    <div class="figure-today">@TodayInOut(t => t.ImportKwh, t => t.ExportKwh, DashboardText.In, DashboardText.Out)</div>
                </div>
            </section>

            @if (_today is { Count: > 0 })
            {
                <p class="muted figures-note">
                    @DashboardText.FiguresNote
                    <InfoTip Topic="@DashboardText.FiguresNoteTopic">
                        <p>@DashboardText.FiguresNoteTip</p>
                    </InfoTip>
                </p>
            }
            else if (_today is null)
            {
                <p class="muted figures-note">
                    @DashboardText.NoEnergyMonitor
                </p>
            }

            @if (_status.Mode == ChargeControlMode.Off)
            {
                <section class="mode" aria-labelledby="mode-heading">
                    <h2 id="mode-heading">@DashboardText.ChargeMode</h2>
                    @* Links, not radios: each goes to that mode's tab, where it is started and where its
                       settings are. Off is marked as the current one; it has no tab of its own. *@
                    <nav class="seg mode-seg" aria-label="@DashboardText.ChargeModesLabel">
                        <span class="seg-opt" aria-current="true">@SharedText.ModeOff</span>
                        @foreach (var entry in ChargeModeTabs.All)
                        {
                            <a class="seg-opt" href="@($"/charging-plan/{entry.Slug}")">@entry.Label</a>
                        }
                    </nav>
                    <p class="mode-summary">
                        @Localized.Rich(DashboardText.NoSession, @<a href="/charging-plan">@DashboardText.NoSession_0</a>)
                    </p>
                </section>
            }
        </div>

        <aside class="overview-side">
            @if (_status.Mode == ChargeControlMode.Forecasted && _status.Plan is { } plan)
            {
                <section class="card plan-card" id="todays-plan">
                    <h2>@DashboardText.TodaysPlan</h2>
                    @* The plan's sentence is the headline's second one already; the card is the picture
                       and the four figures behind it. *@
                    @if (plan.Timeline.Count > 0)
                    {
                        <div id="overview-plan-chart" class="chart"></div>
                        @if (Tariff.Timeline is { } tariffTimeline && tariffTimeline.LowWindows.Any())
                        {
                            <p class="table-note muted" id="overview-plan-tariff">@DashboardText.LowTariffBar</p>
                        }
                    }
                    <table class="sessions plan-table">
                        <tbody>
                            <tr><th scope="row">@DashboardText.Window</th><td class="num">@Window(plan.NextFeasibleWindow)</td></tr>
                            <tr><th scope="row">@DashboardText.CarEnergy</th><td class="num">@Units.Energy(plan.FeasibleEvEnergyWh)</td></tr>
                            <tr><th scope="row">@DashboardText.BatteryFloor</th><td class="num">@Units.Percent(plan.RequiredSocFloorPercent)</td></tr>
                            <tr><th scope="row">@DashboardText.Shortfall</th><td class="num">@Units.Energy(plan.ShortfallWh)</td></tr>
                        </tbody>
                    </table>
                    <p class="card-link"><a href="/charging-plan/forecasted">@DashboardText.WholePlan</a></p>
                </section>
            }
            else if (_status.Mode == ChargeControlMode.Targeted && _status.TargetedPlan is { } targeted)
            {
                <section class="card plan-card" id="todays-plan">
                    <h2>@DashboardText.ThePlan</h2>
                    @foreach (var paragraph in TargetedPlanNarrative.Describe(targeted, Time.LocalTimeZone))
                    {
                        <p>@paragraph</p>
                    }
                    <p class="card-link"><a href="/charging-plan/targeted">@DashboardText.WholePlan</a></p>
                </section>
            }

            @* No session, no card: with the mode Off and nothing drawing there is nothing to report, and
               the Charge mode strip beside it is where one is started. A car drawing under no mode at all
               still gets it -- somebody plugged in and the charger is in Fast on its own. *@
            @if (IsCharging(_status))
            {
                <section class="card session-card" id="this-session">
                    <h2>@DashboardText.ThisSession</h2>

                    @* The mode first, since it is what the rest of the card answers to: the one driving, what
                       it does, its discharge hold, and the way back to where it is changed or stopped. *@
                    <div class="session-mode">
                        <div class="session-mode-row">
                            <span class="session-mode-name">@ChargeModeTabs.Label(_status.Mode)@UntilFullSuffix(_status)</span>
                            @if (tab is not null)
                            {
                                <span class="tag accent">@DashboardText.Running</span>
                            }
                        </div>
                        <p class="muted session-mode-summary">
                            @if (tab is not null)
                            {
                                @tab.Summary
                            }
                            else
                            {
                                <text>@Localized.Format(DashboardText.NoModeDriving, Localized.Name(_status.ChargerStatus))</text>
                            }
                        </p>

                        @if (_status.BatteryHoldEnabled)
                        {
                            <p class="hold" id="battery-hold">
                                <span class="hold-label">@DashboardText.HoldLabel</span>
                                <span class="tag @(_status.BatteryHoldActive ? "accent" : null)">@(_status.BatteryHoldActive ? DashboardText.On : DashboardText.Off)</span>
                                <span class="muted">@HoldDetail(_status)</span>
                            </p>
                        }

                        @if (tab is not null)
                        {
                            <a class="session-mode-link" href="@($"/charging-plan/{tab.Slug}")">
                                @DashboardText.ChangeOrStop
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>
                                </svg>
                            </a>
                        }
                    </div>

                    @* Nothing counted yet with the car drawing (a car the charger started on plug-in, or the
                       first poll of a session) puts the power first: a large 0.0 kWh reads as broken. *@
                    @if (_status.SessionEnergyWh <= 0 && _status.EvChargerPowerWatts > 0)
                    {
                        <div class="session-energy">@Flow(_status.EvChargerPowerWatts)</div>
                        <p class="muted session-energy-note">@DashboardText.DrawingNow</p>
                    }
                    else
                    {
                        <div class="session-energy">@Units.Energy(_status.SessionEnergyWh)</div>
                        <p class="muted session-energy-note">
                            @(Showing is { SocPercent: { } carSoc }
                                ? Localized.Format(DashboardText.IntoCarWithSoc, Units.Percent(carSoc))
                                : DashboardText.IntoCar)
                        </p>
                    }
                    <dl class="session-facts">
                        <dt>
                            @DashboardText.ControlState
                            <InfoTip Topic="@DashboardText.ControlStateTopic">
                                <p>@DashboardText.ControlStateTip</p>
                            </InfoTip>
                        </dt>
                        <dd>@Localized.Name(_status.State)</dd>
                        <dt>
                            @DashboardText.ChargerStatus
                            <InfoTip Topic="@DashboardText.ChargerStatusTopic">
                                <p>@DashboardText.ChargerStatusTip</p>
                            </InfoTip>
                        </dt>
                        <dd>@Localized.Name(_status.ChargerStatus)</dd>
                        <dt>
                            @DashboardText.SessionEnergy
                            <InfoTip Topic="@DashboardText.SessionEnergyTopic">
                                <p>@DashboardText.SessionEnergyTip</p>
                            </InfoTip>
                        </dt>
                        <dd>@Units.Energy(_status.SessionEnergyWh)</dd>
                        <dt>@DashboardText.EvPower</dt>
                        <dd>@Units.Watts(_status.EvChargerPowerWatts)</dd>
                        <dt>
                            @DashboardText.EvCurrent
                            <InfoTip Topic="@DashboardText.EvCurrentTopic">
                                <p>@DashboardText.EvCurrentTip</p>
                            </InfoTip>
                        </dt>
                        <dd>@Units.Current(_status.EvChargingCurrentAmps)</dd>
                        <dt>
                            @DashboardText.TargetCurrent
                            <InfoTip Topic="@DashboardText.TargetCurrentTopic">
                                <p>@DashboardText.TargetCurrentTip</p>
                            </InfoTip>
                        </dt>
                        <dd>@Units.Current(_status.TargetCurrentAmps)</dd>
                        <dt>
                            @DashboardText.ActiveCurrent
                            <InfoTip Topic="@DashboardText.ActiveCurrentTopic">
                                <p>@DashboardText.ActiveCurrentTip</p>
                            </InfoTip>
                        </dt>
                        <dd>@Units.Current(_status.ActiveCurrentAmps)</dd>
                        <dt>
                            @DashboardText.LoanPower
                            <InfoTip Topic="@DashboardText.LoanPowerTopic">
                                <p>@DashboardText.LoanPowerTip</p>
                            </InfoTip>
                        </dt>
                        <dd>@Units.Watts(_status.LoanPowerWatts)</dd>
                    </dl>
                </section>
            }
        </aside>

        @* The car and the forecast stay in the main column's width, with the side cards running on
           beside them on a desktop: at the overview's full width a five-column table spreads into
           islands of figures. After the cards on a phone. *@
        <div class="overview-lower">

    @*
        The car is configuration; the feed is an attachment (#140). This section shows the car because
        it is *defined*, and then says which of four situations its feed is in -- because the card used
        to hide entirely until a reading arrived, which made three different situations look identical.

          no feed configured  -- the car and its pack, no reading. Nothing is wrong.
          healthy             -- the reading and its age.
          reading old         -- the same, marked stale past MaxAge.
          sign-in required    -- the feed is blocked on the owner, with the service's sentence.

        The last two must never look alike. *Stale* clears itself; *sign-in required* never will, and
        a charger sitting idle is already the most convincing impersonation of a fault this controller
        can produce -- so the one piece of information the owner can act on has to be the one that
        stands out.

        The age sits in the section's heading line rather than in a hint because it is the number that
        decides whether the SOC means anything: readings are routinely hours old while the car sleeps.

        One feed, one health, one action (#212): the installation reads its car from exactly one
        manufacturer feed, so the health beside the reading is the health of the feed that produced
        it, and a blocked feed says what fixes it with a link to where that is done.
    *@
    <div class="section-head">
        <h2>@DashboardText.Vehicle</h2>
        @if (Car.IsConfigured)
        {
            <span class="muted">@CarDescription()</span>
        }
        @if (Showing is not null)
        {
            <span class="muted" id="vehicle-reading-age">
                @(Via(Showing) is { } via
                    ? Localized.Format(DashboardText.UpdatedAgoVia, VehicleAge(Showing), via)
                    : Localized.Format(DashboardText.UpdatedAgo, VehicleAge(Showing)))
                @if (IsStale(Showing))
                {
                    <strong> @Localized.Format(DashboardText.StaleOlderThan, Units.Hours(VehicleDisplay.MaxAge))</strong>
                }
            </span>
            <InfoTip Topic="@DashboardText.ReadingTopic">
                <p>@DashboardText.ReadingTip</p>
            </InfoTip>
        }
    </div>

    @if (_feed is { IsBlocked: true } blocked)
    {
        <p class="error" id="vehicle-feed-blocked">
            <strong>Sign-in required</strong> — @(_service?.OwnerAction ?? blocked.Message)
            <a href="/car">Sign in on the car page</a>
        </p>
    }
    else if (_vehicle is null && _feed is not null)
    {
        <p class="muted">@Localized.Format(DashboardText.NoReadingYet, FeedName, _feed.Message)</p>
    }
    else if (_vehicle is null && Car.IsConfigured)
    {
        <p class="muted">
            @DashboardText.NoFeed
        </p>
    }

    @if (VehicleDisplay.OnDemandOnly)
    {
        @*
            On demand (issue #168): nothing is shown that nobody asked for. The reading exists in the
            holder and the API still serves it -- what changes is that this page does not put a number
            in front of an eye that will read it as current, when on the Data Act portal it is
            routinely two to four hours behind.
        *@
        <div class="actions">
            <button type="button" class="secondary" id="vehicle-ask"
                    disabled="@(_asking || !VehicleRefresh.CanRefresh)" @onclick="AskAsync">
                @(_asking ? DashboardText.AskingTheCar : DashboardText.AskTheCar)
            </button>
        </div>

        @if (!VehicleRefresh.CanRefresh)
        {
            <p class="muted">@DashboardText.NothingToAsk</p>
        }
        else if (_askError is { Length: > 0 })
        {
            <p class="error">@Localized.Format(DashboardText.CarDidNotAnswer, _askError)</p>
        }
        else if (_asked is null)
        {
            <p class="muted">
                @DashboardText.NotAskedYet
            </p>
        }
    }

    @* Three figures, each with the line under it that says how far to trust it. Plugged in is the
       charger's reading, always there; the car's own plug state only says whether it agrees. *@
    <section class="stat-grid">
        @if (Showing is { } shown)
        {
            <div class="stat">
                <div class="label">
                    @DashboardText.CarBattery
                    <InfoTip Topic="@DashboardText.CarBatteryTopic">
                        <p>@DashboardText.CarBatteryTip1</p>
                        <p>@DashboardText.CarBatteryTip2</p>
                    </InfoTip>
                </div>
                <div class="value">@Units.Percent(shown.SocPercent)</div>
                @if (shown.RangeMetres is not null)
                {
                    <div class="value-sub">@Localized.Format(DashboardText.Range, Units.Distance(shown.RangeMetres))</div>
                }
            </div>
        }

        <div class="stat">
            <div class="label">
                @DashboardText.PluggedInLabel
                <InfoTip Topic="@DashboardText.PluggedInTopic">
                    <p>@Localized.Rich(DashboardText.PluggedInTip1, @<strong>@DashboardText.PluggedInTip1_0</strong>)</p>
                    <p>@Localized.Rich(DashboardText.PluggedInTip2, @<strong>@DashboardText.PluggedInTip2_0</strong>)</p>
                </InfoTip>
            </div>
            <div class="value">@(_status.CarConnected ? DashboardText.Yes : DashboardText.No)</div>
            <div class="value-sub">@PlugAgreement(_status.CarConnected)</div>
        </div>

        @if (Showing is { } reported)
        {
            <div class="stat">
                <div class="label">
                    @DashboardText.ChargeState
                    <InfoTip Topic="@DashboardText.ChargeStateTopic">
                        <p>@DashboardText.ChargeStateTip</p>
                    </InfoTip>
                </div>
                <div class="value">@Localized.Name(reported.ChargeState)</div>
                <div class="value-sub">@DashboardText.AsReportedByCar</div>
            </div>
        }
    </section>

    <div class="section-head">
        <h2>@DashboardText.SolarForecast</h2>
        <InfoTip Topic="@DashboardText.SolarForecastTopic" Wide="true">
            <p>
                @Localized.Format(DashboardText.ForecastTip1, Time.LocalTimeZone.Id)
            </p>
            <p>@Localized.Rich(DashboardText.ForecastTip2, @<strong>@DashboardText.ForecastTip2_0</strong>)</p>
            <p>
                @Localized.Rich(DashboardText.ForecastTip3, @<strong>@DashboardText.ForecastTip3_0</strong>)
            </p>
            <p>
                @Localized.Rich(DashboardText.ForecastTip4, @<strong>@DashboardText.ForecastTip4_0</strong>)
            </p>
            <p>
                @Localized.Rich(DashboardText.ForecastTip5, @<strong>@DashboardText.ForecastTip5_0</strong>)
            </p>
            <p>
                @DashboardText.ForecastTip6
            </p>
            <p>
                @Localized.Rich(DashboardText.ForecastTip7, @<a href="/forecast">@DashboardText.ForecastTip7_0</a>)
            </p>
        </InfoTip>
    </div>

    @* Units in the tip, not in the cells or the headers, and the date under the day's name rather than
       beside it: five columns have to fit a phone, and either would push the table sideways. *@
    <table class="sessions energy forecast-days" id="solar-forecast">
        <thead>
            <tr>
                <th>@DashboardText.Day</th>
                <th class="num">@DashboardText.Expected</th>
                <th class="num">@DashboardText.Low</th>
                <th class="num">@DashboardText.High</th>
                <th class="num">@DashboardText.Peak</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (label, date, day) in _forecastDays)
            {
                <tr>
                    <td>@label <span class="muted forecast-date">@date.ToString(SharedText.DayMonthPattern, System.Globalization.CultureInfo.CurrentCulture)</span></td>
                    <td class="num">@Units.Kwh(day?.ExpectedWh, unit: false)</td>
                    <td class="num">@Units.Kwh(day?.LowWh, unit: false)</td>
                    <td class="num">@Units.Kwh(day?.HighWh, unit: false)</td>
                    <td class="num">@Units.Kw(day?.PeakWatts, unit: false)</td>
                </tr>
            }
        </tbody>
    </table>

        </div>
    </div>
}

@code {
    private ChargeControlStatus? _status;
    private VehicleState? _vehicle;

    /// <summary>What this page may put on screen (issue #168).</summary>
    /// <remarks>
    /// In ambient mode, whatever the holder has — the behaviour this page has always had. In
    /// on-demand mode, only what <see cref="AskAsync"/> just fetched: the reading in the holder is
    /// perfectly real and the API still serves it, but showing it unasked is the thing the mode
    /// exists to stop.
    /// </remarks>
    private VehicleState? Showing => VehicleDisplay.OnDemandOnly ? _asked : _vehicle;

    private VehicleState? _asked;
    private string? _askError;
    private bool _asking;
    private bool _vehicleStale;

    // The manufacturer feed's health, or null when no update service is configured -- which is itself
    // one of the four states, and the one that must read as "nothing is wrong".
    private VehicleSourceHealth? _feed;

    private IVehicleUpdateService? _service;

    // Today and tomorrow, in that order; a summary is null while no forecast is held for its day.
    private IReadOnlyList<(string Label, DateOnly Date, SolarDayForecastSummary? Summary)> _forecastDays = [];

    // The energy monitor's store, when it is on: it can be switched off on its own, and then the
    // figures are power now only. Asked for rather than injected for exactly that reason.
    private IEnergyIntervalStore? _energy;

    // Energy since local midnight, or null while there is no store to read it from.
    private TodayTotals? _today;
    private DateTimeOffset _todayReadAt = DateTimeOffset.MinValue;

    private bool _chartRendered;
    private bool _chartCreated;

    protected override async Task OnInitializedAsync()
    {
        _status = StatusHolder.Current;
        StatusHolder.Updated += OnStatusUpdated;

        // The installation's one feed, settled by the composition root (#212) -- not chosen here.
        _service = VehicleFeed.Service;
        _energy = Services.GetService<IEnergyIntervalStore>();

        RefreshVehicle();
        ReadDayForecasts();
        await ReadTodayAsync();
    }

    private void OnStatusUpdated(ChargeControlStatus status)
    {
        _status = status;

        // Read the car on the poll's cadence rather than subscribing to the holder as well. Vehicle
        // readings arrive minutes apart at best, so a few seconds of latency is invisible, and this
        // keeps the page to one event subscription and the render to one path.
        RefreshVehicle();
        ReadDayForecasts();

        // The plan is recomputed every poll, so its chart is redrawn every poll too -- the same choice
        // the Forecasted tab makes.
        _chartRendered = false;

        InvokeAsync(async () =>
        {
            await ReadTodayAsync();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Today's totals from the energy store. A query rather than a lookup, so at most once a minute:
    /// the store only gains a row every quarter hour, and a poll every few seconds asking for the
    /// same day again would be load for nothing.
    /// </summary>
    private async Task ReadTodayAsync()
    {
        if (_energy is null)
        {
            return;
        }

        var now = Time.GetUtcNow();
        if (now - _todayReadAt < TimeSpan.FromMinutes(1))
        {
            return;
        }

        _todayReadAt = now;

        var zone = Time.LocalTimeZone;
        var midnight = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(now, zone).DateTime).ToDateTime(TimeOnly.MinValue);
        var from = new DateTimeOffset(midnight, zone.GetUtcOffset(midnight));

        try
        {
            var intervals = await _energy.GetIntervalsAsync(from, now.AddMinutes(15), CancellationToken.None);
            _today = TodayTotals.From(intervals);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            // A store that cannot be read leaves the last totals on screen rather than breaking the
            // page: the live figures beside them do not depend on it.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartRendered
            || _status is not { Mode: ChargeControlMode.Forecasted, Plan: { Timeline.Count: > 0 } plan })
        {
            return;
        }

        _chartRendered = true;
        _chartCreated = true;

        await JS.InvokeVoidAsync(
            "solaxCharts.renderTimelineChart",
            "overview-plan-chart",
            plan.Timeline.Select(p => p.Start.ToUnixTimeSeconds()).ToArray(),
            plan.Timeline.Select(p => p.SurplusWatts).ToArray(),
            plan.Timeline.Select(p => p.RequiredSocFloorPercent).ToArray(),
            plan.NextFeasibleWindow?.Start.ToUnixTimeSeconds(),
            plan.NextFeasibleWindow?.End.ToUnixTimeSeconds(),
            _status.Timestamp.ToUnixTimeSeconds(),
            Tariff.Timeline?.LowWindows
                .Select(window => new[] { window.Start.ToUnixTimeSeconds(), window.End.ToUnixTimeSeconds() })
                .ToArray(),
            ChartText.Current());
    }

    /// <summary>The day so far, summed from the energy monitor's quarter hours.</summary>
    private sealed record TodayTotals(
        double SolarKwh, double HouseKwh, double BatteryInKwh, double BatteryOutKwh,
        double EvKwh, double ImportKwh, double ExportKwh, int Count)
    {
        public static TodayTotals From(IReadOnlyList<EnergyInterval> intervals) => new(
            intervals.Sum(i => i.SolarKwh),
            intervals.Sum(i => i.OtherLoadsKwh),
            intervals.Sum(i => i.BatteryChargeKwh),
            intervals.Sum(i => i.BatteryDischargeKwh),
            intervals.Sum(i => i.EvKwh),
            intervals.Sum(i => i.GridImportKwh),
            intervals.Sum(i => i.GridExportKwh),
            intervals.Count);
    }

    // Nothing recorded yet today (a fresh install, or the first quarter hour after midnight) leaves
    // the line off rather than printing a row of zeros that reads as a dark day.
    private string Today(Func<TodayTotals, double> pick) =>
        _today is not { Count: > 0 } ? "" : Units.Energy(Units.WattHoursFromKwh(pick(_today)));

    private string TodayInOut(Func<TodayTotals, double> into, Func<TodayTotals, double> outOf, string inWord, string outWord) =>
        _today is not { Count: > 0 }
            ? ""
            : $"{Units.Energy(Units.WattHoursFromKwh(into(_today)))} {inWord} · {Units.Energy(Units.WattHoursFromKwh(outOf(_today)))} {outWord}";

    // The house apart from the car, from the same live readings the figures beside it show: what the
    // roof makes and the grid brings in, less what the battery takes and the car draws. The Energy
    // page's "other loads" residual, live.
    private static double HouseWatts(ChargeControlStatus status) =>
        status.SolarPowerWatts + status.GridPowerWatts - status.BatteryPowerWatts - status.EvChargerPowerWatts;

    // What the hold is doing, beside the On/Off: armed is what was last written to the inverter,
    // requested is the owner's intent -- they differ while a mode is waiting to arm it.
    private static string HoldDetail(ChargeControlStatus status) => status switch
    {
        { BatteryHoldActive: true, BatteryHoldTargetWatts: { } target } => Localized.Format(DashboardText.HoldArmedAt, Units.Power(target)),
        { BatteryHoldActive: true } => DashboardText.HoldArmed,
        { BatteryHoldRequested: true } => DashboardText.HoldRequested,
        _ => DashboardText.HoldOff,
    };

    private string Window((DateTimeOffset Start, DateTimeOffset End)? window) =>
        window is { } w
            ? $"{TimeZoneInfo.ConvertTime(w.Start, Time.LocalTimeZone):HH:mm}–{TimeZoneInfo.ConvertTime(w.End, Time.LocalTimeZone):HH:mm}"
            : DashboardText.NoWindow;

    // A lookup, not a sum: the forecast source works the day totals out when a forecast lands, so this
    // is cheap enough for every poll. Reading it on the poll's cadence is also what picks up a refresh
    // and moves on to the next day at local midnight, without a subscription of its own.
    private void ReadDayForecasts()
    {
        var localToday = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Time.GetUtcNow(), Time.LocalTimeZone).DateTime);
        var localTomorrow = localToday.AddDays(1);
        _forecastDays =
        [
            (DashboardText.Today, localToday, Forecasts.GetDaySummary(localToday)),
            (DashboardText.Tomorrow, localTomorrow, Forecasts.GetDaySummary(localTomorrow)),
        ];
    }

    public async ValueTask DisposeAsync()
    {
        StatusHolder.Updated -= OnStatusUpdated;

        if (!_chartCreated)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("solaxCharts.dispose", "overview-plan-chart");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone (e.g. the browser tab closed) -- nothing left to clean up.
        }
    }

    // "Is there a session to report on?" -- deliberately not "is the mode Off". A car drawing power
    // under no mode at all is exactly the case this section should not hide: somebody plugged in and
    // the charger is in Fast on its own.
    private static bool IsCharging(ChargeControlStatus status) =>
        status.Mode != ChargeControlMode.Off || status.EvChargerPowerWatts > 0;

    // Until full (#279): one session over several days, so the mode's name says which day it is.
    private static string UntilFullSuffix(ChargeControlStatus status) =>
        status.UntilFull is { Day: var day } ? Localized.Format(DashboardText.UntilFullDay, day) : string.Empty;

    private void RefreshVehicle()
    {
        _vehicle = Vehicle.GetCurrentState();
        _vehicleStale = _vehicle is not null
            && _vehicle.IsStaleAt(Time.GetUtcNow(), VehicleDisplay.MaxAge);

        // Read on the poll's cadence like the reading itself: Health is a cheap property by contract,
        // and a feed whose state changed a few seconds ago changed nothing anyone can act on sooner.
        _feed = _service?.Health;
    }

    /// <summary>Which feed is being waited on, named the way its log lines name it.</summary>
    private string FeedName => _service is null ? DashboardText.TheFeed : _service.DisplayName;

    // The car, because it is configured -- shown whether or not anything reports on it. Name first
    // (an owner's own word for it), then what it is, then the pack, since the pack is what decides
    // whether a target can be asked for as a percentage at all.
    private string CarDescription()
    {
        var model = string.Join(" ", new[] { Car.Make, Car.Model }.Where(part => part.Length > 0));
        var name = string.IsNullOrWhiteSpace(Car.Name) ? model : Car.Name;
        var described = name == model || model.Length == 0 ? name : $"{name} — {model}";

        // A car described by its pack alone is a supported configuration (#124): everything else in
        // the Ev section is optional, so this must not render as a leading comma.
        if (described.Length == 0)
        {
            described = DashboardText.TheCar;
        }

        return Car.BatteryCapacityWh > 0
            ? Localized.Format(DashboardText.Usable, described, Units.Capacity(Car.BatteryCapacityWh))
            : described;
    }

    /// <summary>
    /// Whether this reading came from the configured feed. Matched on the name the feed puts on its
    /// readings, which begins with its <see cref="IVehicleUpdateService.Manufacturer"/> -- display
    /// only; nothing is dispatched on it. An MQTT reading beside it keeps its own name.
    /// </summary>
    private bool FromTheFeed(VehicleState reading) =>
        _service is not null
        && reading.SourceId is { } source
        && source.StartsWith(_service.Manufacturer, StringComparison.OrdinalIgnoreCase);

    /// <summary>The feed in the owner's words (#212), or the reading's own name when it is not the feed's.</summary>
    private string? Via(VehicleState reading) =>
        FromTheFeed(reading) ? _service!.DisplayName : reading.SourceId;

    // The line under Plugged in: the charger's reading is the figure, the car's own plug state only
    // says whether it agrees. Separate devices, and the car's is the slower one.
    private string PlugAgreement(bool charger) => Showing?.PlugState switch
    {
        null => DashboardText.AsChargerSees,
        VehiclePlugState.Unknown => DashboardText.CarDoesNotSay,
        VehiclePlugState.Connected when charger => DashboardText.Agree,
        VehiclePlugState.Disconnected when !charger => DashboardText.Agree,
        VehiclePlugState.Connected => DashboardText.CarSaysIs,
        _ => DashboardText.CarSaysIsNot,
    };

    private bool IsStale(VehicleState state) =>
        state.IsStaleAt(Time.GetUtcNow(), VehicleDisplay.MaxAge);

    /// <summary>
    /// Goes and asks. Failure keeps whatever was last fetched on screen rather than blanking it — an
    /// answer now known to be old is worth more than no answer, provided its age is beside it.
    /// </summary>
    private async Task AskAsync()
    {
        _asking = true;
        _askError = null;
        StateHasChanged();

        try
        {
            var result = await VehicleRefresh.RefreshAsync();

            if (result is { Succeeded: true, State: not null })
            {
                _asked = result.State;
            }
            else
            {
                _askError = result.Message;
                _asked ??= result.State;
            }
        }
        finally
        {
            _asking = false;
            StateHasChanged();
        }
    }

    private string VehicleAge(VehicleState vehicle) =>
        VehicleFormatting.Age(vehicle, Time.GetUtcNow());

    // The strip's figures: without a sign, since the word under each says which way it flows.
    private static string Flow(double watts) => Units.Power(Math.Abs(watts));
}
