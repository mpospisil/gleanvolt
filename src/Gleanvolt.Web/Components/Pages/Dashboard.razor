@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject ChargeControlStatusHolder StatusHolder
@inject IVehicleTelemetry Vehicle
@inject VehicleDisplayOptions VehicleDisplay
@inject IVehicleStateRefresh VehicleRefresh
@inject EvInfo Car
@inject ConfiguredVehicleFeed VehicleFeed
@inject ISolarForecastService Forecasts
@inject TimeProvider Time

@*
    The dashboard reports; it no longer decides (#98). Every control that used to sit under these
    numbers now lives on the Charging plan page, next to the mode it belongs to -- so this page can
    be read in the order the questions are actually asked, rather than as one undifferentiated grid
    of fourteen figures followed by a column of inputs.

    Four sections, in that order:

      Energy          -- the house: what the roof is making, what the battery and the grid are doing.
                         True whatever is or isn't plugged in, which is why it comes first.
      Solar forecast  -- today and tomorrow as a table, with what each column means written beneath it
                         rather than in hover hints: these figures are read against each other --
                         tomorrow against today, the cautious band against the median -- not one at a time.
      Vehicle         -- the car: the charger's own view of whether one is connected, plus whatever
                         the car's one feed last said about itself (#73, #140, #212). Read-only,
                         and nothing in the control logic consumes the cloud half yet.
      Charging session-- what is happening at the charger right now, shown only while something is
                         happening: a mode is driving, or the car is drawing power under nobody's
                         control. Off with an idle charger gets one line and a way to start, not a
                         grid of dashes.

    Each figure keeps its meaning inline, since MQTT discovery has nowhere to put one and README's
    "what each entity means" table is what the hints are drawn from.

    Follows StatusHolder.Updated exactly like the health page: seeded from Current before
    subscribing, so a browser that arrives between two polls sees the last one rather than nothing,
    then pushed a new value down the circuit on every completed poll.
*@

<SiteTitle Page="Dashboard" />

<h1>Dashboard</h1>

@if (_status is null)
{
    <p class="muted">No poll has completed yet.</p>
}
else
{
    <p class="muted">
        Updated @TimeZoneInfo.ConvertTime(_status.Timestamp, Time.LocalTimeZone).ToString("HH:mm:ss")
    </p>

    <h2>Energy</h2>

    <section class="stat-grid">
        <Stat Label="Solar power" Value="@Watts(_status.SolarPowerWatts)"
              Hint="PV production measured at the inverter, before the house, the battery or the car take any of it." />
        <Stat Label="Forecast solar power" Value="@Watts(_status.ForecastSolarPowerWatts)"
              Hint="What the forecast expected the roof to be making right now, to read against the measured figure beside it. 0 when no forecast covers this moment." />
        <Stat Label="Solar surplus" Value="@Watts(_status.SurplusWatts)"
              Hint="PV left after household consumption -- the smoothed 3-minute average the solar modes decide on. Blank when the selected mode doesn't decide on surplus." />
        <Stat Label="Battery SOC" Value="@Percent(_status.BatterySocPercent)"
              Hint="Home battery state of charge as the inverter reports it." />
        <Stat Label="Battery power" Value="@Watts(_status.BatteryPowerWatts)"
              Hint="Positive while the battery charges, negative while it discharges." />
        <Stat Label="Grid power" Value="@Watts(_status.GridPowerWatts)"
              Hint="Positive while importing from the grid, negative while exporting." />
    </section>

    <h2>Solar forecast</h2>

    @* Units in the note, not in the cells or the headers, and the date under the day's name rather than
       beside it: five columns have to fit a phone, and either would push the table sideways. *@
    <table class="sessions energy forecast-days" id="solar-forecast">
        <thead>
            <tr>
                <th>Day</th>
                <th class="num">Expected</th>
                <th class="num">Low (p10)</th>
                <th class="num">High (p90)</th>
                <th class="num">Peak</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (label, date, day) in _forecastDays)
            {
                <tr>
                    <td>@label <span class="muted forecast-date">@date.ToString("ddd d MMM", System.Globalization.CultureInfo.InvariantCulture)</span></td>
                    <td class="num">@Figure(day?.ExpectedWh)</td>
                    <td class="num">@Figure(day?.LowWh)</td>
                    <td class="num">@Figure(day?.HighWh)</td>
                    <td class="num">@Figure(day?.PeakWatts)</td>
                </tr>
            }
        </tbody>
    </table>

    <p class="muted table-note">
        Energy in kWh, peak power in kW. Each row is a whole day, midnight to midnight in
        @Time.LocalTimeZone.Id time. Today's includes the hours already gone, as last forecast before they
        happened, so it is what the day was expected to bring rather than what is still to come.
        <strong>Expected</strong> is Solcast's median: as likely to be beaten as missed.
        <strong>Low (p10)</strong> is the cautious figure, one the day should beat about nine times in ten —
        the Forecasted mode plans on this band by default.
        <strong>High (p90)</strong> is the hopeful one, beaten only about one time in ten; the wider the gap
        between the two, the less sure the sky.
        <strong>Peak</strong> is the strongest half hour the median expects, before the house takes its
        share — a quick check on whether the roof will make enough to charge the car at all.
        Solcast is asked again every few hours in daylight, so tomorrow's figures keep moving until the
        day arrives. A dash means no forecast is held for that day yet.
        <a href="/forecast">Forecast</a> has the same two days period by period — a day total and a
        day's shape are different things, and this is the total.
    </p>

    <h2>Vehicle</h2>

    @*
        The car is configuration; the feed is an attachment (#140). This section shows the car because
        it is *defined*, and then says which of four situations its feed is in -- because the card used
        to hide entirely until a reading arrived, which made three different situations look identical.

          no feed configured  -- the car and its pack, no reading. Nothing is wrong.
          healthy             -- the reading and its age.
          reading old         -- the same, marked stale past MaxAge.
          sign-in required    -- the feed is blocked on the owner, with the service's sentence.

        The last two must never look alike. *Stale* clears itself; *sign-in required* never will, and
        a charger sitting idle is already the most convincing impersonation of a fault this controller
        can produce -- so the one piece of information the owner can act on has to be the one that
        stands out.

        The age is shown next to the SOC rather than tucked into a hint because it is the number that
        decides whether the SOC means anything: readings are routinely hours old while the car sleeps.

        One feed, one health, one action (#212): the installation reads its car from exactly one
        manufacturer feed, so the health beside the reading is the health of the feed that produced
        it, and a blocked feed says what fixes it with a link to where that is done.
    *@
    @if (Car.IsConfigured)
    {
        <p class="muted">@CarDescription()</p>
    }

    @if (_feed is { IsBlocked: true } blocked)
    {
        <p class="error" id="vehicle-feed-blocked">
            <strong>Sign-in required</strong> — @(_service?.OwnerAction ?? blocked.Message)
            <a href="/vehicle-portal">Open the vehicle page</a>
        </p>
    }
    else if (_vehicle is null && _feed is not null)
    {
        <p class="muted">@FeedName has not delivered a reading yet — @_feed.Message</p>
    }
    else if (_vehicle is null && Car.IsConfigured)
    {
        <p class="muted">
            No feed is configured for this car, so there is no reading — nothing is wrong. Charging
            works in kilowatt-hours either way; a feed only adds the car's own view of itself.
        </p>
    }

    @if (VehicleDisplay.OnDemandOnly)
    {
        @*
            On demand (issue #168): nothing is shown that nobody asked for. The reading exists in the
            holder and the API still serves it -- what changes is that this page does not put a number
            in front of an eye that will read it as current, when on the Data Act portal it is
            routinely two to four hours behind.
        *@
        <div class="actions">
            <button type="button" class="secondary" id="vehicle-ask"
                    disabled="@(_asking || !VehicleRefresh.CanRefresh)" @onclick="AskAsync">
                @(_asking ? "Asking the car…" : "Ask the car")
            </button>
        </div>

        @if (!VehicleRefresh.CanRefresh)
        {
            <p class="muted">No feed is configured for this car, so there is nothing to ask.</p>
        }
        else if (_askError is { Length: > 0 })
        {
            <p class="error">The car did not answer — @_askError</p>
        }
        else if (_asked is null)
        {
            <p class="muted">
                The battery and range are not shown until you ask for them. A reading can be hours
                behind the car, and a figure nobody requested is a figure nobody checked the age of.
            </p>
        }
    }

    @if (Showing is not null)
    {
        <p class="muted" id="vehicle-reading-age">
            Reported by the car @VehicleAge(Showing) ago@(Via(Showing) is { } via ? $" via {via}" : "")
            @if (IsStale(Showing))
            {
                <strong> — stale, older than @(VehicleDisplay.MaxAge.TotalHours.ToString("F0")) h</strong>
            }
        </p>
    }

    <section class="stat-grid">
        <Stat Label="Car connected" Value="@(_status.CarConnected ? "Yes" : "No")"
              Hint="Whether a vehicle is plugged in, as the charger sees it. Says nothing about whether it is drawing power." />

        @if (Showing is { } shown)
        {
            <Stat Label="Car battery" Value="@Percent(shown.SocPercent)"
                  Hint="The car's own state of charge, as its cloud integration last reported it. Not the home battery." />
            <Stat Label="Car range" Value="@Km(shown.RangeKm)"
                  Hint="What the car reckons is left in it, off its own recent consumption. Nothing here plans on it; it is the figure that says whether the charge you are about to ask for is enough." />
            <Stat Label="Car reading age" Value="@VehicleAge(shown)"
                  Hint="How long ago the car itself produced this reading — not when we received it. Hours old is normal for a parked car; days old means the feed has died." />
            <Stat Label="Car charge state" Value="@shown.ChargeState.ToString()"
                  Hint="What the car says it is doing: Idle, Charging, Complete, or Unknown when it doesn't report." />
            <Stat Label="Car plug state" Value="@shown.PlugState.ToString()"
                  Hint="Whether the car says a cable is in its socket. A separate reading from the charger's own status, and a much slower one." />
        }
    </section>

    <h2>Charging session</h2>

    @if (!IsCharging(_status))
    {
        <p class="muted">
            Nothing is charging. Charge mode is <strong>@_status.Mode</strong> and the charger reports
            <strong>@_status.ChargerStatus</strong> — start a mode on the
            <a href="/charging-plan">Charging plan</a> page.
        </p>
    }
    else
    {
        <section class="stat-grid">
            <Stat Label="Charge mode" Value="@_status.Mode.ToString()"
                  Hint="Which strategy is driving the charger, as of the last poll. Always starts at Off after a restart, and is changed from the Charging plan page." />
            <Stat Label="Control state" Value="@_status.State.ToString()"
                  Hint="What charge control is doing right now: Disabled (nothing running), Idle (running but not acting, usually because the charger is no longer in Fast), Charging, or Paused." />
            <Stat Label="Charger status" Value="@_status.ChargerStatus.ToString()"
                  Hint="The charger's own reported state, straight from its register." />
            <Stat Label="Session energy" Value="@Kwh(_status.SessionEnergyWh)"
                  Hint="Energy delivered to the car since it was plugged in. Starts afresh when it's unplugged." />

            <Stat Label="EV charging power" Value="@Watts(_status.EvChargerPowerWatts)"
                  Hint="What the charger reports the car actually drawing right now -- not a setpoint." />
            <Stat Label="EV charging current" Value="@Amps(_status.EvChargingCurrentAmps)"
                  Hint="Charging current derived from the charger's measured power: what the car really takes." />
            <Stat Label="Target current" Value="@Amps(_status.TargetCurrentAmps)"
                  Hint="The current the controller decided on this cycle, before it was written. Blank whenever it isn't charging." />
            <Stat Label="Active current" Value="@Amps(_status.ActiveCurrentAmps)"
                  Hint="The charger's setpoint read back from the hardware: what it was actually left at." />

            <Stat Label="Battery loan power" Value="@Watts(_status.LoanPowerWatts)"
                  Hint="How much of what the car is drawing right now is covered by the home battery rather than by live sun. Zero outside the Forecasted mode." />
        </section>
    }
}

@code {
    private ChargeControlStatus? _status;
    private VehicleState? _vehicle;

    /// <summary>What this page may put on screen (issue #168).</summary>
    /// <remarks>
    /// In ambient mode, whatever the holder has — the behaviour this page has always had. In
    /// on-demand mode, only what <see cref="AskAsync"/> just fetched: the reading in the holder is
    /// perfectly real and the API still serves it, but showing it unasked is the thing the mode
    /// exists to stop.
    /// </remarks>
    private VehicleState? Showing => VehicleDisplay.OnDemandOnly ? _asked : _vehicle;

    private VehicleState? _asked;
    private string? _askError;
    private bool _asking;
    private bool _vehicleStale;

    // The manufacturer feed's health, or null when no update service is configured -- which is itself
    // one of the four states, and the one that must read as "nothing is wrong".
    private VehicleSourceHealth? _feed;

    private IVehicleUpdateService? _service;

    // Today and tomorrow, in that order; a summary is null while no forecast is held for its day.
    private IReadOnlyList<(string Label, DateOnly Date, SolarDayForecastSummary? Summary)> _forecastDays = [];

    protected override void OnInitialized()
    {
        _status = StatusHolder.Current;
        StatusHolder.Updated += OnStatusUpdated;

        // The installation's one feed, settled by the composition root (#212) -- not chosen here.
        _service = VehicleFeed.Service;

        RefreshVehicle();
        ReadDayForecasts();
    }

    private void OnStatusUpdated(ChargeControlStatus status)
    {
        _status = status;

        // Read the car on the poll's cadence rather than subscribing to the holder as well. Vehicle
        // readings arrive minutes apart at best, so a few seconds of latency is invisible, and this
        // keeps the page to one event subscription and the render to one path.
        RefreshVehicle();
        ReadDayForecasts();

        InvokeAsync(StateHasChanged);
    }

    // A lookup, not a sum: the forecast source works the day totals out when a forecast lands, so this
    // is cheap enough for every poll. Reading it on the poll's cadence is also what picks up a refresh
    // and moves on to the next day at local midnight, without a subscription of its own.
    private void ReadDayForecasts()
    {
        var localToday = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Time.GetUtcNow(), Time.LocalTimeZone).DateTime);
        var localTomorrow = localToday.AddDays(1);
        _forecastDays =
        [
            ("Today", localToday, Forecasts.GetDaySummary(localToday)),
            ("Tomorrow", localTomorrow, Forecasts.GetDaySummary(localTomorrow)),
        ];
    }

    public void Dispose() => StatusHolder.Updated -= OnStatusUpdated;

    // "Is there a session to report on?" -- deliberately not "is the mode Off". A car drawing power
    // under no mode at all is exactly the case this section should not hide: somebody plugged in and
    // the charger is in Fast on its own.
    private static bool IsCharging(ChargeControlStatus status) =>
        status.Mode != ChargeControlMode.Off || status.EvChargerPowerWatts > 0;

    private void RefreshVehicle()
    {
        _vehicle = Vehicle.GetCurrentState();
        _vehicleStale = _vehicle is not null
            && _vehicle.IsStaleAt(Time.GetUtcNow(), VehicleDisplay.MaxAge);

        // Read on the poll's cadence like the reading itself: Health is a cheap property by contract,
        // and a feed whose state changed a few seconds ago changed nothing anyone can act on sooner.
        _feed = _service?.Health;
    }

    /// <summary>Which feed is being waited on, named the way its log lines name it.</summary>
    private string FeedName => _service is null ? "The feed" : _service.DisplayName;

    // The car, because it is configured -- shown whether or not anything reports on it. Name first
    // (an owner's own word for it), then what it is, then the pack, since the pack is what decides
    // whether a target can be asked for as a percentage at all.
    private string CarDescription()
    {
        var model = string.Join(" ", new[] { Car.Make, Car.Model }.Where(part => part.Length > 0));
        var name = string.IsNullOrWhiteSpace(Car.Name) ? model : Car.Name;
        var described = name == model || model.Length == 0 ? name : $"{name} — {model}";

        // A car described by its pack alone is a supported configuration (#124): everything else in
        // the Ev section is optional, so this must not render as a leading comma.
        if (described.Length == 0)
        {
            described = "The car";
        }

        return Car.BatteryCapacityKWh > 0
            ? $"{described}, {Car.BatteryCapacityKWh:0.#} kWh usable"
            : described;
    }

    // The car's figures are formatted in VehicleFormatting rather than here (#178): /vehicle-portal
    // shows the same ones, and it exists to be compared against this card. Two roundings would let
    // the two pages disagree over a reading they agree on.
    private static string Km(double? km) => VehicleFormatting.Km(km);

    /// <summary>
    /// Whether this reading came from the configured feed. Matched on the name the feed puts on its
    /// readings, which begins with its <see cref="IVehicleUpdateService.Manufacturer"/> -- display
    /// only; nothing is dispatched on it. An MQTT reading beside it keeps its own name.
    /// </summary>
    private bool FromTheFeed(VehicleState reading) =>
        _service is not null
        && reading.SourceId is { } source
        && source.StartsWith(_service.Manufacturer, StringComparison.OrdinalIgnoreCase);

    /// <summary>The feed in the owner's words (#212), or the reading's own name when it is not the feed's.</summary>
    private string? Via(VehicleState reading) =>
        FromTheFeed(reading) ? _service!.DisplayName : reading.SourceId;

    private bool IsStale(VehicleState state) =>
        state.IsStaleAt(Time.GetUtcNow(), VehicleDisplay.MaxAge);

    /// <summary>
    /// Goes and asks. Failure keeps whatever was last fetched on screen rather than blanking it — an
    /// answer now known to be old is worth more than no answer, provided its age is beside it.
    /// </summary>
    private async Task AskAsync()
    {
        _asking = true;
        _askError = null;
        StateHasChanged();

        try
        {
            var result = await VehicleRefresh.RefreshAsync();

            if (result is { Succeeded: true, State: not null })
            {
                _asked = result.State;
            }
            else
            {
                _askError = result.Message;
                _asked ??= result.State;
            }
        }
        finally
        {
            _asking = false;
            StateHasChanged();
        }
    }

    private string VehicleAge(VehicleState vehicle) =>
        VehicleFormatting.Age(vehicle, Time.GetUtcNow());

    private static string Watts(double watts) => $"{watts:F0} W";

    private static string Watts(double? watts) => watts is null ? "—" : $"{watts.Value:F0} W";

    private static string Kwh(double wattHours) => $"{wattHours / 1000:F1} kWh";

    private static string Kwh(double? wattHours) => wattHours is null ? "—" : Kwh(wattHours.Value);

    // A forecast-table cell: Wh as kWh, or W as kW, with the unit left to the column header.
    private static string Figure(double? value) => value is null ? "—" : $"{value.Value / 1000:F1}";

    private static string Percent(double percent) => $"{percent:F0}%";

    private static string Percent(double? percent) => VehicleFormatting.Percent(percent);

    private static string Amps(int amps) => $"{amps} A";

    private static string Amps(int? amps) => amps is null ? "—" : $"{amps.Value} A";
}
