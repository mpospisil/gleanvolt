@page "/sessions/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IChargingSessionStore Store
@inject TimeProvider Time
@inject IJSRuntime JS

@*
    Phase 4 (#49). The per-source split and the chart of what the session did. The chart is the
    vendored uPlot (issue #44's decision) via JS interop -- see wwwroot/js/charts.js -- so it keeps
    rendering with no internet connection, which is exactly when a locally controlled system is most
    worth looking at.

    It began as one line, the home battery's SOC, while every sample carried a dozen more figures that
    the page showed nowhere. #175 gave it the day chart's vocabulary over the session's own window:
    what the roof made, what crossed the meter each way, what the wall delivered and what the car said
    about itself -- because "where did those 7 kWh come from, and why did it drop at 14:20" is the
    question this page is opened to answer. The arithmetic lives in SessionChartSeries, where it is
    tested; this page only hands it over and prints the list of marked moments beside it.
*@

<SiteTitle Page="@HistoryText.SessionPageTitle" />

<p><a href="/sessions">@HistoryText.AllSessions</a></p>

@if (_error)
{
    <p class="muted">@HistoryText.HistoryUnavailable</p>
}
else if (!_loaded)
{
    <p class="muted">@HistoryText.Loading</p>
}
else if (_document is null)
{
    <p class="muted">@HistoryText.NoSuchSession</p>
}
else
{
    var session = _document.Session;

    <h1>@HistoryText.Session</h1>

    <dl class="facts">
        <dt>@HistoryText.Started</dt>
        <dd>@Local(session.StartedAt)</dd>

        <dt>@HistoryText.Ended</dt>
        <dd>@(session.EndedAt is { } ended ? Local(ended) : HistoryText.InProgress)</dd>

        <dt>@HistoryText.Duration</dt>
        <dd>@Units.Duration(session.Duration(Time.GetUtcNow()))</dd>

        <dt>@HistoryText.Strategy</dt>
        <dd>@session.FormatStrategy()</dd>

        @if (session.EndReason is { } reason)
        {
            <dt>@HistoryText.EndReason</dt>
            <dd>@Localized.Name(reason)</dd>
        }

        <dt>@HistoryText.BatterySoc</dt>
        <dd>@Units.Percent(session.StartBatterySocPercent) → @Units.Percent(session.EndBatterySocPercent)</dd>

        <dt>@HistoryText.PeakPower</dt>
        <dd>@Units.Power(session.PeakChargingPowerWatts)</dd>

        @if (session.DayForecast is { Periods.Count: > 0 } dayForecast)
        {
            @* The whole day, not the session: what the roof was expected to make around this car. *@
            <dt>@HistoryText.DayForecast</dt>
            <dd>@SessionFormatting.FormatDayForecast(dayForecast)</dd>
        }

        @if (session.WeatherAtStart is { } weatherAtStart)
        {
            @*
                What the sky actually did, against what the forecast above expected of it. Both
                readings when they differ; one line when the session ended in the weather it started in.
            *@
            <dt>@HistoryText.Weather</dt>
            <dd>
                @SessionFormatting.FormatWeather(weatherAtStart)
                @if (session.WeatherAtEnd is { } weatherAtEnd)
                {
                    @: → @SessionFormatting.FormatWeather(weatherAtEnd)
                }
            </dd>
        }

        @if (session.Sunrise is { } sunrise && session.Sunset is { } sunset)
        {
            <dt>@HistoryText.Daylight</dt>
            <dd>
                @Local(sunrise, "HH:mm") – @Local(sunset, "HH:mm")
                @if (session.DaylightLength is { } daylight)
                {
                    @: (@Units.Duration(daylight))
                }
            </dd>
        }
    </dl>

    <section class="split">
        <h2>@HistoryText.EnergySplit</h2>
        <p class="muted">
            @(session.LoanedWh > 0
                ? Localized.Format(HistoryText.DeliveredWithLoan, Units.Kwh(session.EnergyDeliveredWh, 2), Units.Kwh(session.LoanedWh, 2))
                : Localized.Format(HistoryText.DeliveredOnly, Units.Kwh(session.EnergyDeliveredWh, 2)))
        </p>

        @if (session.EnergyDeliveredWh > 0)
        {
            <div class="split-bar">
                <span class="solar" style="width:@Share(session.FromSolarWh, session.EnergyDeliveredWh)"></span>
                <span class="grid" style="width:@Share(session.FromGridWh, session.EnergyDeliveredWh)"></span>
                <span class="battery" style="width:@Share(session.FromBatteryWh, session.EnergyDeliveredWh)"></span>
            </div>
            <ul class="split-legend">
                <li><span class="swatch solar"></span>@Localized.Format(HistoryText.SplitSolar, Units.Kwh(session.FromSolarWh, 2))</li>
                <li><span class="swatch grid"></span>@Localized.Format(HistoryText.SplitGrid, Units.Kwh(session.FromGridWh, 2))</li>
                <li><span class="swatch battery"></span>@Localized.Format(HistoryText.SplitBattery, Units.Kwh(session.FromBatteryWh, 2))</li>
            </ul>
        }
        else
        {
            <p class="muted">@HistoryText.NoEnergy</p>
        }
    </section>

    <section class="chart-section">
        <h2>@HistoryText.TheSession</h2>
        @if (_chart is null)
        {
            <p class="muted">@HistoryText.NoSamples</p>
        }
        else
        {
            <div id="session-chart" class="chart session"></div>
            <p class="muted chart-note">
                @Localized.Rich(HistoryText.ChartNote, @<strong>@HistoryText.SeriesGrid</strong>, @<strong>@HistoryText.SeriesBattery</strong>)
                @if (_chart.HasPlanFloor)
                {
                    @Localized.Rich(HistoryText.ChartNoteFloor, @<strong>@HistoryText.SeriesSocFloor</strong>)
                }
                @if (_chart.HasLoan)
                {
                    @Localized.Rich(HistoryText.ChartNoteLoan, @<strong>@HistoryText.SeriesBatteryLoan</strong>)
                }
                @if (_chart.HasVehicleSoc)
                {
                    @Localized.Rich(HistoryText.ChartNoteCarSoc, @<strong>@HistoryText.SeriesCarSoc</strong>)
                }
            </p>

            @if (_chart.MarkTimes.Length > 0)
            {
                <ul class="chart-marks">
                    @for (var i = 0; i < _chart.MarkTimes.Length; i++)
                    {
                        <li>
                            <time>@Local(DateTimeOffset.FromUnixTimeSeconds(_chart.MarkTimes[i]), "HH:mm")</time>
                            <span>@_chart.MarkLabels[i]</span>
                        </li>
                    }
                </ul>
            }
        }
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ChargingSessionDocument? _document;
    private SessionChartSeries? _chart;
    private bool _loaded;
    private bool _error;
    private bool _chartRendered;

    // See Forecast.razor for the reasoning: _chartRendered is reset per navigation to force a
    // redraw, so DisposeAsync needs its own "has JS ever been given a chart here" flag. Without it,
    // disposal during the static prerender pass issues interop that is not allowed yet and throws.
    private bool _chartCreated;

    protected override async Task OnParametersSetAsync()
    {
        _chartRendered = false;
        _loaded = false;
        _error = false;
        try
        {
            _document = await Store.ExportAsync(Id, CancellationToken.None);

            // Null for a session with nothing sampled, which is what the empty state keys off: a
            // chart frame around no data says less than the sentence does.
            _chart = _document is { Samples.Count: > 0 }
                ? SessionChartSeries.From(_document, Time.LocalTimeZone, Time.GetUtcNow())
                : null;
        }
        catch (Exception)
        {
            _document = null;
            _chart = null;
            _error = true;
        }
        finally
        {
            _loaded = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartRendered || _chart is null)
        {
            return;
        }

        _chartRendered = true;
        _chartCreated = true;

        await JS.InvokeVoidAsync("solaxCharts.renderSessionChart", "session-chart", _chart, ChartText.Current());
    }

    public async ValueTask DisposeAsync()
    {
        if (!_chartCreated)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("solaxCharts.dispose", "session-chart");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone (e.g. the browser tab closed) -- nothing left to clean up.
        }
    }

    private string Local(DateTimeOffset value) => Local(value, SharedText.DateTimePattern);

    private string Local(DateTimeOffset value, string format) =>
        TimeZoneInfo.ConvertTime(value, Time.LocalTimeZone).ToString(format);

    private static string Share(double value, double total) =>
        Units.Percent(total > 0 ? value / total * 100 : 0, 1);
}
