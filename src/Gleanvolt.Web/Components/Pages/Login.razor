@page "/login"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Http
@inject Gleanvolt.Web.Auth.WebPasswordState Password
@inject NavigationManager Navigation
@inject PvSystemInfo Site

@*
    The one page in this assembly that must run as static server-side rendering rather than an
    interactive circuit -- see App.razor's comment for why. Because it is static, the form below is a
    normal HTTP POST (Blazor's enhanced navigation notwithstanding): OnValidSubmit runs inside that
    request, with HttpContext still the one the response will be written to, which is what lets
    SignInAsync's Set-Cookie header actually reach the browser.
*@

@* The product, not the system: this page is reached before anyone has signed in, and the tab of a
   sign-in prompt is the one place naming the installation buys nothing. *@
<PageTitle>Sign in — Gleanvolt</PageTitle>

@*
    The card is the page (#255, direction 2a): the sun mark, the product and the installation's name,
    then the one field. The name sits on the card as well as in the header because this is the screen
    where knowing which roof you are about to sign in to matters -- and on a phone the header's copy of
    it is the first thing to be cut short.

    The wrong-password state (2c) marks the field itself and says so under it, tied to it with
    aria-describedby so a screen reader reads the error with the field rather than somewhere above it.
*@
<div class="login-card sign-in">
    <div class="sign-in-mark"><SunMark /></div>
    <h1>Gleanvolt</h1>
    @if (!string.IsNullOrWhiteSpace(Site.Name))
    {
        <p class="sign-in-site">@Site.Name</p>
    }

    <EditForm EditContext="_form" method="post" FormName="login" OnValidSubmit="SignInAsync">
        <DataAnnotationsValidator />

        <label for="password">Password</label>
        @* InputText sets aria-invalid and the "invalid" class itself, from the message SignInAsync
           records against the field; only the link to the words is this page's to add. *@
        <InputText id="password" type="password" @bind-Value="Input!.Password" autofocus
                   autocomplete="current-password"
                   aria-describedby="@(_failed ? "password-error" : null)" />

        @if (_failed)
        {
            <p class="error field-error" id="password-error">Wrong password.</p>
        }

        <button type="submit" class="btn btn-primary">Sign in</button>
    </EditForm>

    @* Where the password comes from, both ways it can -- the Setup page (which writes it to the
       overrides file) or Web__PasswordHash set by hand. No file is named: which one holds it depends on
       which way it was set. There is no reset link because there is nothing behind one. *@
    <p class="sign-in-hint">
        One password for this installation, chosen on its Setup page the first time it ran or set as
        <code>Web__PasswordHash</code>. There is no reset from here: a forgotten one is replaced in the
        settings on the machine itself.
    </p>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    private LoginInput? Input { get; set; }

    private bool _failed;

    private EditContext _form = default!;

    private ValidationMessageStore _messages = default!;

    // [SupplyParameterFromForm] only populates Input on a matching POST; the initial GET (and any
    // other render) needs a model of its own for EditForm to bind against. The context is explicit so
    // a wrong password can be recorded as the field's own validation message: that is what makes
    // InputText mark the field invalid, for the eye and for a screen reader alike.
    protected override void OnInitialized()
    {
        Input ??= new();
        _form = new EditContext(Input);
        _messages = new ValidationMessageStore(_form);
    }

    private async Task SignInAsync()
    {
        // The live hash rather than the startup snapshot: a password set through /setup in this
        // same process has to work without a restart, which is the point of the state holder.
        if (!WebPasswordHasher.Verify(Password.Hash, Input?.Password ?? ""))
        {
            _failed = true;
            _messages.Add(() => Input!.Password, "Wrong password.");
            _form.NotifyValidationStateChanged();
            return;
        }

        // One claim is enough: there is exactly one shared account, not a user to look up.
        var identity = new ClaimsIdentity(CookieAuthenticationDefaults.AuthenticationScheme);
        identity.AddClaim(new Claim(ClaimTypes.Name, "operator"));

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identity),
            new AuthenticationProperties { IsPersistent = true });

        // forceLoad: a full navigation, not a client-side route change -- the browser needs the
        // Set-Cookie response above to have landed before the next request carries it back.
        Navigation.NavigateTo(RedirectTarget(), forceLoad: true);
    }

    // Never trusts ReturnUrl past "an in-app relative path": an absolute or scheme-qualified value
    // could otherwise send a freshly authenticated browser off this host entirely.
    private string RedirectTarget() =>
        !string.IsNullOrWhiteSpace(ReturnUrl) && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative)
            ? ReturnUrl
            : "/";

    private sealed class LoginInput
    {
        [Required]
        public string Password { get; set; } = "";
    }
}
