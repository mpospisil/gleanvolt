@page "/login"
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Http
@inject IOptions<WebOptions> Options
@inject NavigationManager Navigation

@*
    The one page in this assembly that must run as static server-side rendering rather than an
    interactive circuit -- see App.razor's comment for why. Because it is static, the form below is a
    normal HTTP POST (Blazor's enhanced navigation notwithstanding): OnValidSubmit runs inside that
    request, with HttpContext still the one the response will be written to, which is what lets
    SignInAsync's Set-Cookie header actually reach the browser.
*@

@* The product, not the system: this page is reached before anyone has signed in, and the tab of a
   sign-in prompt is the one place naming the installation buys nothing. *@
<PageTitle>Sign in — Gleanvolt</PageTitle>

<div class="login-card">
    <h1>Sign in</h1>

    @if (_failed)
    {
        <p class="error">Wrong password.</p>
    }

    <EditForm Model="Input" method="post" FormName="login" OnValidSubmit="SignInAsync">
        <DataAnnotationsValidator />

        <label>
            Password
            <InputText type="password" @bind-Value="Input!.Password" autofocus />
        </label>

        <button type="submit">Sign in</button>
    </EditForm>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm]
    private LoginInput? Input { get; set; }

    private bool _failed;

    // [SupplyParameterFromForm] only populates Input on a matching POST; the initial GET (and any
    // other render) needs a model of its own for EditForm to bind against.
    protected override void OnInitialized() => Input ??= new();

    private async Task SignInAsync()
    {
        if (!WebPasswordHasher.Verify(Options.Value.PasswordHash, Input?.Password ?? ""))
        {
            _failed = true;
            return;
        }

        // One claim is enough: there is exactly one shared account, not a user to look up.
        var identity = new ClaimsIdentity(CookieAuthenticationDefaults.AuthenticationScheme);
        identity.AddClaim(new Claim(ClaimTypes.Name, "operator"));

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identity),
            new AuthenticationProperties { IsPersistent = true });

        // forceLoad: a full navigation, not a client-side route change -- the browser needs the
        // Set-Cookie response above to have landed before the next request carries it back.
        Navigation.NavigateTo(RedirectTarget(), forceLoad: true);
    }

    // Never trusts ReturnUrl past "an in-app relative path": an absolute or scheme-qualified value
    // could otherwise send a freshly authenticated browser off this host entirely.
    private string RedirectTarget() =>
        !string.IsNullOrWhiteSpace(ReturnUrl) && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative)
            ? ReturnUrl
            : "/";

    private sealed class LoginInput
    {
        [Required]
        public string Password { get; set; } = "";
    }
}
