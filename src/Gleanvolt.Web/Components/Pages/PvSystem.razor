@page "/pv-system"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PvSystemInfo Site
@inject EvInfo Car
@inject ChargingLimits Limits
@inject MqttDisplayOptions Mqtt
@inject ApiDisplayOptions Api
@inject NavigationManager Nav

@*
    The installation, as configured (issue #111). Read-only on purpose and not merely for now: every
    value here is resolved once at startup — the Modbus clients are constructed from it, and the
    resolver has already refused anything that could not be used — so a control that edited it would
    be editing a copy of a decision that has already been made. Changing any of it means editing the
    configuration and restarting, and the page says so rather than leaving someone hunting for a
    Save button.

    What it is for: answering "which system is this, and what is it talking to?" from a browser, the
    question the startup log answers once and then buries.
*@

<SiteTitle Page="PV system" />

<h1>PV system</h1>

<p class="muted">
    Read from the configuration at startup. Changing any of it means editing <code>.env</code> or
    <code>appsettings.json</code> and restarting the controller.
</p>

<h2>Identity</h2>

<dl class="facts">
    <dt>Name</dt>
    <dd>@Text(Site.Name)</dd>

    <dt>Id</dt>
    <dd>@Text(Site.Id)</dd>

    <dt>Address</dt>
    <dd>@Text(Site.Address)</dd>
</dl>

@if (string.IsNullOrWhiteSpace(Site.Id))
{
    <p class="table-note muted">
        This system has no id yet. It is optional today; it becomes the name the controller publishes
        under, so that two installations can share one MQTT broker. Set <code>Pv__Id</code> and
        <code>Pv__Name</code> to claim one.
    </p>
}

<h2>Location and orientation</h2>

<dl class="facts">
    <dt>Coordinates</dt>
    <dd>
        @if (Site.HasLocation)
        {
            @($"{Site.Latitude!.Value.ToString("0.####", Invariant)}, {Site.Longitude!.Value.ToString("0.####", Invariant)}")
        }
        else
        {
            <span class="muted">—</span>
        }
    </dd>

    <dt>Azimuth</dt>
    <dd>@Azimuth()</dd>

    <dt>Tilt</dt>
    <dd>@Degrees(Site.TiltDegrees)</dd>
</dl>

@if (!Site.HasLocation)
{
    <p class="table-note muted">
        Without coordinates no weather is recorded against a charging session — the feature is off
        rather than wrong. Set <code>Pv__Latitude</code> and <code>Pv__Longitude</code>.
    </p>
}

<h2>Array</h2>

<dl class="facts">
    <dt>Peak DC capacity</dt>
    <dd>@Number(Site.CapacityKwp, "kWp")</dd>

    <dt>Inverter capacity</dt>
    <dd>@Number(Site.InverterCapacityKw, "kW")</dd>

    <dt>Loss factor</dt>
    <dd>@Number(Site.LossFactor, format: "0.00")</dd>

    <dt>Commissioned</dt>
    <dd>@(Site.InstallDate is { } date ? date.ToString("yyyy-MM-dd") : Missing)</dd>
</dl>

<h2>Devices</h2>

<table class="sessions">
    <thead>
        <tr>
            <th>Role</th>
            <th>Name</th>
            <th>Model</th>
            <th>Address</th>
            <th>Unit</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Inverter</td>
            <td>@Text(Site.Inverter.Name)</td>
            <td>@Text(Site.Inverter.Model)</td>
            <td>@Address(Site.Inverter)</td>
            <td>@Site.Inverter.Connection.UnitId</td>
        </tr>
        @foreach (var charger in Site.Chargers)
        {
            <tr>
                <td>Charger <span class="muted">@charger.Id</span></td>
                <td>@Text(charger.Name)</td>
                <td>@Text(charger.Model)</td>
                <td>@Address(charger)</td>
                <td>@charger.Connection.UnitId</td>
            </tr>
        }
    </tbody>
</table>

<p class="table-note muted">
    A model is what the box is, not what the controller speaks: the register maps are compiled for the
    devices in the README's hardware targets and are chosen by nothing here. One charger is supported;
    the configuration is a list so that it need not change shape the day a second one can be driven.
</p>

<h2>The car</h2>

@if (!Car.IsConfigured)
{
    <p class="muted" id="no-vehicle">
        No car is described, so every charging limit is the installation's own and no target can be
        asked for as a state of charge. Describe one under <code>Ev:Vehicles:0</code> to say what its
        pack holds and what currents it will actually accept.
    </p>
}
else
{
    <dl class="facts">
        <dt>Name</dt>
        <dd>@Text(Car.Name)</dd>

        <dt>Id</dt>
        <dd>@Text(Car.Id)</dd>

        <dt>Model</dt>
        <dd>@Text(string.Join(" ", new[] { Car.Make, Car.Model }.Where(part => !string.IsNullOrWhiteSpace(part))))</dd>

        <dt>Usable battery</dt>
        <dd>@(Car.CanTargetSoc ? $"{Car.BatteryCapacityKWh.ToString("0.#", Invariant)} kWh" : Missing)</dd>

        <dt>Charge efficiency</dt>
        <dd>@Car.ChargeEfficiency.ToString("P0", Invariant)</dd>
    </dl>

    <h3>What it will accept</h3>

    @*
        Three columns rather than one, because the interesting number is the third: what the car says,
        what the installation says, and which of them the controller is actually working to. A page
        that showed only the car's figures would leave somebody wondering why a 32 A car charges at 16.
    *@
    <table class="grid">
        <thead>
            <tr><th>&nbsp;</th><th>The car</th><th>The installation</th><th>In effect</th></tr>
        </thead>
        <tbody>
            <tr>
                <td>Minimum current</td>
                <td>@Amps(Car.MinChargingCurrentAmps)</td>
                <td>@Amps(Limits.MinAmps == Car.MinChargingCurrentAmps ? null : Limits.MinAmps)</td>
                <td>@Amps(Limits.MinAmps)</td>
            </tr>
            <tr>
                <td>Maximum current</td>
                <td>@Amps(Car.MaxChargingCurrentAmps)</td>
                <td>@Amps(Limits.MaxAmps == Car.MaxChargingCurrentAmps ? null : Limits.MaxAmps)</td>
                <td>@Amps(Limits.MaxAmps)</td>
            </tr>
            <tr>
                <td>Phases</td>
                <td>@Count(Car.Phases)</td>
                <td>@Count(Limits.Phases == Car.Phases ? null : Limits.Phases)</td>
                <td>@Count(Limits.Phases)</td>
            </tr>
        </tbody>
    </table>

    <p class="table-note muted">
        The controller works to the narrower of the two. A car can only ever <em>lower</em> a limit —
        the installation's maximum is the site's supply and the wiring in the wall, not a preference —
        and anything the car leaves unstated is simply the installation's figure. Phases matter more
        than they look: every power figure the controller reasons with, including when a deferred fast
        charge has to start, is computed from the count in the last column.
    </p>
}

<h2>MQTT</h2>

@*
    The third and fourth things this controller is talking to (issue #143). The Devices table above is
    what it drives; this is what it talks through, and unlike a Modbus address none of it is guessable:
    the prefix everything is published under is composed at startup from two separate settings.

    Two links rather than one broker, kept apart on purpose. They are separately optional -- you can
    publish to Home Assistant without reading the car, or the reverse -- and they may well be two
    different brokers, so a single row saying "the broker" would be wrong on any installation that
    took that up.
*@

<p class="muted">
    Home Assistant is a <em>control</em> surface: the topics ending <code>/set</code> can start and
    stop charging. Vehicle telemetry only listens, and the worst a wrong setting there can do is leave
    the car's card empty.
</p>

<h3>Home Assistant</h3>

@if (!Mqtt.HomeAssistant.Connection.Enabled)
{
    <p class="muted" id="ha-mqtt-off">
        Off, which is the default: nothing is published and no command is accepted. Set
        <code>HomeAssistant__Enabled</code> to <code>true</code>, give it
        <code>HomeAssistant__Username</code> and <code>HomeAssistant__Password</code> for the broker,
        and claim a <code>Pv__Id</code> — the id is the topic segment two installations on one broker
        would otherwise overwrite each other on, so the controller refuses to start without it.
    </p>
}
else
{
    <dl class="facts">
        <MqttConnection Connection="Mqtt.HomeAssistant.Connection" />

        <dt>Discovery prefix</dt>
        <dd><code>@Mqtt.HomeAssistant.DiscoveryPrefix</code></dd>

        <dt>Device id</dt>
        <dd><code>@Mqtt.HomeAssistant.DeviceId</code></dd>

        <dt>Topic prefix</dt>
        <dd><code>@Mqtt.HomeAssistant.TopicPrefix</code></dd>

        <dt>Status interval</dt>
        <dd>@Interval(Mqtt.HomeAssistant.StatusInterval)</dd>
    </dl>

    <p class="table-note muted">
        The device id is the root of every entity's <code>unique_id</code>, and it is the one value
        here that is expensive to change: Home Assistant keys an entity to its <code>unique_id</code>,
        so a new one is a new entity, created beside the old one, and every graph starts again. The
        topics and the names can be changed freely. The status interval is how often the state topic
        is republished, which is usually the answer to "why is the dashboard behind?".
    </p>

    <table class="sessions topics">
        <thead>
            <tr>
                <th>Carries</th>
                <th>Topic</th>
                <th>Direction</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var topic in Mqtt.HomeAssistant.Topics)
            {
                <tr>
                    <td>@topic.Purpose</td>
                    <td class="topic"><code>@topic.Topic</code></td>
                    <td class="flow">@(topic.Inbound ? "in" : "out")</td>
                </tr>
            }
        </tbody>
    </table>

    <p class="table-note muted">
        Every other entity — each number, select, text and button — follows the same pattern:
        <code>@($"{Mqtt.HomeAssistant.TopicPrefix}/{{object_id}}/state")</code> for what it reports and
        <code>@($"{Mqtt.HomeAssistant.TopicPrefix}/{{object_id}}/set")</code> for what it accepts. The
        retained discovery configs Home Assistant reads them from live under
        <code>@($"{Mqtt.HomeAssistant.DiscoveryPrefix}/…/{Mqtt.HomeAssistant.DeviceId}/…/config")</code>.
        Anything marked <em>in</em> can change what the charger is doing.
    </p>

    @if (Mqtt.HomeAssistant.IsRetiringAnything)
    {
        <p class="table-note muted" id="ha-mqtt-retiring">
            On every connect this installation also <strong>blanks</strong> the retained messages left
            by a name it used to publish under:
            @if (Mqtt.HomeAssistant.RetiredDeviceIds.Count > 0)
            {
                <text>discovery configs for
                    @string.Join(", ", Mqtt.HomeAssistant.RetiredDeviceIds)</text>
                @(Mqtt.HomeAssistant.RetiredTopicPrefixes.Count > 0 ? "; " : ". ")
            }
            @if (Mqtt.HomeAssistant.RetiredTopicPrefixes.Count > 0)
            {
                <text>retained state under
                    @string.Join(", ", Mqtt.HomeAssistant.RetiredTopicPrefixes). </text>
            }
            Set after a rename, and safe to remove once it has run.
        </p>
    }
}

<h3>Vehicle telemetry</h3>

@if (!Mqtt.Vehicle.Connection.Enabled)
{
    <p class="muted" id="vehicle-mqtt-off">
        Off, which is the default: the car's own state of charge is not read, and the dashboard shows
        only what the charger can see. Set <code>Vehicle__Enabled</code> to <code>true</code> and name
        the topic your publisher writes to under
        <code>Ev__Vehicles__0__Telemetry__Topic</code>.
    </p>
}
else
{
    <dl class="facts">
        <MqttConnection Connection="Mqtt.Vehicle.Connection" />

        <dt>Subscribed to</dt>
        <dd>
            @if (Mqtt.Vehicle.IsEnabledWithoutTopic)
            {
                <span class="muted">nothing</span>
            }
            else
            {
                <code>@Mqtt.Vehicle.Topic</code>
            }
        </dd>

        <dt>Stale after</dt>
        <dd>@Interval(Mqtt.Vehicle.MaxAge)</dd>

        <dt>Retry every</dt>
        <dd>@Interval(Mqtt.Vehicle.ReconnectInterval)</dd>
    </dl>

    @if (Mqtt.Vehicle.IsEnabledWithoutTopic)
    {
        <p class="table-note muted" id="vehicle-mqtt-no-topic">
            The feed is on with nothing to subscribe to, so it connects to no broker and reads nothing
            — which from the dashboard is indistinguishable from a car that never reports. Set
            <code>Ev__Vehicles__0__Telemetry__Topic</code> to the topic your publisher writes to.
        </p>
    }

    <p class="table-note muted">
        One concrete topic, not a wildcard: this phase tracks one car, and a <code>+</code> across
        several would quietly let the newest message win whichever car it described. The messages are
        expected to be <strong>retained</strong>, so a restart is handed the last reading straight
        away instead of waiting for a cloud-fed car's next update. Note that this client id is not
        namespaced by the system's id, so two controllers on one machine would collide on the broker.
    </p>

    @if (Mqtt.SharesOneBroker)
    {
        <p class="table-note muted" id="mqtt-one-broker">
            Both links use the same broker, <code>@Mqtt.Vehicle.Connection.Broker</code>. They are still
            two connections with two client ids, and either can be pointed elsewhere without touching
            the other.
        </p>
    }
}

<p class="table-note muted">
    None of this says whether either link is <em>up</em>. Everything on this page was read once at
    startup; <a href="/health">Health</a> reports the polling loop rather than the broker, so until it
    reports this too, the broker's own log — or Home Assistant showing the device as unavailable — is
    what answers that.
</p>

<h2>API</h2>

@*
    The third control surface (issue #142), and the one whose whole configuration lives in a file on
    the Pi. Turning it on is a line in .env and a key from `openssl rand -hex 32`; after that the only
    confirmation it worked is a line in the startup log, and the only place the key exists is that
    file. Anyone pointing an MCP server, a script or a dashboard at this installation needs exactly two
    things -- the base URL and a key -- and used to get them by ssh'ing to the Pi and grepping .env.

    Read-only for the same reason as everything above: ApiOptions is bound once at startup, the
    keyless-API check has already refused what could not be honoured, and the routes are mapped -- or
    not mapped -- from it. A control that generated a key here would be editing a copy of a settled
    decision.
*@

@if (!Api.Enabled)
{
    <p class="muted" id="api-off">
        Off, which is the default: no route is mapped and no document is served, so there is nothing to
        find rather than something that answers 401. Two of its endpoints write to hardware, which is
        why it is switched on knowingly — with <code>Api__Enabled=true</code> and at least one key,
        <code>Api__Keys__&lt;name&gt;=$(openssl rand -hex 32)</code>. Enabled with no key is a startup
        failure rather than an open control surface.
    </p>
}
else
{
    <dl class="facts">
        <dt>Base URL</dt>
        <dd>
            <code>@_api.BaseUrl</code>
            @if (_api.PortIsImplicit)
            {
                <span class="muted">
                    — this page arrived on the default port, so the direct LAN address is
                    <code>host:@Api.Port</code> whatever is in front of it.
                </span>
            }
        </dd>

        <dt>Index</dt>
        <dd><a href="@_api.BaseUrl">@Api.BasePath</a></dd>

        <dt>OpenAPI document</dt>
        <dd><a href="@_api.DocumentUrl">@Api.DocumentPath</a></dd>
    </dl>

    <p class="table-note muted">
        The address is built from the one this page arrived on rather than from <code>Web:Port</code>:
        a hostname or a reverse proxy in front means the configured port is not necessarily the one
        that works, while the address that just delivered this page demonstrably does. Both links
        answer without a key by design — a browser cannot send one, and neither carries anything to act
        on — so opening either is the quickest proof that the API is up.
    </p>

    <h3>Keys</h3>

    <table class="sessions">
        <thead>
            <tr>
                <th>Name</th>
                <th>Key</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var key in Api.Keys)
            {
                <tr>
                    <td><code>@key.Name</code></td>
                    <td>
                        @if (key.Secret is { } secret)
                        {
                            <Secret Value="@secret" />
                        }
                        else
                        {
                            <span class="muted">configured</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="table-note muted">
        The name is not a credential — it is what reaches the log and the recorded charging session as
        the source of an action, so a charge started through this API is filed against the name that
        started it rather than anonymously. Which is the whole reason several clients get several keys.
    </p>

    @if (Api.SecretsWithheld)
    {
        <p class="table-note muted" id="api-keys-withheld">
            The keys themselves are not shown, because this UI has no login: anyone who can reach it
            could read them, and a key is bearer-equivalent to the stop button on the wallbox.
            Configure <code>Web__PasswordHash</code> (<code>hash-password</code>) and they become
            readable here.
        </p>
    }

    <h3>Calling it</h3>

    <p class="code-line">
        @if (Api.Keys[0].Secret is { } example)
        {
            <Secret Value="@example" Before="@CurlPrefix" After="@CurlSuffix" />
        }
        else
        {
            <code>@CurlPrefix&lt;key&gt;@CurlSuffix</code>
        }
    </p>

    <p class="table-note muted">
        The first key, this installation's own address and the endpoint worth trying first. Everything
        else is under the same base URL and takes the same header; the document above is the list.
    </p>
}

@code {
    private const string Missing = "—";

    // The example call the section exists to serve, split around the key so the secret can be masked
    // inside it while Copy still hands over the whole command.
    private const string CurlPrefix = "curl -H \"Authorization: Bearer ";

    private string CurlSuffix => $"\" {_api.BaseUrl}/status";

    // Where the API is, as seen from the browser that fetched this page -- resolved once, since the
    // address cannot change under a rendered page.
    private ApiAddressDisplay _api = new(string.Empty, string.Empty, PortIsImplicit: true);

    protected override void OnInitialized() => _api = Api.AddressFrom(Nav.BaseUri);

    private static readonly System.Globalization.CultureInfo Invariant =
        System.Globalization.CultureInfo.InvariantCulture;

    // The eight points are enough to catch the mistake this is here to catch -- an array described as
    // facing north when it faces south -- and more would suggest a precision the bearing does not have.
    private static readonly string[] Compass =
        ["north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west"];

    private static string Text(string value) => string.IsNullOrWhiteSpace(value) ? Missing : value;

    private static string Amps(int? value) => value is { } amps ? $"{amps} A" : Missing;

    private static string Count(int? value) => value is { } number ? number.ToString(Invariant) : Missing;

    private static string Address(PvDeviceInfo device) => $"{device.Connection.Host}:{device.Connection.Port}";

    // Intervals here run from fifteen seconds to twelve hours, so a single format would print either
    // "0h 0m" for the status interval or "12h 0m" for the staleness guard. Each is shown in the unit
    // it was configured in.
    private static string Interval(TimeSpan value)
    {
        if (value <= TimeSpan.Zero)
        {
            return Missing;
        }

        if (value < TimeSpan.FromMinutes(1))
        {
            return $"{value.TotalSeconds.ToString("0.#", Invariant)} s";
        }

        if (value < TimeSpan.FromHours(1))
        {
            return $"{value.TotalMinutes.ToString("0.#", Invariant)} min";
        }

        return value.Minutes == 0
            ? $"{(int)value.TotalHours} h"
            : $"{(int)value.TotalHours} h {value.Minutes} min";
    }

    private static string Degrees(double? value) =>
        value is { } number ? $"{number.ToString("0.#", Invariant)}°" : Missing;

    private static string Number(double? value, string? unit = null, string format = "0.##")
    {
        if (value is not { } number)
        {
            return Missing;
        }

        var text = number.ToString(format, Invariant);
        return unit is null ? text : $"{text} {unit}";
    }

    // The bearing with the direction it means spelled out, because "172°" is only checkable by
    // someone who already knows which way their roof faces in degrees.
    private string Azimuth()
    {
        if (Site.AzimuthDegrees is not { } bearing)
        {
            return Missing;
        }

        var point = Compass[(int)Math.Round(bearing / 45) % Compass.Length];
        return $"{Degrees(bearing)} ({point})";
    }
}
