@implements IAsyncDisposable
@inject IForecastRuntimeSettings ForecastSettings
@inject TimeProvider Time
@inject IJSRuntime JS

@*
    The forecast-driven mode, and the only one with a day plan behind it -- so this tab carries both
    the two runtime numbers the mode reads and the plan it publishes while it drives. They used to
    live a nav item apart, on the dashboard and on /forecast, which meant reading the outcome on one
    page and adjusting the input on another.

    The plan half is the old /forecast page: the figures with their meanings inline, and the timeline
    chart (vendored uPlot, #44) drawn from SolarDayPlanner's own timeline, so the picture cannot
    disagree with the numbers beside it. Populated only while Forecasted is the active mode --
    status.Plan is null otherwise -- so a different mode driving the charger shows an explicit empty
    state here rather than the last stale plan.

    The numbers are written through IForecastRuntimeSettings, the seam the MQTT worker's number
    entities write, and re-read whenever a new status lands: Home Assistant or a second browser can
    move any of them, and this tab shows what the controller is actually using.

    Both protect the home battery; none is an amount for the car. The daily EV target was a yardstick
    wearing a request's clothes, which taught owners this mode takes requests, and went in #217. The
    session energy target followed in #249: a stop on the car is the car's own charge limit, and an
    amount by a time is Targeted. The headline above the plan is a forecast of what the day gives,
    not a verdict on whether it is enough, because only Targeted is entitled to the second sentence.
*@

<div class="muted intro-line">
    @PlanText.ForecastedIntro
    <InfoTip Topic="@PlanText.ThisModeTopic">
        <p>
            @Localized.Rich(PlanText.ForecastedTip, @<a href="/charging-plan/solar">@PlanText.ForecastedTip_0</a>)
        </p>
    </InfoTip>
</div>

<div class="control">
    <button type="button" class="primary" id="start-forecasted" disabled="@Busy" @onclick="StartForecasted">
        @PlanText.StartForecasted
    </button>
    <InfoTip Topic="@PlanText.StartForecastedTopic">
        <p>
            @PlanText.StartForecastedTip
        </p>
    </InfoTip>
</div>

<UntilFullOption Status="Status" />

<section class="plan" id="ev-energy">
    <div class="plan-head">
        <h2>@PlanText.WhereChargeStops</h2>
        <InfoTip Topic="@PlanText.WhereChargeStopsTopic">
            <p>
                @Localized.Rich(PlanText.WhereChargeStopsTip, @<em>@PlanText.WhereChargeStopsTip_0</em>, @<a href="/charging-plan/targeted">@PlanText.WhereChargeStopsTip_1</a>)
            </p>
        </InfoTip>
    </div>

    <p class="hint">@SessionProgress()</p>
</section>

<section class="plan" id="battery-floor">
    <h2>@PlanText.BatteryKeeps</h2>

    <div class="control">
        <div class="control-head">
            <label for="min-battery-soc">@PlanText.MinBatterySoc</label>
            <InfoTip Topic="@PlanText.MinBatterySocTopic">
                <p>
                    @PlanText.MinBatterySocTip
                </p>
            </InfoTip>
        </div>
        <input id="min-battery-soc" type="number" step="1" min="0" max="100"
               @bind="_minBatterySocPercent" @bind:event="onchange" @bind:after="OnMinBatterySocSelected" />
    </div>

    <div class="control">
        <div class="control-head">
            <label for="resume-margin">@PlanText.ResumeMargin</label>
            <InfoTip Topic="@PlanText.ResumeMarginTopic">
                <p>
                    @PlanText.ResumeMarginTip
                </p>
            </InfoTip>
        </div>
        <input id="resume-margin" type="number" step="1" min="0" max="50"
               @bind="_resumeMarginPercent" @bind:event="onchange" @bind:after="OnResumeMarginSelected" />
    </div>
</section>

@if (Status is null)
{
    <p class="muted">@PlanText.NoPollYet</p>
}
else if (Status.Plan is not { } plan)
{
    <p class="muted">
        @Localized.Rich(PlanText.PlanOnlyWhileForecasted, @<strong>@SharedText.ModeForecasted</strong>, @<text>@ChargeModeTabs.Label(Status.Mode)</text>)
    </p>
}
else
{
    <h2>@PlanText.ThePlan</h2>

    <p><strong>@SolarDayPlanNarrative.Headline(plan, Time.LocalTimeZone)</strong></p>

    <p class="muted">
        @Localized.Format(PlanText.Updated, TimeZoneInfo.ConvertTime(Status.Timestamp, Time.LocalTimeZone).ToString("HH:mm:ss"))
    </p>

    <section class="stat-grid">
        <Stat Label="@PlanText.PlanState" Value="@Localized.Say(plan.ReasonPhrase, plan.Reason, Time.LocalTimeZone)"
              Hint="@PlanText.PlanStateHint" />
        <Stat Label="@PlanText.ChargeWindow" Value="@FormatWindow(plan.NextFeasibleWindow)"
              Hint="@PlanText.ChargeWindowHint" />
        <Stat Label="@PlanText.EvBudget" Value="@Units.Energy(plan.FeasibleEvEnergyWh)"
              Hint="@PlanText.EvBudgetHint" />
        <Stat Label="@PlanText.ProjectedShortfall" Value="@Units.Energy(plan.ShortfallWh)"
              Hint="@PlanText.ProjectedShortfallHint" />
        <Stat Label="@PlanText.SurplusSpill" Value="@Units.Energy(plan.SpillWh)"
              Hint="@PlanText.SurplusSpillHint" />
        <Stat Label="@PlanText.LoanHeadroom" Value="@Units.Energy(plan.LoanHeadroomWh)"
              Hint="@PlanText.LoanHeadroomHint" />
        <Stat Label="@PlanText.RequiredFloor" Value="@Units.Percent(plan.RequiredSocFloorPercent)"
              Hint="@PlanText.RequiredFloorHint" />
        <Stat Label="@PlanText.ForecastRemaining" Value="@Units.Energy(plan.RemainingPvWh)"
              Hint="@PlanText.ForecastRemainingHint" />
        <Stat Label="@PlanText.TomorrowForecast" Value="@Units.Energy(Status.TomorrowForecastWh)"
              Hint="@PlanText.TomorrowForecastHint" />
        <Stat Label="@PlanText.ForecastAccuracy" Value="@Units.Fraction(plan.BiasFactor)"
              Hint="@PlanText.ForecastAccuracyHint" />
        <Stat Label="@PlanText.LoanedToday" Value="@Units.Energy(Status.LoanedTodayWh)"
              Hint="@PlanText.LoanedTodayHint" />
    </section>

    <section class="chart-section">
        <h2>@PlanText.ChartTitle</h2>
        @if (plan.Timeline.Count == 0)
        {
            <p class="muted">@PlanText.NoForecastData</p>
        }
        else
        {
            <div id="plan-chart" class="chart"></div>
        }
    </section>
}

@code {
    [Parameter] public ChargeControlStatus? Status { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter, EditorRequired] public Func<ChargeControlMode, Task<ChargeActionResult>> Start { get; set; } = default!;

    private double _minBatterySocPercent;
    private double _resumeMarginPercent;

    private bool _chartRendered;

    // Deliberately not _chartRendered: that one is reset on every status update to force a redraw,
    // so it cannot answer the question DisposeAsync actually has -- "is there a uPlot instance in
    // the JS map to tear down?". Once true it stays true, and while it is false there is nothing to
    // dispose *and* no interop is permitted: during the static prerender pass OnAfterRenderAsync
    // never runs, and a JS call from disposal there throws InvalidOperationException.
    private bool _chartCreated;

    // Which status the numbers and the chart were last built from. Parameters are set on every render
    // of the page above, including the two a button press causes; only a genuinely new poll should
    // redraw the chart or overwrite a number the owner may be halfway through typing.
    private ChargeControlStatus? _seenStatus;

    protected override void OnInitialized() => RefreshRuntimeNumbers();

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_seenStatus, Status))
        {
            return;
        }

        _seenStatus = Status;

        // The values the controller is actually using, in case Home Assistant (or another browser)
        // changed one since this tab opened -- the same reason the MQTT worker republishes them on
        // every status cycle.
        RefreshRuntimeNumbers();

        // The plan is recomputed every poll, so the chart is redrawn every poll too -- recreated
        // rather than patched via setData: staying current costs a brief redraw instead of a second
        // code path.
        _chartRendered = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartRendered || Status?.Plan is not { Timeline.Count: > 0 } plan)
        {
            return;
        }

        _chartRendered = true;

        var timestamps = plan.Timeline.Select(p => p.Start.ToUnixTimeSeconds()).ToArray();
        var surplus = plan.Timeline.Select(p => p.SurplusWatts).ToArray();
        var floor = plan.Timeline.Select(p => p.RequiredSocFloorPercent).ToArray();
        var windowStart = plan.NextFeasibleWindow?.Start.ToUnixTimeSeconds();
        var windowEnd = plan.NextFeasibleWindow?.End.ToUnixTimeSeconds();

        // Set before the call, not after: if the interop is cut off mid-flight the chart may already
        // exist on the other side, and disposing one that isn't there is a no-op anyway.
        _chartCreated = true;

        await JS.InvokeVoidAsync(
            "solaxCharts.renderTimelineChart", "plan-chart", timestamps, surplus, floor, windowStart, windowEnd, null, null, ChartText.Current());
    }

    // Runs when the owner switches tabs as well as when the page is left: the chart belongs to this
    // component, so it goes when this component does.
    public async ValueTask DisposeAsync()
    {
        if (!_chartCreated)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("solaxCharts.dispose", "plan-chart");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone (e.g. the browser tab closed) -- nothing left to clean up.
        }
    }

    private Task StartForecasted() => Start(ChargeControlMode.Forecasted);

    private void OnMinBatterySocSelected() =>
        ForecastSettings.SetMinBatterySocFloorPercent(_minBatterySocPercent, "Web UI");

    private void OnResumeMarginSelected() =>
        ForecastSettings.SetFloorResumeMarginPercent(_resumeMarginPercent, "Web UI");

    private void RefreshRuntimeNumbers()
    {
        _minBatterySocPercent = ForecastSettings.MinBatterySocFloorPercent;
        _resumeMarginPercent = ForecastSettings.FloorResumeMarginPercent;
    }

    private string SessionProgress() =>
        Status is null
            ? PlanText.NoPollYet
            : Localized.Format(PlanText.IntoCarSincePlugged, Units.Energy(Status.SessionEnergyWh));

    private string FormatWindow((DateTimeOffset Start, DateTimeOffset End)? window) =>
        window is { } w
            ? $"{TimeZoneInfo.ConvertTime(w.Start, Time.LocalTimeZone):HH:mm}–{TimeZoneInfo.ConvertTime(w.End, Time.LocalTimeZone):HH:mm}"
            : PlanText.NoWindow;
}
