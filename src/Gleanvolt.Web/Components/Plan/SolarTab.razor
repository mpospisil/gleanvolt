@*
    The everyday mode, and the one with nothing to configure: it reads the smoothed surplus and sets
    the current the sun can cover, once the home battery is full. Everything it decides on is already
    a live figure, so the tab is a button and the three numbers that say whether pressing it would
    achieve anything right now.
*@

<div class="muted intro-line">
    @PlanText.SolarIntro
    <InfoTip Topic="@PlanText.ThisModeTopic">
        <p>
            @PlanText.SolarTip
        </p>
    </InfoTip>
</div>

<div class="control">
    <button type="button" class="primary" id="start-solar" disabled="@Busy" @onclick="StartSolar">
        @PlanText.StartSolar
    </button>
    <InfoTip Topic="@PlanText.StartSolarTopic">
        <p>
            @PlanText.StartSolarTip
        </p>
    </InfoTip>
</div>

@if (Status is { } status)
{
    <section class="stat-grid">
        <Stat Label="@PlanText.SolarSurplus" Value="@Units.Power(status.SurplusWatts)"
              Hint="@PlanText.SolarSurplusHint" />
        <Stat Label="@PlanText.BatterySoc" Value="@Units.Percent(status.BatterySocPercent)"
              Hint="@PlanText.BatterySocGateHint" />
        <Stat Label="@PlanText.EvPower" Value="@Units.Power(status.EvChargerPowerWatts)"
              Hint="@PlanText.EvPowerHint" />
        <Stat Label="@PlanText.TargetCurrent" Value="@Units.Current(status.TargetCurrentAmps)" End="true"
              Hint="@PlanText.TargetCurrentHint" />
    </section>
}

@code {
    [Parameter] public ChargeControlStatus? Status { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter, EditorRequired] public Func<ChargeControlMode, Task<ChargeActionResult>> Start { get; set; } = default!;

    private Task StartSolar() => Start(ChargeControlMode.Solar);
}
