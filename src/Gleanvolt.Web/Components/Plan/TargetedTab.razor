@using Gleanvolt.Core.Strategies
@implements IDisposable
@inject ITargetedChargeSelector Target
@inject ITargetedChargePreview Preview
@inject IVehicleTelemetry Vehicle
@inject VehicleDisplayOptions VehicleDisplay
@inject IForecastRuntimeSettings ForecastSettings
@inject TargetedDisplayOptions Display
@inject TimeProvider Time
@inject IJSRuntime JS

@*
    The old /targeted page, the fourth tab since #98, and since #99 a tab that asks the car before it
    asks the owner.

    Three things happen here, in this order, because that is the order the decision is made in:

      1. What the car says about itself, when there is a feed and a reading. SOC and range are the
         numbers the plan is about to be built from, so they belong above the form rather than a nav
         item away on the dashboard.
      2. What the owner wants, said either way round -- kilowatt-hours to add (the original contract,
         the default, and the only basis an install with no vehicle feed ever sees) or a state of
         charge to reach, which VehicleTargetEnergy converts once, here, at activation.
      3. The plan, before the charger moves. Preview builds it through ITargetedChargePreview, which
         writes to nothing; Start then does what Activate always did -- request first, then the mode,
         because the controller reads both in the same cycle.

    Text, not a chart: the question at 22:00 is "is the car going to be ready, and why is nothing
    happening yet?", and no chart answers that as directly as a sentence.

    Subscribes to the request itself, because it can move without this tab's help -- Home Assistant
    sets one too, and the mode clears itself once the target is met.
*@

<div class="muted intro-line">
    @PlanText.TargetedIntro
    <InfoTip Topic="@PlanText.ThisModeTopic">
        <p>
            @PlanText.TargetedTip
        </p>
    </InfoTip>
</div>

@if (_vehicle is not null)
{
    @*
        Only with a feed and a reading. An install with Vehicle:Enabled=false sees the form it has
        always seen, which is the whole "default behaviour is unchanged" promise -- and an empty card
        would be a worse answer than no card.
    *@
    <section class="plan" id="vehicle-card">
        <h2>@PlanText.TheCar</h2>

        <p class="muted">
            @(_vehicle.SourceId is null
                ? Localized.Format(PlanText.ReportedByCar, VehicleAge(_vehicle))
                : Localized.Format(PlanText.ReportedByCarVia, VehicleAge(_vehicle), _vehicle.SourceId))
            @if (_vehicleStale)
            {
                <strong>
                    @Localized.Format(PlanText.StaleCheck, Units.Hours(VehicleDisplay.MaxAge))
                </strong>
            }
        </p>

        <section class="stat-grid">
            <Stat Label="@PlanText.CarBattery" Value="@Units.Percent(_vehicle.SocPercent)"
                  Hint="@PlanText.CarBatteryHint" />
            <Stat Label="@PlanText.Range" Value="@Units.Distance(_vehicle.RangeMetres)"
                  Hint="@PlanText.RangeHint" />
            <Stat Label="@PlanText.PluggedIn" Value="@PluggedIn()"
                  Hint="@PlanText.PluggedInHint" />
            <Stat Label="@PlanText.CarChargeState" Value="@Localized.Name(_vehicle.ChargeState)" End="true"
                  Hint="@PlanText.CarChargeStateHint" />
        </section>
    </section>
}

@*
    The basis selector appears only when it can be honoured: a capacity in Vehicle:BatteryCapacityKWh
    and an SOC in the last reading. Without both there is no honest conversion from "80%" to
    kilowatt-hours, and offering a control that would have to guess is worse than not offering it.
*@
@if (CanTargetSoc)
{
    @* A segmented control on native radios (#255): two answers to one question, both visible. *@
    <div class="control">
        <div class="control-head">
            <span class="control-label" id="target-basis-label">@PlanText.AimingAt</span>
            <InfoTip Topic="@PlanText.AimingAtTopic">
                <p>
                    @PlanText.AimingAtTip
                </p>
            </InfoTip>
        </div>
        <div class="seg" role="radiogroup" id="target-basis" aria-labelledby="target-basis-label">
            <label class="seg-opt">
                <input type="radio" name="target-basis" id="target-basis-energy"
                       checked="@(_basis == TargetBasis.Energy)" @onchange="() => SetBasis(TargetBasis.Energy)" />
                @PlanText.EnergyToAdd
            </label>
            <label class="seg-opt">
                <input type="radio" name="target-basis" id="target-basis-soc"
                       checked="@(_basis == TargetBasis.Soc)" @onchange="() => SetBasis(TargetBasis.Soc)" />
                @PlanText.BatteryTarget
            </label>
        </div>
    </div>
}

@if (_basis == TargetBasis.Soc && CanTargetSoc)
{
    <div class="control">
        <label for="target-soc">@PlanText.ChargeTo</label>
        <input id="target-soc" type="number" step="5" min="0" max="100"
               @bind="_targetSocPercent" @bind:event="onchange" @bind:after="OnFormEdited" />
        <span class="hint">@SocConversionHint()</span>
    </div>
}
else
{
    <div class="control">
        <div class="control-head">
            <label for="target-energy">@PlanText.EnergyNeeded</label>
            <InfoTip Topic="@PlanText.EnergyNeededTopic">
                <p>@PlanText.EnergyNeededStartTip</p>
            </InfoTip>
        </div>
        <input id="target-energy" type="number" step="0.5" min="0"
               @bind="_energyKWh" @bind:event="onchange" @bind:after="OnFormEdited" />
    </div>
}

@*
    The priority, and the rest SOC under it. Offered on the same terms as the basis selector above:
    the rest point is a state of charge, so without a capacity and a reading there is no honest way to
    know where 80% is, and a control that would have to guess is worse than no control.
*@
@if (CanTargetSoc)
{
    <div class="control">
        <div class="control-head">
            <span class="control-label" id="charge-priority-label">@PlanText.Pacing</span>
            <InfoTip Topic="@PlanText.PacingTopic">
                <p>
                    @Localized.Rich(PlanText.PacingTip, @<strong>@PlanText.PacingTip_0</strong>, @<strong>@PlanText.PacingTip_1</strong>)
                </p>
            </InfoTip>
        </div>
        <div class="seg" role="radiogroup" id="charge-priority" aria-labelledby="charge-priority-label">
            <label class="seg-opt">
                <input type="radio" name="charge-priority" id="charge-priority-cheapest"
                       checked="@(_priority == TargetedChargePriority.Cheapest)"
                       @onchange="() => SetPriority(TargetedChargePriority.Cheapest)" />
                @PlanText.Cheapest
            </label>
            <label class="seg-opt">
                <input type="radio" name="charge-priority" id="charge-priority-justintime"
                       checked="@(_priority == TargetedChargePriority.JustInTime)" disabled="@_sunOnly"
                       @onchange="() => SetPriority(TargetedChargePriority.JustInTime)" />
                @PlanText.JustInTime
            </label>
        </div>
    </div>
}

@*
    Sun only (#251): the one constraint the form offers, as MaxGridEnergyWh 0. Shown whether or not
    pacing is, since it needs no state of charge. A grid budget in kWh stays an API knob.
*@
<div class="control sun-only-option">
    <div class="control-head">
        <label>
            <input type="checkbox" id="sun-only" checked="@_sunOnly" @onchange="OnSunOnlyChanged" />
            @PlanText.SunOnly
        </label>
        <InfoTip Topic="@PlanText.SunOnlyTopic">
            <p>
                @PlanText.SunOnlyTip
            </p>
        </InfoTip>
    </div>
    @* Said out loud, not in the tip: it is why an option above is greyed out. *@
    @if (_sunOnly && CanTargetSoc)
    {
        <span class="hint">
            @PlanText.SunOnlyNoJustInTime
        </span>
    }
</div>

@if (_priority == TargetedChargePriority.JustInTime && CanTargetSoc)
{
    <div class="control">
        <div class="control-head">
            <label for="rest-soc">@PlanText.RestAt</label>
            <InfoTip Topic="@PlanText.RestAtTopic">
                <p>@RestHint()</p>
            </InfoTip>
        </div>
        <input id="rest-soc" type="number" step="5" min="0" max="100"
               @bind="_restSocPercent" @bind:event="onchange" @bind:after="OnFormEdited" />
    </div>
}

<div class="control">
    <div class="control-head">
        <label for="target-departure">@PlanText.ReadyBy</label>
        <InfoTip Topic="@PlanText.ReadyByTopic">
            <p>
                @Localized.Format(PlanText.ReadyByTargetTip, Units.Hours(Display.MaxHorizon))
            </p>
        </InfoTip>
    </div>
    <input id="target-departure" type="datetime-local"
           @bind="_departure" @bind:event="onchange" @bind:after="OnFormEdited" />
</div>

<div class="control">
    <div class="control-head">
        <label for="min-battery-soc">@PlanText.MinBatterySoc</label>
        <InfoTip Topic="@PlanText.MinBatterySocTopic">
            <p>
                @PlanText.MinBatterySocTargetedTip
            </p>
        </InfoTip>
    </div>
    <input id="min-battery-soc" type="number" step="1" min="0" max="100"
           @bind="_minBatterySocPercent" @bind:event="onchange" @bind:after="OnMinBatterySocSelected" />
</div>

<div class="control">
    <button type="button" class="primary" id="preview-target" disabled="@Busy" @onclick="BuildPreview">@PlanText.PreviewPlan</button>
    <button type="button" class="secondary" id="cancel-target" disabled="@Busy" @onclick="Cancel">@PlanText.Cancel</button>
    <InfoTip Topic="@PlanText.PreviewTopic">
        <p>
            @PlanText.PreviewTip
        </p>
    </InfoTip>

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }
</div>

@*
    The preview and the button that commits it, in that order and inside the same box: what you
    confirm should be the thing you have just read, not a button somewhere above it.

    A modal <dialog> since #255 (direction 1d): titled with the request itself, the plan in a sentence,
    where the energy comes from as a sun/grid bar, the pacing as a choice priced against the other one,
    then Back or Start. Every figure is still there, folded under the bar. Opened by dialog.js, since
    only the browser can make a dialog modal; Escape is routed to Back, so the two always agree.
*@
@if (_previewed)
{
    <dialog class="dialog targeted-dialog" id="target-preview" aria-labelledby="target-preview-title">
        <h2 id="target-preview-title">@(_previewRequest is { } titled ? Title(titled) : PlanText.IfYouStartNow)</h2>

        @if (_previewRequest is { } asked)
        {
            <p class="muted dialog-asking">@Asking(asked)</p>
        }

        @if (_preview is { } preview)
        {
            <TargetedPlanView Plan="preview" ShowFigures="false" />

            @if (preview.SolarEnergyWh + preview.GridEnergyWh > 0)
            {
                <div class="split" id="target-split">
                    <div class="split-bar" aria-hidden="true">
                        <span class="solar" style="width:@Share(preview.SolarEnergyWh, preview)"></span>
                        <span class="grid" style="width:@Share(preview.GridEnergyWh, preview)"></span>
                    </div>
                    <ul class="split-legend">
                        <li><span class="swatch solar"></span>@Localized.Format(PlanText.Sun, Units.Energy(preview.SolarEnergyWh))</li>
                        <li><span class="swatch grid"></span>@Localized.Format(PlanText.Grid, Units.Energy(preview.GridEnergyWh))</li>
                    </ul>
                </div>
            }

            @*
                The pacing, priced: the other choice's grid cost is the one thing the owner cannot see
                without trying it, so it is worked out up front and written on the option. Changing it
                here rebuilds the plan in place rather than closing the dialog.
            *@
            @if (CanTargetSoc)
            {
                <div class="dialog-pacing">
                    <span class="control-label" id="dialog-pacing-label">@PlanText.Pacing</span>
                    <div class="seg" role="radiogroup" id="dialog-pacing" aria-labelledby="dialog-pacing-label">
                        <label class="seg-opt">
                            <input type="radio" name="dialog-pacing" id="dialog-pacing-cheapest"
                                   checked="@(_priority == TargetedChargePriority.Cheapest)"
                                   @onchange="() => SetPriority(TargetedChargePriority.Cheapest)" />
                            @PlanText.Cheapest
                        </label>
                        <label class="seg-opt">
                            <input type="radio" name="dialog-pacing" id="dialog-pacing-justintime"
                                   checked="@(_priority == TargetedChargePriority.JustInTime)" disabled="@_sunOnly"
                                   @onchange="() => SetPriority(TargetedChargePriority.JustInTime)" />
                            @(JustInTimeExtraWh() is { } extra ? Localized.Format(PlanText.JustInTimeExtra, Units.Energy(extra, signed: true)) : PlanText.JustInTime)
                        </label>
                    </div>
                </div>
            }

            @*
                The cost of the choice, said before the button that commits it. A hold is worth making
                with the number in front of you, not discovered on next month's bill.
            *@
            @if (HoldCost() is { } cost)
            {
                <p class="muted" id="hold-cost">@cost</p>
            }

            <details class="dialog-figures">
                <summary>@PlanText.EveryFigure</summary>
                <TargetedPlanView Plan="preview" ShowNarrative="false" />
            </details>
        }
        else
        {
            <p class="muted">
                @PlanText.NoPollForPlan
            </p>
        }

        <div class="dialog-actions">
            <button type="button" class="btn" id="discard-preview" data-dialog-cancel disabled="@Busy" @onclick="DiscardPreview">@PlanText.BackToForm</button>
            <button type="button" class="btn btn-primary" id="activate-target" disabled="@Busy" @onclick="Activate">@PlanText.StartThisPlan</button>
        </div>
    </dialog>
}

@if (Status?.TargetedPlan is { } plan)
{
    <section class="plan">
        <h2>@PlanText.ThePlan</h2>

        @if (Target.Request is { } running && running.IsSocBased)
        {
            <p class="muted">@Asking(running)</p>
        }

        <TargetedPlanView Plan="plan" />
    </section>
}
else if (Status is null)
{
    <p class="muted">@PlanText.NoPollYet</p>
}
else
{
    <p class="muted">
        @Localized.Rich(PlanText.PlanOnlyWhileTargeted, @<strong>@SharedText.ModeTargeted</strong>, @<text>@ChargeModeTabs.Label(Status.Mode)</text>)
    </p>
}

@code {
    // The viewer's culture, for the renders the poll and other threads ask for (#290).
    private readonly ViewerCulture _viewer = new();

    [Parameter] public ChargeControlStatus? Status { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter, EditorRequired] public Func<ChargeControlMode, Task<ChargeActionResult>> Start { get; set; } = default!;

    [Parameter, EditorRequired] public Func<Task<ChargeActionResult>> Stop { get; set; } = default!;

    /// <summary>Which way round the owner is saying what they want. Purely a property of this form.</summary>
    private enum TargetBasis
    {
        Energy,
        Soc,
    }

    private TargetBasis _basis = TargetBasis.Energy;
    private TargetedChargePriority _priority = TargetedChargePriority.Cheapest;
    private bool _sunOnly;
    private double _energyKWh = 20;
    private double _targetSocPercent = 80;
    private double _restSocPercent;
    private DateTime _departure;
    private double _minBatterySocPercent;
    private string? _error;
    private ChargeControlStatus? _seenStatus;
    private VehicleState? _vehicle;
    private bool _vehicleStale;

    // The preview and what it was built for. Held together so Start commits the figures that were on
    // screen, and so any edit can drop both at once -- it must never be possible to confirm a plan
    // that no longer describes the form above it.
    private TargetedChargePlan? _preview;
    private TargetedChargeRequest? _previewRequest;
    private bool _previewed;

    // The same request priced the cheap way, kept only to name what just-in-time costs. Built in the
    // preview and nowhere else: running two plans on every poll to report a counterfactual is not worth
    // the cycles on a Pi, and a running plan should report what it is doing, not what it declined to do.
    private TargetedChargePlan? _cheapestPreview;

    // The same request paced just in time, kept only to price that option on the dialog's pacing
    // control while Cheapest is the one chosen. Built in the preview and nowhere else, like the above.
    private TargetedChargePlan? _justInTimePreview;

    // Whether the open preview's <dialog> has been made modal yet: once per opening, since showModal
    // on a dialog already open throws.
    private bool _dialogShown;

    protected override void OnInitialized()
    {
        Target.Changed += OnRequestChanged;

        _restSocPercent = Display.DefaultRestSocPercent;
        SeedForm(Target.Request);
        _minBatterySocPercent = ForecastSettings.MinBatterySocFloorPercent;
        RefreshVehicle();
    }

    // Only on a genuinely new poll, not on every render of the page above: the floor is a field the
    // owner may be halfway through typing, and a button press elsewhere on the page must not reset it.
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_seenStatus, Status))
        {
            return;
        }

        _seenStatus = Status;
        _minBatterySocPercent = ForecastSettings.MinBatterySocFloorPercent;

        // The car on the poll's cadence, as the dashboard reads it: vehicle readings arrive minutes
        // apart at best, so this is one subscription rather than two and one render path rather than
        // two. A reading that lands mid-preview does not move the preview -- it was built from the
        // reading that was on screen, and moving it under the owner would be the one thing this whole
        // preview step exists to prevent.
        RefreshVehicle();
    }

    private void OnRequestChanged(TargetedChargeRequest? request)
    {
        SeedForm(request);
        InvokeAsync(_viewer.Wrap(StateHasChanged));
    }

    public void Dispose() => Target.Changed -= OnRequestChanged;

    /// <summary>
    /// Whether a target may be asked for as a state of charge: a configured pack size and a reported
    /// SOC to measure the gap from. Staleness deliberately does not withdraw it — a parked car's SOC
    /// does not drift, the reading is flagged loudly above, and refusing the basis outright would only
    /// push the owner into converting it in their head from the same stale number.
    /// </summary>
    private bool CanTargetSoc => VehicleDisplay.CanTargetSoc && _vehicle?.SocPercent is not null;

    // The form shows what is actually being worked to, when there is one -- a page opened in a second
    // browser must not offer to overwrite the running request with its own defaults.
    private void SeedForm(TargetedChargeRequest? request)
    {
        if (request is not null)
        {
            _energyKWh = Math.Round(Units.KwhFromWattHours(request.RequiredEnergyWh), 1);
            _departure = TimeZoneInfo.ConvertTime(request.DepartBy, Time.LocalTimeZone).DateTime;

            if (request.TargetSocPercent is { } soc)
            {
                _basis = TargetBasis.Soc;
                _targetSocPercent = soc;
            }

            _priority = request.Priority;
            _sunOnly = request.Constraints?.IsSunOnly == true;

            if (request.RestSocPercent is { } rest)
            {
                _restSocPercent = rest;
            }

            return;
        }

        // Tomorrow morning: the case this mode exists for.
        var localNow = TimeZoneInfo.ConvertTime(Time.GetUtcNow(), Time.LocalTimeZone).DateTime;
        _departure = localNow.Date.AddDays(1).AddHours(7);
    }

    private void RefreshVehicle()
    {
        _vehicle = Vehicle.GetCurrentState();
        _vehicleStale = _vehicle is not null && _vehicle.IsStaleAt(Time.GetUtcNow(), VehicleDisplay.MaxAge);
    }

    /// <summary>
    /// Any edit drops the preview. The alternative is a plan on screen describing figures that have
    /// since changed, above a button that says start.
    /// </summary>
    private void OnFormEdited() => DiscardPreview();

    private void DiscardPreview()
    {
        _preview = null;
        _previewRequest = null;
        _cheapestPreview = null;
        _justInTimePreview = null;
        _previewed = false;
        _dialogShown = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_previewed || _dialogShown)
        {
            return;
        }

        _dialogShown = true;
        await JS.InvokeVoidAsync("gleanvoltDialog.show", "target-preview");
    }

    /// <summary>
    /// Sun only, ticked or not. An edit like any other, so it drops the preview; ticking it also moves
    /// the pacing off Just in time, which it rules out.
    /// </summary>
    private void OnSunOnlyChanged(ChangeEventArgs e)
    {
        _sunOnly = e.Value is true;

        if (_sunOnly)
        {
            _priority = TargetedChargePriority.Cheapest;
        }

        OnFormEdited();
    }

    private void SetBasis(TargetBasis basis)
    {
        _basis = basis;
        OnFormEdited();
    }

    /// <summary>
    /// The pacing, from the form or from the open dialog. In the form it is an edit like any other and
    /// drops nothing, because there is no preview to drop; in the dialog it rebuilds the plan in place,
    /// so the owner sees the other choice without closing and reopening it.
    /// </summary>
    private void SetPriority(TargetedChargePriority priority)
    {
        _priority = priority;

        if (_previewed)
        {
            BuildPreview();
        }
    }

    private void BuildPreview()
    {
        if (!TryCompose(Time.GetUtcNow(), out var request, out var error))
        {
            _error = error;
            DiscardPreview();
            return;
        }

        _error = null;
        _previewRequest = request;

        // Null when no poll has landed yet, which the section above says in words rather than
        // pretending to a plan built on zeroes. Either way the owner gets the Start button: a service
        // that has only just come up can still be given a target.
        _preview = Preview.Preview(request);

        // What the same energy by the same time would have cost without the hold. Only when a hold was
        // actually planned: on a request with nothing above the rest point the two plans are the same
        // plan, and "0.0 kWh more" is a sentence about nothing.
        _cheapestPreview = request.HoldsTail
            ? Preview.Preview(request with { Priority = TargetedChargePriority.Cheapest, TailEnergyWh = 0 })
            : null;

        // And the other way round, to price Just in time on the dialog while Cheapest is chosen. Only
        // where pacing is offered at all, and only when the hold would actually hold something.
        _justInTimePreview = null;
        if (CanTargetSoc && !_sunOnly && _priority == TargetedChargePriority.Cheapest
            && TryCompose(Time.GetUtcNow(), TargetedChargePriority.JustInTime, out var heldRequest, out _)
            && heldRequest.HoldsTail)
        {
            _justInTimePreview = Preview.Preview(heldRequest);
        }

        _previewed = true;
    }

    private async Task Activate()
    {
        // Recomposed rather than reusing the previewed request: activation is metered from the instant
        // it happens, and the owner may have read the plan for a minute before pressing Start. Every
        // figure that shapes the plan is unchanged -- an edit would have dropped the preview.
        if (!TryCompose(Time.GetUtcNow(), out var request, out var error))
        {
            _error = error;
            DiscardPreview();
            return;
        }

        _error = null;

        // The request first, then the mode: the controller reads both in the same cycle, and a mode
        // selected a poll before its request would report "no target set" for that poll.
        Target.Set(request, "Web UI");

        // Which also writes the charger's use-mode Fast. A charger that refuses it leaves the mode
        // where it was, and the request set above with nothing driving it -- so the request is
        // dropped again rather than left looking active. The failure itself is reported by the
        // header, next to the mode that did not move.
        var result = await Start(ChargeControlMode.Targeted);
        if (!result.Succeeded)
        {
            Target.Clear("Web UI");
            return;
        }

        // The running plan takes over from here, and two plans on one tab -- one of them a quote for a
        // charge that has already started -- would be one too many.
        DiscardPreview();
    }

    // The same Off the header carries, plus the one thing it cannot know to do: drop the request, so
    // nothing is left looking like a promise after the button that says stop.
    private async Task Cancel()
    {
        _error = null;
        DiscardPreview();

        Target.Clear("Web UI");
        await Stop();
    }

    /// <summary>
    /// Turns the form into a request, or explains why it cannot be one. The single place both Preview
    /// and Start go through, so the two can never disagree about what is valid — and, since the API
    /// composes requests too, no more than a translation of this form into the shared factory's terms.
    /// </summary>
    private bool TryCompose(DateTimeOffset now, out TargetedChargeRequest request, out string? error) =>
        TryCompose(now, _priority, out request, out error);

    private bool TryCompose(
        DateTimeOffset now, TargetedChargePriority priority, out TargetedChargeRequest request, out string? error)
    {
        // The basis the form is actually offering: asking in state of charge needs both a configured
        // pack and a reading to measure the gap from, and without them the selector is not shown at all.
        var socBasis = _basis == TargetBasis.Soc && CanTargetSoc;

        var result = TargetedChargeRequestFactory.Create(
            departBy: Compose(_departure),
            energyWh: socBasis ? null : Units.WattHoursFromKwh(_energyKWh),
            targetSocPercent: socBasis ? _targetSocPercent : null,
            priority: priority,
            restSocPercent: _restSocPercent,
            vehicleSoc: SocBasisAt(now),
            limits: Limits,
            now: now,
            constraints: _sunOnly ? TargetedChargeConstraints.SunOnly : null);

        request = result.Request!;
        error = result.Error is { } refused ? Localized.Say(result.ErrorPhrase, refused) : null;

        return result.Request is not null;
    }

    /// <summary>The installation figures the factory cannot compose a request without.</summary>
    private TargetedChargeRequestLimits Limits => new(
        Display.MaxHorizon,
        VehicleDisplay.BatteryCapacityWh,
        VehicleDisplay.ChargeEfficiency,
        Display.DefaultRestSocPercent);

    /// <summary>The request in the terms it was asked in, which for a SOC target is not kilowatt-hours.</summary>
    private static string Asking(TargetedChargeRequest request) =>
        request.TargetSocPercent is { } target
            ? Localized.Format(PlanText.AskingSoc, Units.Percent(target), Units.Percent(request.VehicleSocPercentAtRequest), Units.Energy(request.RequiredEnergyWh))
            : Localized.Format(PlanText.AskingEnergy, Units.Energy(request.RequiredEnergyWh));

    /// <summary>
    /// What the hold will actually amount to, in the terms the owner set it in. The interesting case is
    /// a car already past the rest point: there is no tail to hold, the whole charge is the tail, and
    /// saying so is better than silently behaving like Cheapest.
    /// </summary>
    private string RestHint()
    {
        if (_vehicle?.SocPercent is not { } socNow)
        {
            return PlanText.NoSocForRest;
        }

        if (socNow >= _restSocPercent)
        {
            return Localized.Format(PlanText.AlreadyAboveRest, Units.Percent(socNow), Units.Percent(_restSocPercent));
        }

        var endSoc = _basis == TargetBasis.Soc && CanTargetSoc
            ? _targetSocPercent
            : VehicleTargetEnergy.ResultingSocPercent(
                socNow, Units.WattHoursFromKwh(_energyKWh), VehicleDisplay.BatteryCapacityWh, VehicleDisplay.ChargeEfficiency) ?? 0;

        if (endSoc <= _restSocPercent)
        {
            return Localized.Format(PlanText.FinishesBelowRest, Units.Percent(endSoc), Units.Percent(_restSocPercent));
        }

        var tailWh = VehicleTargetEnergy.TailAboveRestWh(
            socNow, endSoc, _restSocPercent, VehicleDisplay.BatteryCapacityWh, VehicleDisplay.ChargeEfficiency);

        return Localized.Format(PlanText.RestExplained, Units.Percent(_restSocPercent), Units.Energy(tailWh ?? 0), Units.Percent(_restSocPercent), Units.Percent(endSoc));
    }

    /// <summary>The request as the dialog's title: what, by when -- "80% by Thu 17:00".</summary>
    private string Title(TargetedChargeRequest request)
    {
        var by = TimeZoneInfo.ConvertTime(request.DepartBy, Time.LocalTimeZone).ToString(SharedText.DayTimePattern, System.Globalization.CultureInfo.CurrentCulture);

        return request.TargetSocPercent is { } target
            ? Localized.Format(PlanText.TitleSoc, Units.Percent(target), by)
            : Localized.Format(PlanText.TitleEnergy, Units.Energy(request.RequiredEnergyWh), by);
    }

    /// <summary>
    /// How much more grid Just in time buys than Cheapest, for whichever of the two plans is not the
    /// chosen one. Null when there is no comparison to make, or nothing in it.
    /// </summary>
    private double? JustInTimeExtraWh()
    {
        var (held, cheap) = _priority == TargetedChargePriority.JustInTime
            ? (_preview, _cheapestPreview)
            : (_justInTimePreview, _preview);

        if (held is null || cheap is null)
        {
            return null;
        }

        var extraWh = held.GridEnergyWh - cheap.GridEnergyWh;

        return extraWh > 100 ? extraWh : null;
    }

    // A width for the split bar, as a share of everything the plan sends to the car.
    private static string Share(double wattHours, TargetedChargePlan plan)
    {
        var total = plan.SolarEnergyWh + plan.GridEnergyWh;

        return total <= 0
            ? "0%"
            : $"{(wattHours / total * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";
    }

    /// <summary>
    /// What choosing the hold costs, against the same energy by the same time charged as cheaply as
    /// possible. Empty when there is nothing to say: no comparison built, or the two plans buy the same.
    /// </summary>
    private string? HoldCost()
    {
        if (_preview is not { } held || _cheapestPreview is not { } cheap)
        {
            return null;
        }

        var extraWh = held.GridEnergyWh - cheap.GridEnergyWh;
        if (extraWh <= 100)
        {
            return PlanText.HoldCostsNothing;
        }

        return Localized.Format(PlanText.HoldCost, Units.Energy(extraWh), Units.Percent(_restSocPercent));
    }

    /// <summary>
    /// What the car last reported, and whether it is still worth converting from (#179). One
    /// expression, so the hint under the box and the press that follows it cannot disagree about
    /// whether the reading is usable.
    /// </summary>
    private VehicleSocBasis SocBasisAt(DateTimeOffset now) =>
        VehicleSocBasis.From(_vehicle, VehicleDisplay.MaxAge, now);

    private string SocConversionHint()
    {
        var basis = SocBasisAt(Time.GetUtcNow());

        // The guard, said before the press rather than only after it (#179). A hint quoting "that is
        // about 32.5 kWh" off a thirteen-hour-old percentage is precisely the silent conversion this
        // is about, and the form is where an owner reads it first — refusing on Start while the box
        // underneath still promised a figure would be the page contradicting itself.
        if (basis.StaleRefusal is { } tooOld)
        {
            return Localized.Say(basis.StaleRefusalPhrase, tooOld);
        }

        var requiredWh = VehicleTargetEnergy.RequiredWh(
            basis.ConvertibleSocPercent, _targetSocPercent, VehicleDisplay.BatteryCapacityWh, VehicleDisplay.ChargeEfficiency);

        return requiredWh switch
        {
            null => PlanText.NoUsableSoc,
            <= 0 => Localized.Format(PlanText.AlreadyAt, Units.Percent(basis.SocPercent)),
            _ => Localized.Format(PlanText.SocConversion, Units.Percent(basis.SocPercent), Units.Energy(requiredWh.Value), Units.Capacity(VehicleDisplay.BatteryCapacityWh), Units.Fraction(VehicleDisplay.ChargeEfficiency)),
        };
    }

    // Composed through the app's own zone rather than DateTime.Now, so "07:00" means seven o'clock
    // here whatever the server or the browser thinks, and a DST boundary between now and then cannot
    // move it by an hour.
    private DateTimeOffset Compose(DateTime local) =>
        new(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), Time.LocalTimeZone.GetUtcOffset(local));

    private void OnMinBatterySocSelected() =>
        ForecastSettings.SetMinBatterySocFloorPercent(_minBatterySocPercent, "Web UI");

    private string PluggedIn()
    {
        // Three answers at the socket, not two: before the first poll the charger has not been read at
        // all, and reporting that as "no" would be a claim about hardware nobody has asked yet.
        var charger = Status is null
            ? PlanText.NotPolledYet
            : Status.CarConnected ? PlanText.YesAtCharger : PlanText.NoAtCharger;
        var car = _vehicle?.PlugState switch
        {
            VehiclePlugState.Connected => PlanText.CarConnected,
            VehiclePlugState.Disconnected => PlanText.CarDisconnected,
            _ => PlanText.NotReported,
        };

        return Localized.Format(PlanText.PlugLine, charger, car);
    }

    // Coarse on purpose, and the dashboard's own rendering: this data is hours old routinely, so
    // minutes of precision would imply an accuracy the source doesn't have.
    private string VehicleAge(VehicleState vehicle) => VehicleFormatting.Age(vehicle, Time.GetUtcNow());
}
