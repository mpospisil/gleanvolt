@implements IDisposable
@inject ITargetedChargeSelector Target
@inject IForecastRuntimeSettings ForecastSettings
@inject TargetedDisplayOptions Display
@inject TimeProvider Time

@*
    The old /targeted page, now the fourth tab (#98). Unchanged in substance: the request is set on
    ITargetedChargeSelector and the mode is then started through the page's Start -- which puts the
    charger into Fast first (#89) -- and Cancel clears the request and stops, which is the same Off
    the header carries plus the clearing the header cannot know to do.

    Text, not a chart: the question at 22:00 is "is the car going to be ready, and why is nothing
    happening yet?", and no chart answers that as directly as a sentence. The timeline chart is its
    own story and will consume TargetedChargePlan.Blocks unchanged.

    The minimum battery SOC appears here as well as on the Forecasted tab, through the same runtime
    seam: it is the floor this planner will not draw the pack below, and reading it as a plan figure
    without being able to move it is exactly the split this page was built to end.

    Subscribes to the request itself, because it can move without this tab's help -- Home Assistant
    sets one too, and the mode clears itself once the target is met.
*@

<p class="muted">
    Say how much energy the car needs and when it has to be there. The plan takes every kilowatt-hour
    of forecast surplus the home battery has not already claimed, and buys the rest from the grid as
    late as it can and still finish in time.
</p>

<div class="control">
    <label for="target-energy">Energy needed (kWh)</label>
    <input id="target-energy" type="number" step="0.5" min="0" @bind="_energyKWh" @bind:event="onchange" />
    <span class="hint">Measured at the charger, from the moment you press Activate.</span>
</div>

<div class="control">
    <label for="target-departure">Ready by</label>
    <input id="target-departure" type="datetime-local" @bind="_departure" @bind:event="onchange" />
    <span class="hint">
        Charging finishes a few minutes before this, so the car is ready rather than still drawing.
        At most @(Display.MaxHorizon.TotalHours.ToString("F0")) hours ahead.
    </span>
</div>

<div class="control">
    <label for="min-battery-soc">Minimum battery SOC (%)</label>
    <input id="min-battery-soc" type="number" step="1" min="0" max="100"
           @bind="_minBatterySocPercent" @bind:event="onchange" @bind:after="OnMinBatterySocSelected" />
    <span class="hint">
        The floor the home battery is not drawn below to feed the car; the grid covers the gap
        instead. The same number the <a href="/charging-plan/forecasted">Forecasted</a> plan works to.
        Doesn't persist across restarts.
    </span>
</div>

<div class="control">
    <button type="button" class="primary" id="activate-target" disabled="@Busy" @onclick="Activate">Activate</button>
    <button type="button" class="secondary" id="cancel-target" disabled="@Busy" @onclick="Cancel">Cancel</button>

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }

    <span class="hint">
        The request does not survive a restart of the service. If it restarts overnight the car stops
        charging, and nothing will have told you.
    </span>
</div>

@if (Status?.TargetedPlan is { } plan)
{
    <section class="plan">
        <h2>The plan</h2>

        @foreach (var paragraph in TargetedPlanNarrative.Describe(plan, Time.LocalTimeZone))
        {
            <p>@paragraph</p>
        }
    </section>

    <section class="stat-grid">
        <Stat Label="Plan state" Value="@plan.Strategy.ToString()"
              Hint="Complete: the target is met. Solar: the forecast covers it with no import at all. SolarPlusGrid: the sun carries what it can and the grid paces the rest. Maximum: there is not enough time, so everything available is taken." />
        <Stat Label="Still needed" Value="@Kwh(plan.RemainingEnergyWh)"
              Hint="The request less what the charger has measurably delivered since it was activated." />
        <Stat Label="Delivered so far" Value="@Kwh(plan.DeliveredEnergyWh)"
              Hint="Measured at the charger, so a car that limits itself to less than we asked for simply gets a longer grid block on the next poll." />
        <Stat Label="Forecast surplus" Value="@Kwh(plan.ForecastSurplusWh)"
              Hint="All the surplus this window is forecast to hold, after the house and the home battery's booking — whether or not the car can charge on it unaided." />
        <Stat Label="From sun" Value="@Kwh(plan.SolarEnergyWh)"
              Hint="The part of the surplus above that the car can actually run on alone. Zero does not mean no sun: it means no half-hour clears the charger's 6 A minimum, which is why the grid block is placed over the sunniest hours rather than after them." />
        <Stat Label="From grid" Value="@Kwh(plan.GridEnergyWh)"
              Hint="What the sun cannot cover. Rebuilt every poll, so a better day than forecast shrinks this before the rest of it is bought." />
        <Stat Label="Charge pace" Value="@($"{plan.RequiredPaceWatts / 1000:F1} kW")"
              Hint="The average the grid must sustain to keep the promise: what is still needed, less the sun forecast to reach the car, over the time left. The charger runs at this plus whatever the roof is giving, so sun above it is free and lowers it for later. Zero means the forecast covers the target outright." />
        <Stat Label="Charging from" Value="@(plan.GridStart is { } start ? Clock(start) : "—")"
              Hint="When the first grid-funded charging starts. The charge is spread across the window rather than run flat out, because the charger can only use the sun that shines while it runs." />
        <Stat Label="Expected by departure" Value="@Kwh(plan.ExpectedEnergyWh)"
              Hint="What will actually reach the car. Below what was asked for only when there is not enough time left." />
        <Stat Label="Shortfall" Value="@Kwh(plan.ShortfallWh)"
              Hint="How far the plan falls short of the request. Anything above zero means the departure is too soon for the amount asked for." />
        <Stat Label="Battery SOC floor" Value="@Percent(plan.SocFloorPercent)"
              Hint="The home battery is not drawn below this to feed the car; the grid covers the gap instead." />
        <Stat Label="Ready by" Value="@Clock(plan.Deadline)"
              Hint="The finish line the plan works to: your departure less the safety margin." />
    </section>
}
else if (Status is null)
{
    <p class="muted">No poll has completed yet.</p>
}
else
{
    <p class="muted">
        The plan is only shown while <strong>Targeted</strong> is the active charge mode.
        Current mode: @Status.Mode.
    </p>
}

@code {
    [Parameter] public ChargeControlStatus? Status { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter, EditorRequired] public Func<ChargeControlMode, Task<ChargeActionResult>> Start { get; set; } = default!;

    [Parameter, EditorRequired] public Func<Task<ChargeActionResult>> Stop { get; set; } = default!;

    private double _energyKWh = 20;
    private DateTime _departure;
    private double _minBatterySocPercent;
    private string? _error;
    private ChargeControlStatus? _seenStatus;

    protected override void OnInitialized()
    {
        Target.Changed += OnRequestChanged;

        SeedForm(Target.Request);
        _minBatterySocPercent = ForecastSettings.MinBatterySocFloorPercent;
    }

    // Only on a genuinely new poll, not on every render of the page above: the floor is a field the
    // owner may be halfway through typing, and a button press elsewhere on the page must not reset it.
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_seenStatus, Status))
        {
            return;
        }

        _seenStatus = Status;
        _minBatterySocPercent = ForecastSettings.MinBatterySocFloorPercent;
    }

    private void OnRequestChanged(TargetedChargeRequest? request)
    {
        SeedForm(request);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Target.Changed -= OnRequestChanged;

    // The form shows what is actually being worked to, when there is one -- a page opened in a second
    // browser must not offer to overwrite the running request with its own defaults.
    private void SeedForm(TargetedChargeRequest? request)
    {
        if (request is not null)
        {
            _energyKWh = Math.Round(request.RequiredEnergyWh / 1000, 1);
            _departure = TimeZoneInfo.ConvertTime(request.DepartBy, Time.LocalTimeZone).DateTime;
            return;
        }

        // Tomorrow morning: the case this mode exists for.
        var localNow = TimeZoneInfo.ConvertTime(Time.GetUtcNow(), Time.LocalTimeZone).DateTime;
        _departure = localNow.Date.AddDays(1).AddHours(7);
    }

    private async Task Activate()
    {
        var now = Time.GetUtcNow();
        var departBy = Compose(_departure);

        if (_energyKWh <= 0)
        {
            _error = "Enter how much energy the car needs.";
            return;
        }

        if (departBy <= now)
        {
            _error = "The departure time is in the past.";
            return;
        }

        if (departBy - now > Display.MaxHorizon)
        {
            _error = $"A departure more than {Display.MaxHorizon.TotalHours:F0} hours away is further than "
                + "the forecast — or a request that does not survive a restart — can honestly promise.";
            return;
        }

        _error = null;

        // The request first, then the mode: the controller reads both in the same cycle, and a mode
        // selected a poll before its request would report "no target set" for that poll.
        Target.Set(new TargetedChargeRequest(_energyKWh * 1000, departBy, now), "Web UI");

        // Which also writes the charger's use-mode Fast. A charger that refuses it leaves the mode
        // where it was, and the request set above with nothing driving it -- so the request is
        // dropped again rather than left looking active. The failure itself is reported by the
        // header, next to the mode that did not move.
        var result = await Start(ChargeControlMode.Targeted);
        if (!result.Succeeded)
        {
            Target.Clear("Web UI");
        }
    }

    // The same Off the header carries, plus the one thing it cannot know to do: drop the request, so
    // nothing is left looking like a promise after the button that says stop.
    private async Task Cancel()
    {
        _error = null;

        Target.Clear("Web UI");
        await Stop();
    }

    // Composed through the app's own zone rather than DateTime.Now, so "07:00" means seven o'clock
    // here whatever the server or the browser thinks, and a DST boundary between now and then cannot
    // move it by an hour.
    private DateTimeOffset Compose(DateTime local) =>
        new(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), Time.LocalTimeZone.GetUtcOffset(local));

    private void OnMinBatterySocSelected() =>
        ForecastSettings.SetMinBatterySocFloorPercent(_minBatterySocPercent, "Web UI");

    private string Clock(DateTimeOffset instant) =>
        TimeZoneInfo.ConvertTime(instant, Time.LocalTimeZone).ToString("ddd HH:mm");

    private static string Kwh(double wattHours) => $"{wattHours / 1000:F1} kWh";

    private static string Percent(double percent) => $"{percent:F0}%";
}
