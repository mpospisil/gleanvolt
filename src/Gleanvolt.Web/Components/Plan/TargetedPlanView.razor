@inject TimeProvider Time

@*
    One targeted plan, in words and then in figures. Extracted from TargetedTab (#99) because the
    plan is now shown twice on that tab and must read identically both times: once as a preview of a
    request nobody has made yet, and once as the plan the charger is actually working to.

    That identity is the point of the split, not a side-effect of it. What the owner confirms has to
    be what they then watch -- a preview that summarised and a running plan that detailed would leave
    them comparing two descriptions instead of one plan against reality.
*@

@*
    The 1d preview dialog (#255) shows the words up top and folds the figures away under a disclosure,
    so it asks for the two halves separately. Both default to on, which is the running plan's view.
*@
@if (ShowNarrative)
{
    @foreach (var paragraph in TargetedPlanNarrative.Describe(Plan, Time.LocalTimeZone))
    {
        <p>@paragraph</p>
    }
}

@if (ShowFigures)
{
    <section class="stat-grid">
        <Stat Label="@PlanText.PlanState" Value="@Localized.Name(Plan.Strategy)"
              Hint="@PlanText.TargetedPlanStateHint" />
        <Stat Label="@PlanText.StillNeeded" Value="@Units.Energy(Plan.RemainingEnergyWh)"
              Hint="@PlanText.StillNeededHint" />
        <Stat Label="@PlanText.DeliveredSoFar" Value="@Units.Energy(Plan.DeliveredEnergyWh)"
              Hint="@PlanText.DeliveredSoFarHint" />
        <Stat Label="@PlanText.ForecastSurplus" Value="@Units.Energy(Plan.ForecastSurplusWh)"
              Hint="@PlanText.ForecastSurplusHint" />
        <Stat Label="@PlanText.FromSun" Value="@Units.Energy(Plan.SolarEnergyWh)"
              Hint="@PlanText.FromSunHint" />
        <Stat Label="@PlanText.FromGrid" Value="@Units.Energy(Plan.GridEnergyWh)"
              Hint="@PlanText.FromGridHint" />
        <Stat Label="@PlanText.ChargePace" Value="@Units.Power(Plan.RequiredPaceWatts)"
              Hint="@PlanText.ChargePaceHint" />
        <Stat Label="@PlanText.ChargingFrom" Value="@(Plan.GridStart is { } start ? Clock(start) : Units.Missing)"
              Hint="@PlanText.ChargingFromHint" />
        <Stat Label="@PlanText.ExpectedByDeparture" Value="@Units.Energy(Plan.ExpectedEnergyWh)"
              Hint="@PlanText.ExpectedByDepartureHint" />
        <Stat Label="@PlanText.Shortfall" Value="@Units.Energy(Plan.ShortfallWh)"
              Hint="@PlanText.ShortfallHint" />
        @*
            Only under a just-in-time hold. On every other plan these two would read "0.0 kWh" and "—",
            which is a pair of answers to a question nobody asked.
        *@
        @if (Plan.HoldUntil is { } release)
        {
            <Stat Label="@PlanText.HeldBack" Value="@Units.Energy(Plan.TailEnergyWh)"
                  Hint="@PlanText.HeldBackHint" />
            <Stat Label="@PlanText.ReleasedAt" Value="@Clock(release)"
                  Hint="@PlanText.ReleasedAtHint" />
        }

        <Stat Label="@PlanText.BatterySocFloor" Value="@Units.Percent(Plan.SocFloorPercent)"
              Hint="@PlanText.BatterySocFloorHint" />
        <Stat Label="@PlanText.ReadyBy" Value="@Clock(Plan.Deadline)"
              Hint="@PlanText.ReadyByHint" />
    </section>
}

@code {
    [Parameter, EditorRequired] public TargetedChargePlan Plan { get; set; } = default!;

    /// <summary>Whether to show the plan in words.</summary>
    [Parameter] public bool ShowNarrative { get; set; } = true;

    /// <summary>Whether to show the plan's figures.</summary>
    [Parameter] public bool ShowFigures { get; set; } = true;

    private string Clock(DateTimeOffset instant) =>
        TimeZoneInfo.ConvertTime(instant, Time.LocalTimeZone).ToString(SharedText.DayTimePattern, System.Globalization.CultureInfo.CurrentCulture);
}
