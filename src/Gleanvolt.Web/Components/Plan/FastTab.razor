@using Gleanvolt.Core.Strategies
@implements IDisposable
@inject IFastChargeSelector Fast
@inject IVehicleTelemetry Vehicle
@inject VehicleDisplayOptions VehicleDisplay
@inject TargetedDisplayOptions Display
@inject TimeProvider Time

@*
    The mode for when the sun is beside the point.

    Since #119 it takes an amount as well: how much to deliver before it stops itself, asked in
    kilowatt-hours or as a battery target, or not asked at all -- which is Full, the default, and what
    this tab did for its whole life before now.

    The amount is a *stopping condition*. It changes nothing about how the charge runs: the setpoint is
    still pinned at the installation's maximum from the moment it starts. Anything that paces a charge,
    waits for cheaper sun, or plans around a deadline is the targeted tab's job, and the two are next to
    each other for exactly that reason.

    Subscribes to the limit itself, because it can move without this tab's help -- Home Assistant and
    the API set one too, and the mode clears itself once the charge ends.
*@

<div class="muted intro-line">
    @PlanText.FastIntro
    <InfoTip Topic="@PlanText.ThisModeTopic">
        <p>
            @PlanText.FastTip
        </p>
    </InfoTip>
</div>

@*
    The basis selector appears only when the battery target can be honoured: a capacity in
    Vehicle:BatteryCapacityKWh and an SOC in the last reading. Without both there is no honest
    conversion from "60%" to kilowatt-hours, so that one option is withheld -- but the other two are
    offered regardless, unlike on the targeted tab, because "full" and "20 kWh" need nothing from the
    car at all.
*@
<div class="control">
    <div class="control-head">
        <label for="fast-basis">@PlanText.HowMuch</label>
        <InfoTip Topic="@PlanText.HowMuchTopic">
            <p>@BasisHint()</p>
        </InfoTip>
    </div>
    <select id="fast-basis" @bind="_basis" @bind:event="onchange" @bind:after="OnFormEdited">
        <option value="@FastChargeBasis.Full">@PlanText.UntilCarStops</option>
        <option value="@FastChargeBasis.Energy">@PlanText.EnergyToAdd</option>
        @if (CanTargetSoc)
        {
            <option value="@FastChargeBasis.Soc">@PlanText.BatteryTarget</option>
        }
    </select>
</div>

@if (_basis == FastChargeBasis.Energy)
{
    <div class="control">
        <div class="control-head">
            <label for="fast-energy">@PlanText.EnergyNeeded</label>
            <InfoTip Topic="@PlanText.EnergyNeededTopic">
                <p>@PlanText.EnergyNeededTip</p>
            </InfoTip>
        </div>
        <input id="fast-energy" type="number" step="0.5" min="0"
               @bind="_energyKWh" @bind:event="onchange" @bind:after="OnFormEdited" />
    </div>
}
else if (_basis == FastChargeBasis.Soc && CanTargetSoc)
{
    <div class="control">
        <label for="fast-soc">@PlanText.ChargeTo</label>
        <input id="fast-soc" type="number" step="5" min="0" max="100"
               @bind="_targetSocPercent" @bind:event="onchange" @bind:after="OnFormEdited" />
        <span class="hint">@SocConversionHint()</span>
    </div>
}

@*
    The departure (#122). Offered only alongside an amount, because without one there is no duration to
    work back from and so no such thing as the latest moment it could start -- the factory refuses that
    combination, and a box that is only ever refused is worse than a box that isn't there.
*@
@if (_basis != FastChargeBasis.Full)
{
    <div class="control">
        <div class="control-head">
            <label for="fast-departure">@PlanText.ReadyByOptional</label>
            <InfoTip Topic="@PlanText.ReadyByTopic">
                <p>
                    @PlanText.ReadyByTip
                </p>
            </InfoTip>
        </div>
        <input id="fast-departure" type="datetime-local" step="900"
               @bind="_departBy" @bind:event="onchange" @bind:after="OnFormEdited" />
    </div>
}

<LowTariffOption Mode="ChargeControlMode.FastNoBattery" Status="Status"
                 Hint="@PlanText.FastLowTariffHint" />

<div class="control">
    <button type="button" class="primary" id="start-fast-no-battery" disabled="@Busy" @onclick="StartFast">
        @PlanText.StartFast
    </button>
    <InfoTip Topic="@PlanText.StartFastTopic">
        <p>@EndsHint()</p>
    </InfoTip>
</div>

@if (_error is { } error)
{
    <p class="error" role="alert" id="fast-error">@error</p>
}

@if (Status is { } status)
{
    <section class="stat-grid">
        <Stat Label="@PlanText.EvPower" Value="@Units.Power(status.EvChargerPowerWatts)"
              Hint="@PlanText.FastEvPowerHint" />
        <Stat Label="@PlanText.EvCurrent" Value="@Units.Current(status.EvChargingCurrentAmps)"
              Hint="@PlanText.FastEvCurrentHint" />
        <Stat Label="@PlanText.ActiveCurrent" Value="@Units.Current(status.ActiveCurrentAmps)"
              Hint="@PlanText.ActiveCurrentHint" />
        <Stat Label="@PlanText.GridPower" Value="@Units.Power(status.GridPowerWatts)" End="true"
              Hint="@PlanText.FastGridPowerHint" />

        @*
            The fifth stat exists only while there is an amount to count towards. On a Full charge there
            is no number to be short of, and a tile reading "— of —" would be a worse answer than no
            tile.
        *@
        @if (status.FastCharge is { } progress)
        {
            <Stat Label="@PlanText.Delivered" Value="@Delivered(progress)"
                  Hint="@PlanText.DeliveredHint" />
        }
    </section>

    @if (status.FastCharge is { } running)
    {
        <p class="muted" id="fast-progress">@ProgressNarrative(running)</p>
    }

    @if (status.FastCharge?.Plan is { } schedule)
    {
        <p class="muted" id="fast-schedule">@ScheduleNarrative(schedule, status.Timestamp)</p>
    }
}

@code {
    [Parameter] public ChargeControlStatus? Status { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter, EditorRequired] public Func<ChargeControlMode, Task<ChargeActionResult>> Start { get; set; } = default!;

    private FastChargeBasis _basis = FastChargeBasis.Full;
    private double _energyKWh = 20;
    private double _targetSocPercent = 80;
    private DateTime? _departBy;
    private string? _error;

    private VehicleState? _vehicle;

    protected override void OnInitialized()
    {
        _vehicle = Vehicle.GetCurrentState();
        Fast.Changed += OnLimitChanged;
        AdoptRunningLimit(Fast.Limit);
    }

    public void Dispose() => Fast.Changed -= OnLimitChanged;

    private void OnLimitChanged(FastChargeLimit? limit) =>
        InvokeAsync(() =>
        {
            AdoptRunningLimit(limit);
            StateHasChanged();
        });

    // A limit set from Home Assistant or the API is what this charge is actually stopping at, so the
    // form shows it rather than whatever was last typed here. Clearing does not reset the boxes: the
    // figures are still what the owner would press again with.
    private void AdoptRunningLimit(FastChargeLimit? limit)
    {
        if (limit is null)
        {
            return;
        }

        if (limit.TargetSocPercent is { } soc)
        {
            _basis = FastChargeBasis.Soc;
            _targetSocPercent = soc;
        }
        else
        {
            _basis = FastChargeBasis.Energy;
            _energyKWh = Units.KwhFromWattHours(limit.RequiredEnergyWh);
        }

        _departBy = limit.DepartBy is { } departure
            ? TimeZoneInfo.ConvertTime(departure, Time.LocalTimeZone).DateTime
            : null;
    }

    private void OnFormEdited() => _error = null;

    // The amount first, then the mode, in the order the targeted tab applies its request and for the
    // same reason: the controller reads both in one cycle. A rejection stops here rather than starting
    // a charge that would run to full when a number was asked for.
    private async Task StartFast()
    {
        _vehicle = Vehicle.GetCurrentState();

        var composed = FastChargeLimitFactory.Create(
            basis: _basis == FastChargeBasis.Soc && !CanTargetSoc ? FastChargeBasis.Full : _basis,
            energyWh: Units.WattHoursFromKwh(_energyKWh),
            targetSocPercent: _targetSocPercent,
            vehicleSoc: SocBasis,
            pack: new VehiclePackLimits(VehicleDisplay.BatteryCapacityWh, VehicleDisplay.ChargeEfficiency),
            now: Time.GetUtcNow(),
            // Only when the basis can carry one -- the box is hidden under Full, so a stale value left
            // in it must not travel with a press that no longer means to use it.
            departBy: _basis == FastChargeBasis.Full || _departBy is not { } local ? null : Compose(local),
            maxHorizon: Display.MaxHorizon);

        if (!composed.Accepted)
        {
            _error = composed.Error is { } error ? Localized.Say(composed.ErrorPhrase, error) : null;
            return;
        }

        _error = null;

        if (composed.Limit is { } limit)
        {
            Fast.Set(limit, "Web UI");
        }
        else
        {
            // Cleared rather than left standing: a limit from an earlier charge would otherwise end
            // this one, which was asked to run until the car stops.
            Fast.Clear("Web UI");
        }

        // Which also writes the charger's use-mode Fast. A charger that refuses it leaves the mode where
        // it was, and the limit set above with nothing driving it -- so the limit is dropped again
        // rather than left standing, ready to end somebody else's charge. The failure itself is
        // reported by the page's own header, next to the mode it failed to move, so nothing is said
        // about it here: _error is for what this tab refused.
        var result = await Start(ChargeControlMode.FastNoBattery);

        if (!result.Succeeded)
        {
            Fast.Clear("Web UI");
        }
    }

    // The SOC basis needs both a configured capacity and a reading to measure the gap from. The same
    // test the targeted tab makes, and for the same reason: a control that would have to guess is worse
    // than a control that isn't offered.
    private bool CanTargetSoc => VehicleDisplay.CanTargetSoc && _vehicle?.SocPercent is not null;

    private string BasisHint() => _basis switch
    {
        FastChargeBasis.Energy =>
            PlanText.BasisEnergyHint,
        FastChargeBasis.Soc =>
            PlanText.BasisSocHint,
        _ => CanTargetSoc
            ? PlanText.BasisFullHint
            : PlanText.BasisFullNoSocHint,
    };

    private string EndsHint() => _basis == FastChargeBasis.Full
        ? PlanText.EndsFullHint
        : PlanText.EndsAmountHint;

    /// <summary>
    /// What the car last reported, and whether it is still worth converting from (#179). One
    /// expression, so the hint under the box and the press that follows cannot disagree.
    /// </summary>
    private VehicleSocBasis SocBasis =>
        VehicleSocBasis.From(_vehicle, VehicleDisplay.MaxAge, Time.GetUtcNow());

    private string SocConversionHint()
    {
        var basis = SocBasis;

        // Said before the press rather than only after it (#179), for the same reason the targeted tab
        // does it: a figure quoted here off an hours-old percentage is the silent conversion the guard
        // exists to stop, and this mode draws the site's supply limit for hours on the answer.
        if (basis.StaleRefusal is { } tooOld)
        {
            return Localized.Say(basis.StaleRefusalPhrase, tooOld);
        }

        var requiredWh = VehicleTargetEnergy.RequiredWh(
            basis.ConvertibleSocPercent, _targetSocPercent, VehicleDisplay.BatteryCapacityWh, VehicleDisplay.ChargeEfficiency);

        return requiredWh switch
        {
            null => PlanText.NoUsableSoc,
            <= 0 => Localized.Format(PlanText.AlreadyAt, Units.Percent(basis.SocPercent)),
            _ => Localized.Format(PlanText.SocConversion, Units.Percent(basis.SocPercent), Units.Energy(requiredWh.Value), Units.Capacity(VehicleDisplay.BatteryCapacityWh), Units.Fraction(VehicleDisplay.ChargeEfficiency)),
        };
    }

    private static string ProgressNarrative(FastChargeProgress progress)
    {
        if (progress.IsMet)
        {
            return Localized.Format(PlanText.FastDelivered, Units.Energy(progress.Limit.RequiredEnergyWh));
        }

        var asked = progress.Limit.TargetSocPercent is { } soc
            ? Localized.Format(PlanText.AskedSoc, Units.Energy(progress.Limit.RequiredEnergyWh), Units.Percent(soc))
            : Units.Energy(progress.Limit.RequiredEnergyWh);

        return Localized.Format(PlanText.FastProgress, Units.Energy(progress.DeliveredWh), asked, Units.Energy(progress.RemainingWh));
    }

    private static string ScheduleNarrative(FastChargePlan plan, DateTimeOffset now)
    {
        var power = plan.PowerObserved
            ? Localized.Format(PlanText.PowerObserved, Units.Power(plan.ChargePowerWatts))
            : Localized.Format(PlanText.PowerMaximum, Units.Power(plan.ChargePowerWatts));

        if (!plan.IsFeasible)
        {
            return Localized.Format(PlanText.NotEnoughTime, Units.Energy(plan.ShortfallWh), plan.ReadyBy.LocalDateTime, power);
        }

        return plan.IsWaitingAt(now)
            ? Localized.Format(PlanText.WaitingUntil, plan.StartNoLaterThan.LocalDateTime, Units.Energy(plan.RemainingEnergyWh), power, Units.Duration(plan.Duration), plan.ReadyBy.LocalDateTime)
            : Localized.Format(PlanText.ChargingToBeReady, plan.ReadyBy.LocalDateTime, Units.Energy(plan.RemainingEnergyWh), power);
    }

    // Composed through the app's own zone rather than DateTime.Now, so "07:00" means seven o'clock here
    // whatever the server or the browser thinks, and a DST boundary between now and then cannot move it
    // by an hour. The same helper, and the same reasoning, as the targeted tab's.
    private DateTimeOffset Compose(DateTime local) =>
        new(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), Time.LocalTimeZone.GetUtcOffset(local));

    private static string Delivered(FastChargeProgress progress) =>
        $"{Units.Kwh(progress.DeliveredWh, unit: false)} / {Units.Kwh(progress.Limit.RequiredEnergyWh)}";
}
