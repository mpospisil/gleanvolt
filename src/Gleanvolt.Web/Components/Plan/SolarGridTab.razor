@inject ISolarGridSettings SolarGridSettings
@inject TimeProvider Time

@*
    Sun first, grid allowed, and only for as long as today's sun lasts. One number steers it -- the
    minimum surplus below which the grid may not help -- and one verdict explains it: when the forecast
    says the useful sun ends, which is also when the mode will switch itself off.

    The number is written through ISolarGridSettings, the seam the MQTT worker's number entity writes,
    and re-read whenever a new status lands, for the same reason the forecast tab re-reads its four:
    Home Assistant or a second browser can move it, and this tab shows what the controller is using.
*@

<div class="muted intro-line">
    @PlanText.SolarGridIntro
    <InfoTip Topic="@PlanText.ThisModeTopic">
        <p>
            @PlanText.SolarGridTip
        </p>
    </InfoTip>
</div>

<div class="control">
    <button type="button" class="primary" id="start-solar-grid" disabled="@Busy" @onclick="StartSolarGrid">
        @PlanText.StartSolarGrid
    </button>
    <InfoTip Topic="@PlanText.StartSolarGridTopic">
        <p>
            @PlanText.StartSolarGridTip
        </p>
    </InfoTip>
</div>

<div class="control">
    <div class="control-head">
        <label for="min-solar-surplus">@PlanText.MinSurplus</label>
        <InfoTip Topic="@PlanText.MinSurplusTopic">
            <p>
                @PlanText.MinSurplusTip
            </p>
        </InfoTip>
    </div>
    <input id="min-solar-surplus" type="number" step="100" min="0"
           @bind="_minSurplusWatts" @bind:event="onchange" @bind:after="OnMinSurplusSelected" />
</div>

<LowTariffOption Mode="ChargeControlMode.SolarGrid" Status="Status"
                 Hint="@PlanText.SolarGridLowTariffHint" />

@if (Status is { } status)
{
    <section class="stat-grid">
        <Stat Label="@PlanText.SolarSurplus" Value="@Units.Power(status.SurplusWatts)"
              Hint="@PlanText.SolarSurplusHint" />
        <Stat Label="@PlanText.SunUntil" Value="@SunUntil(status)"
              Hint="@PlanText.SunUntilHint" />
        <Stat Label="@PlanText.TargetCurrent" Value="@Units.Current(status.TargetCurrentAmps)"
              Hint="@PlanText.TargetCurrentHint" />
        <Stat Label="@PlanText.GridPower" Value="@Units.Power(status.GridPowerWatts)" End="true"
              Hint="@PlanText.GridPowerTopUpHint" />
    </section>

    @if (status.Mode == ChargeControlMode.SolarGrid && status.SolarGrid is { } outlook)
    {
        <p class="muted">@Localized.Format(PlanText.ForecastReason, Localized.Say(outlook.ReasonPhrase, outlook.Reason, Time.LocalTimeZone))</p>
    }
}

@code {
    [Parameter] public ChargeControlStatus? Status { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter, EditorRequired] public Func<ChargeControlMode, Task<ChargeActionResult>> Start { get; set; } = default!;

    private double _minSurplusWatts;

    // Which status the number was last refreshed from: only a new poll may overwrite a value the owner
    // is halfway through typing, not the re-render a button press causes.
    private ChargeControlStatus? _seenStatus;

    protected override void OnInitialized() => _minSurplusWatts = SolarGridSettings.MinSurplusWatts;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_seenStatus, Status))
        {
            return;
        }

        _seenStatus = Status;
        _minSurplusWatts = SolarGridSettings.MinSurplusWatts;
    }

    private Task StartSolarGrid() => Start(ChargeControlMode.SolarGrid);

    private void OnMinSurplusSelected() => SolarGridSettings.SetMinSurplusWatts(_minSurplusWatts, "Web UI");

    private string SunUntil(ChargeControlStatus status) => status.SolarGrid switch
    {
        null => Units.Missing,
        { ForecastUsable: false } => PlanText.NoForecast,
        { SunUntil: { } until } => TimeZoneInfo.ConvertTime(until, Time.LocalTimeZone).ToString("HH:mm"),
        _ => PlanText.NoneLeftToday,
    };
}
