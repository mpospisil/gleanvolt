@*
    What every MQTT link has in common (issue #143), rendered as rows of the caller's
    <dl class="facts"> — a component rather than duplicated markup, because the two links must render
    identically or a reader comparing them will read the difference as meaningful.

    The password is a value or it is nothing: whether it may be shown at all was decided by the host,
    which withholds it unless a login is enforced, so there is no policy here to get wrong.
*@

<dt>@SharedText.MqttBroker</dt>
<dd>
    <code>@Connection.Broker</code>
    <span class="muted">@SharedText.MqttBrokerNote</span>
</dd>

<dt>@SharedText.MqttUsername</dt>
<dd>
    @if (string.IsNullOrWhiteSpace(Connection.Username))
    {
        <span class="muted">@SharedText.MqttAnonymous</span>
    }
    else
    {
        <code>@Connection.Username</code>
    }
</dd>

<dt>@SharedText.MqttPassword</dt>
<dd>
    @if (Connection.Password is { } secret)
    {
        <Secret Value="@secret" />
    }
    else if (Connection.PasswordWithheld)
    {
        <span class="muted">
            @Localized.Rich(SharedText.MqttPasswordWithheld, @<code>Web__PasswordHash</code>, @<code>hash-password</code>)
        </span>
    }
    else
    {
        <span class="muted">@SharedText.None</span>
    }
</dd>

<dt>@SharedText.MqttClientId</dt>
<dd><code>@Connection.ClientId</code></dd>

@code {
    [Parameter]
    [EditorRequired]
    public MqttConnectionDisplay Connection { get; set; } = MqttConnectionDisplay.Off;
}
