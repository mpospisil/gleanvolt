@using System.Globalization
@using System.Text.Json
@inject ITariffEditor Editor
@inject IEnumerable<TariffPanelRegistration> Panels
@inject IOptions<WebOptions> Web
@inject Gleanvolt.Web.Auth.WebPasswordState WebPassword

@*
    The tariff (issue #265): when grid energy is cheap. Unlike the installation form above it, a save
    here applies at once -- the schedule asks the selected strategy afresh after every save -- so there
    is no "saved, not applied" to show and no restart to offer.

    The choice is between the strategies this build registers, and each brings its own panel for its
    own settings (TariffPanelRegistration), so a new strategy needs no change here. This form owns what
    they share: the selection, the prices, the check on every keystroke and the save. Switching to
    another strategy and back keeps the first one's settings, here and in the file.

    Read-only without a login, like the installation form: the tariff is what Fast and SolarGrid will
    wait for (#274), so an open UI must not let anyone on the LAN move it.
*@

<section class="controls pv-editor tariff-editor" id="tariff-editor">
    <h2>Tariff</h2>

    <p class="muted">
        When the grid is cheap, so charging can wait for it. Choose where the low-tariff times come
        from; every other minute is high tariff. A save applies at once.
    </p>

    @if (ReadOnly)
    {
        <p class="muted" id="tariff-readonly">
            Read-only, because this UI has no login. Configure <code>Web__PasswordHash</code>
            (<code>hash-password</code>) and the tariff becomes editable here.
        </p>
    }

    <div class="control">
        <span class="control-label" id="tariff-provider-label">Provider</span>
        <div class="seg" role="radiogroup" id="tariff-provider" aria-labelledby="tariff-provider-label">
            @foreach (var provider in Editor.Providers)
            {
                var id = provider.Id;

                <label class="seg-opt">
                    <input type="radio" name="tariff-provider" id="tariff-provider-@Slug(id)" disabled="@ReadOnly"
                           checked="@(_settings.Selects(id))" @onchange="() => Select(id)" />
                    @provider.Name
                </label>
            }
        </div>
        @if (Selected is null)
        {
            <span class="hint error" id="tariff-provider-unknown">
                The saved provider, @_settings.Provider, is not in this build. Choose another one.
            </span>
        }
        else if (IsNone)
        {
            <span class="hint">No tariff: the grid costs the same at every hour.</span>
        }
    </div>

    @if (Selected is { } selected && !IsNone)
    {
        @if (Panels.FirstOrDefault(panel => string.Equals(panel.ProviderId, selected.Id, StringComparison.OrdinalIgnoreCase)) is { } panel)
        {
            @* Keyed by provider and by reload, so switching strategy or Cancel starts the panel afresh from the settings. *@
            <DynamicComponent @key="@($"{selected.Id}/{_generation}")" Type="panel.Component" Parameters="PanelParameters(selected)" />
        }
        else
        {
            <p class="muted" id="tariff-no-panel">@selected.Name has nothing to set here.</p>
        }

        <h3>Prices</h3>

        <div class="pv-fields">
            <div class="pv-field">
                <label for="tariff-low-price">Low tariff price, @Units.PriceUnit(Editor.Currency)</label>
                <input id="tariff-low-price" type="text" inputmode="decimal" autocomplete="off" disabled="@ReadOnly"
                       value="@_lowPrice" @oninput="e => Edit(() => _lowPrice = Text(e))" />
                @if (FieldProblem(TariffFields.LowPrice) is { } low)
                {
                    <span class="hint @(low.IsWarning ? "warning" : "error")">@low.Message</span>
                }
            </div>
            <div class="pv-field">
                <label for="tariff-high-price">High tariff price, @Units.PriceUnit(Editor.Currency)</label>
                <input id="tariff-high-price" type="text" inputmode="decimal" autocomplete="off" disabled="@ReadOnly"
                       value="@_highPrice" @oninput="e => Edit(() => _highPrice = Text(e))" />
                @if (FieldProblem(TariffFields.HighPrice) is { } high)
                {
                    <span class="hint @(high.IsWarning ? "warning" : "error")">@high.Message</span>
                }
            </div>
        </div>
    }

    @if (!ReadOnly)
    {
        <div class="control actions">
            <button type="button" class="primary" id="tariff-save" disabled="@(!_dirty || HasErrors)" @onclick="Save">Save</button>
            <button type="button" class="secondary" id="tariff-cancel" disabled="@(!_dirty)" @onclick="Reload">Cancel</button>
        </div>
    }

    @if (_saveErrors.Count > 0)
    {
        <ul class="error" id="tariff-errors">
            @foreach (var error in _saveErrors)
            {
                <li>@error</li>
            }
        </ul>
    }

    @if (_message is { } message)
    {
        <p class="muted" id="tariff-message">@message</p>
    }
</section>

@code {
    private TariffSettings _settings = TariffSettings.None;
    private string _lowPrice = string.Empty;
    private string _highPrice = string.Empty;
    private IReadOnlyList<TariffProblem> _problems = [];
    private List<string> _saveErrors = [];
    private string? _message;
    private bool _dirty;
    private int _generation;

    // The password in force, not the startup one, so a password set on /setup unlocks this at once.
    private bool ReadOnly => !Web.Value.LoginEnforced(WebPassword);

    private bool HasErrors => _problems.Any(problem => !problem.IsWarning);

    private ITariffProvider? Selected => Editor.Providers.FirstOrDefault(provider => _settings.Selects(provider.Id));

    private bool IsNone => _settings.Selects(TariffProviderIds.None);

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _settings = Editor.Read();
        _lowPrice = Price(_settings.LowPricePerKwh);
        _highPrice = Price(_settings.HighPricePerKwh);
        _saveErrors = [];
        _dirty = false;
        _generation++;
        Check();
    }

    private void Select(string id) => Edit(() => _settings = _settings with { Provider = id });

    // The section the panel handed back replaces the selected strategy's own; every other one is kept.
    private void SectionChanged(string id, JsonElement section) => Edit(() => _settings = _settings.WithSection(id, section));

    private Dictionary<string, object?> PanelParameters(ITariffProvider provider) => new()
    {
        [nameof(TariffProviderPanel.Settings)] = _settings.SectionFor(provider.Id),
        [nameof(TariffProviderPanel.SettingsChanged)] =
            EventCallback.Factory.Create<JsonElement>(this, section => SectionChanged(provider.Id, section)),
        [nameof(TariffProviderPanel.Problems)] = _problems,
        [nameof(TariffProviderPanel.ReadOnly)] = ReadOnly,
    };

    private void Edit(Action change)
    {
        change();
        _dirty = true;
        _message = null;
        _saveErrors = [];
        Check();
    }

    private void Check() => _problems = [.. Editor.Check(Draft()), .. PriceProblems()];

    private void Save()
    {
        if (ReadOnly || HasErrors)
        {
            return;
        }

        var result = Editor.Save(Draft());

        if (!result.Saved)
        {
            _problems = result.Problems;
            _saveErrors = [.. result.Errors.Where(error => error.Field == TariffFields.Provider).Select(error => error.Message)];
            return;
        }

        Reload();
        _message = IsNone ? "Saved. There is no tariff now." : "Saved. The new tariff applies now.";
    }

    // What the form holds, for the check and Save alike. A price that does not parse is left out here
    // and reported by PriceProblems instead.
    private TariffSettings Draft() => _settings with
    {
        LowPricePerKwh = ParsePrice(_lowPrice),
        HighPricePerKwh = ParsePrice(_highPrice),
    };

    private IEnumerable<TariffProblem> PriceProblems()
    {
        if (IsNone)
        {
            yield break;
        }

        if (_lowPrice.Trim().Length > 0 && ParsePrice(_lowPrice) is null)
        {
            yield return new TariffProblem(TariffFields.LowPrice, null, "Not a price.");
        }

        if (_highPrice.Trim().Length > 0 && ParsePrice(_highPrice) is null)
        {
            yield return new TariffProblem(TariffFields.HighPrice, null, "Not a price.");
        }
    }

    // An error before a warning, when a field has both.
    private TariffProblem? FieldProblem(string field) =>
        _problems.Where(problem => problem.Field == field).OrderBy(problem => problem.IsWarning).FirstOrDefault();

    private static string Slug(string id) => id.ToLowerInvariant();

    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? string.Empty;

    private static string Price(decimal? value) => value?.ToString("0.00##", CultureInfo.InvariantCulture) ?? string.Empty;

    // A comma is accepted as the decimal point too: it is what a Czech keyboard types.
    private static decimal? ParsePrice(string text) =>
        decimal.TryParse(text.Trim().Replace(',', '.'), NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign,
            CultureInfo.InvariantCulture, out var value)
            ? value
            : null;
}
