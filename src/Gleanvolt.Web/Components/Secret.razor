@inject IJSRuntime JS

@*
    A configured secret, shown to somebody who is already signed in (issue #143).

    Masked by default and revealed on request, because the two threats are different: the reason this
    value may be on the page at all is that a login is enforced, and the reason it starts hidden is
    that a shoulder and a screenshot are not the network. The caller decides whether the secret may be
    rendered at all -- this component is handed a value or it is not used -- so there is no policy
    here, only presentation.
*@

<span class="secret">
    <code>@(_revealed ? Value : Mask)</code>
    <button type="button" class="link" @onclick="Toggle">@(_revealed ? "Hide" : "Reveal")</button>
    <button type="button" class="link" @onclick="CopyAsync">@(_copied ? "Copied" : "Copy")</button>
</span>

@code {
    // A fixed width rather than one dot per character: the length of a secret is a hint about the
    // secret, and a broker password is short enough for that to matter.
    private const string Mask = "••••••••••••";

    private bool _revealed;
    private bool _copied;

    /// <summary>The secret itself. Never rendered until the reader asks for it.</summary>
    [Parameter]
    [EditorRequired]
    public string Value { get; set; } = string.Empty;

    private void Toggle()
    {
        _revealed = !_revealed;
        _copied = false;
    }

    private async Task CopyAsync()
    {
        // Copy works whether or not the value is revealed -- pasting it into a config file is the
        // actual task, and making somebody display it on screen first would be a step in the wrong
        // direction.
        _copied = await JS.InvokeAsync<bool>("gleanvolt.copyToClipboard", Value);
    }
}
