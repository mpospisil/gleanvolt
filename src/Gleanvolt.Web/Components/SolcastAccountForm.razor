@implements IDisposable
@inject ISolcastAccountEditor Editor
@inject IOptions<WebOptions> Web
@inject Gleanvolt.Web.Auth.WebPasswordState WebPassword
@inject TimeProvider Time

@*
    The Solcast account (issue #286): the API key and the rooftop site the forecast is fetched for.
    Like the tariff and unlike the installation form above, a save applies at once -- the forecast
    service reads the account on every fetch -- so there is no restart to offer. That matters more here
    than anywhere: a restart spends one of the day's calls.

    A save is a fetch, and the fetch is the check. There is no separate "test the key" call to spend, and
    the status line under the heading says what Solcast made of it. The line also redraws on the worker's
    own fetches, which is why the form listens to Changed.

    The key box is always empty, on every load and after every save, as the car's password is: a field
    that rendered its value back would put the key on the wire for every browser that opened the page.
    The key in use is behind Secret instead, and only behind a login.
*@

<section class="controls pv-editor solcast-editor" id="solcast-editor">
    <div class="section-head tip-head">
        <h2>@SettingsText.SolarForecast</h2>
        <InfoTip Topic="@SettingsText.SolcastTopic" Group="settings-info" Wide="true">
            <p>
                @SettingsText.SolcastTip1
            </p>
            <p>
                @Localized.Rich(SettingsText.SolcastTip2, @<strong>@SettingsText.SolcastTip2_0</strong>, @<code>dotnet run</code>)
            </p>
            <p>
                @Localized.Rich(SettingsText.SolcastTip3, @<code>SOLCAST_API_KEY</code>, @<code>SOLCAST_RESOURCE_ID</code>, @<code>.env</code>)
            </p>
        </InfoTip>
    </div>

    <p class="muted">
        @SettingsText.SolcastIntro
    </p>

    <p class="@(_settings.Status.Failure == SolcastFetchFailure.None ? "muted" : "error")" id="solcast-status" role="status">
        @StatusLine()
    </p>

    @if (ReadOnly)
    {
        <p class="muted" id="solcast-readonly">
            @Localized.Rich(SettingsText.SolcastReadOnly, @<code>Web__PasswordHash</code>, @<code>hash-password</code>, @<code>SOLCAST_API_KEY</code>, @<code>SOLCAST_RESOURCE_ID</code>, @<code>.env</code>)
        </p>
    }
    else
    {
        <div class="pv-fields">
            <div class="pv-field">
                <label for="solcast-api-key">@SettingsText.ApiKey</label>
                <input id="solcast-api-key" type="password" autocomplete="new-password" spellcheck="false"
                       placeholder="@(_settings.IsConfigured ? SettingsText.Unchanged : SettingsText.NotSet)"
                       disabled="@_busy"
                       value="@_apiKey"
                       @oninput="e => Edit(() => _apiKey = Text(e))" />
                <span class="source @(_settings.Source == SolcastAccountSource.Page ? "edited" : null)" id="solcast-source">
                    @SourceName()
                </span>
                @if (_settings.IsConfigured)
                {
                    <div id="solcast-key-in-use"><Secret Value="@_settings.ApiKey" /></div>
                }
                <span class="hint">
                    @Localized.Format(SettingsText.KeptInSecretStore, Localized.Say(_settings.SecretProtectionPhrase, _settings.SecretProtection))
                </span>
            </div>

            <div class="pv-field">
                <label for="solcast-resource-id">@SettingsText.ResourceId</label>
                <input id="solcast-resource-id" type="text" autocomplete="off" spellcheck="false"
                       disabled="@_busy"
                       value="@_resourceId"
                       @oninput="e => Edit(() => _resourceId = Text(e))" />
            </div>
        </div>

        <div class="control actions">
            <button type="button" class="primary" id="solcast-save" disabled="@(_busy || !HasChanges)" @onclick="SaveAsync">
                @(_busy ? SettingsText.Fetching : SettingsText.SaveAndFetch)
            </button>
            @if (_settings.Source == SolcastAccountSource.Page)
            {
                <button type="button" class="secondary" id="solcast-remove" disabled="@_busy" @onclick="Remove">@SettingsText.Remove</button>
            }
        </div>
    }

    @if (_errors.Count > 0)
    {
        <ul class="error" id="solcast-errors">
            @foreach (var error in _errors)
            {
                <li>@error</li>
            }
        </ul>
    }

    @if (_message is { } message)
    {
        <p class="muted" id="solcast-message">@message</p>
    }
</section>

@code {
    // The viewer's culture, for the renders the poll and other threads ask for (#290).
    private readonly ViewerCulture _viewer = new();

    private SolcastAccountSettings _settings = new(
        SolcastAccountSource.None, string.Empty, string.Empty, false, string.Empty, SolcastFetchStatus.Never);

    private string _apiKey = string.Empty;
    private string _resourceId = string.Empty;
    private IReadOnlyList<string> _errors = [];
    private string? _message;
    private bool _busy;

    // The password in force, not the startup one, so a password set on /setup unlocks this at once.
    private bool ReadOnly => !Web.Value.LoginEnforced(WebPassword);

    // Nothing to save means nothing to spend a call on: an unchanged account is not fetched again.
    private bool HasChanges =>
        _apiKey.Trim().Length > 0
        || !string.Equals(_resourceId.Trim(), _settings.ResourceId, StringComparison.Ordinal);

    protected override void OnInitialized()
    {
        Reload();
        Editor.Changed += OnChanged;
    }

    public void Dispose() => Editor.Changed -= OnChanged;

    // Only the status and the source move under the owner's feet; what is typed in the boxes stays.
    private void OnChanged() => _ = InvokeAsync(_viewer.Wrap(() =>
    {
        _settings = Editor.Read();
        StateHasChanged();
    }));

    private void Reload()
    {
        _settings = Editor.Read();
        _apiKey = string.Empty;
        _resourceId = _settings.ResourceId;
    }

    private void Edit(Action change)
    {
        change();
        _message = null;
        _errors = [];
    }

    private async Task SaveAsync()
    {
        if (ReadOnly || _busy || !HasChanges)
        {
            return;
        }

        _busy = true;
        _message = null;
        _errors = [];

        try
        {
            var result = await Editor.SaveAsync(_apiKey, _resourceId);

            if (!result.Saved)
            {
                _errors = Localized.Say(result.Errors, result.ErrorPhrases);
                return;
            }

            Reload();
            _message = result.Persisted
                ? SettingsText.SavedInUse
                : SettingsText.InUseNotKept;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Remove()
    {
        if (ReadOnly || _busy)
        {
            return;
        }

        Editor.Remove();
        Reload();
        _errors = [];
        _message = _settings.IsConfigured
            ? SettingsText.RemovedEnvironment
            : SettingsText.RemovedNone;
    }

    private string SourceName() => _settings.Source switch
    {
        SolcastAccountSource.Page => SettingsText.SourcePage,
        SolcastAccountSource.Environment => SettingsText.SourceEnvironmentSolcast,
        _ => SettingsText.NotConfigured,
    };

    private string StatusLine()
    {
        var status = _settings.Status;

        if (!_settings.IsConfigured)
        {
            return SettingsText.NotConfiguredNoForecast;
        }

        var held = status.FetchedAt is { } fetched ? " " + Localized.Format(SettingsText.StillInUse, When(fetched)) : string.Empty;

        return status.Failure switch
        {
            SolcastFetchFailure.KeyRefused =>
                Localized.Format(SettingsText.KeyRefused, status.HttpStatus, When(status.FailedAt), held),
            SolcastFetchFailure.SiteNotFound =>
                Localized.Format(SettingsText.SiteNotFound, _settings.ResourceId, status.HttpStatus, When(status.FailedAt), held),
            SolcastFetchFailure.QuotaExhausted =>
                Localized.Format(SettingsText.QuotaExhausted, status.HttpStatus, When(status.FailedAt), held),
            SolcastFetchFailure.Other =>
                Localized.Format(SettingsText.FetchFailed, When(status.FailedAt), held),
            _ when status.FetchedAt is { } at => Localized.Format(SettingsText.FetchedAt, When(at)),
            _ => SettingsText.NothingFetched,
        };
    }

    // "at 14:05" today, "on Mon 14:05" any other day: the status of a forecast that is days old is
    // worth knowing is days old.
    private string When(DateTimeOffset? instant)
    {
        if (instant is not { } value)
        {
            return string.Empty;
        }

        var zone = Time.LocalTimeZone;
        var local = TimeZoneInfo.ConvertTime(value, zone);
        var today = TimeZoneInfo.ConvertTime(Time.GetUtcNow(), zone).Date;

        return local.Date == today
            ? Localized.Format(SettingsText.AtTime, local)
            : Localized.Format(SettingsText.OnDayTime, local.ToString(SharedText.DayTimePattern, System.Globalization.CultureInfo.CurrentCulture));
    }

    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? string.Empty;
}
