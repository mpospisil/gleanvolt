@inject IPvSystemEditor Editor
@inject IOptions<WebOptions> Web
@inject Gleanvolt.Web.Auth.WebPasswordState WebPassword

@*
    The installation, editable (issue #204). Everything below this form on /pv-system is what the process
    is running with; this is what the next start will read. The two are kept apart on purpose: the
    running PvSystemInfo and the Modbus clients built from it are a decision already made, and a save
    never touches them. It writes the web UI's overrides file, and a restart applies it.

    Each field says where its value comes from, because the file wins over .env: a value set here and
    forgotten is exactly the thing that makes ".env isn't working" a mystery. Revert takes a key back
    out of the file.
*@

<section class="controls pv-editor" id="pv-editor">
    <div class="section-head tip-head">
        <h2>@SettingsText.Installation</h2>
        <InfoTip Topic="@SettingsText.SavingTopic" Group="settings-info">
            <p>
                @Localized.Rich(SettingsText.SavingTip1, @<code>@_settings.OverridesPath</code>, @<code>.env</code>)
            </p>
            <p>
                @SettingsText.SavingTip2
            </p>
        </InfoTip>
    </div>

    @if (_pending.Count > 0)
    {
        <div class="restart-banner" id="pv-pending" role="status">
            <span>
                <strong>@Localized.Format(Localized.Plural(_pending.Count, SettingsText.ChangesSaved_One, SettingsText.ChangesSaved_Few, SettingsText.ChangesSaved_Other), _pending.Count)</strong>
                @SettingsText.NotRunningUntilRestart
            </span>
            <a class="button-link" href="/settings/health">@SettingsText.RestartOnHealth</a>
        </div>
    }

    @if (_settings.Unavailable is { } unavailable)
    {
        <p class="error" id="pv-unavailable">@unavailable</p>
    }
    else if (ReadOnly)
    {
        <p class="muted" id="pv-readonly">
            @Localized.Rich(SettingsText.ReadOnlyNoLogin, @<code>Web__PasswordHash</code>, @<code>hash-password</code>, @<code>.env</code>)
        </p>
    }

    @foreach (var (section, group, keys) in Groups.Where(entry => Sections is null || Sections.Contains(entry.Section)))
    {
        <h3>@group</h3>

        <div class="pv-fields">
            @foreach (var key in keys)
            {
                var setting = _settings[key];
                var id = "pv-" + key.Replace(':', '-');

                <div class="pv-field">
                    <div class="field-head">
                        <label for="@id">@Labels[key]</label>
                        <InfoTip Topic="@Labels[key]" Group="settings-info">
                            <p>@Localized.Format(SettingsText.CurrentValueFrom, SourcePhrase(setting))</p>
                            <p>@SourceTitle(setting)</p>
                        </InfoTip>
                    </div>
                    <input id="@id" type="text" spellcheck="false" autocomplete="off"
                           placeholder="@Hints.GetValueOrDefault(key)"
                           disabled="@(!Editable || _busy)"
                           value="@_values[key]"
                           @oninput="e => _values[key] = e.Value?.ToString() ?? string.Empty" />
                    @if (Note(key, _values[key]) is { } note)
                    {
                        <span class="field-note">@note</span>
                    }
                    @if (setting.IsPending)
                    {
                        <span class="field-pending">@Localized.Format(SettingsText.RunningRestartToApply, Show(setting.Running))</span>
                    }
                    @if (setting.IsEdited && Editable)
                    {
                        <button type="button" class="link revert" disabled="@_busy" @onclick="() => Revert(key)">
                            @Localized.Format(SettingsText.RevertTo, Show(setting.Underlying))
                        </button>
                    }
                </div>
            }
        </div>
    }

    @if (_warnings.Count > 0)
    {
        <div class="control" id="pv-warnings">
            @foreach (var warning in _warnings)
            {
                <p class="error">@warning</p>
            }
            <button type="button" class="danger" id="pv-save-anyway" @onclick="() => SaveAsync(confirmed: true)">@SettingsText.SaveAnyway</button>
            <button type="button" class="secondary" @onclick="() => _warnings = []">Cancel</button>
        </div>
    }
    else if (Editable)
    {
        <div class="control actions">
            <button type="button" class="primary" id="pv-save" disabled="@(_busy || Edits().Count == 0)"
                    @onclick="() => SaveAsync(confirmed: false)">
                @(_busy ? SettingsText.Checking : SettingsText.SaveButton)
            </button>
            <button type="button" class="secondary" disabled="@(_busy || Edits().Count == 0)" @onclick="Discard">
                @SettingsText.DiscardChanges
            </button>
        </div>
    }

    @if (_probes.Count > 0)
    {
        <ul class="probes" id="pv-probes">
            @foreach (var (role, probe) in _probes)
            {
                <li class="@(probe.Answered && probe.Plausible ? null : "error")">@role: @Localized.Say(probe.MessagePhrase, probe.Message)</li>
            }
        </ul>
        @if (_probes.Any(entry => !entry.Result.Answered || !entry.Result.Plausible))
        {
            <p class="table-note muted">
                @SettingsText.SavedAnyway
            </p>
        }
    }

    @if (_problems.Count > 0)
    {
        <div id="pv-problems">
            <p class="error">@SettingsText.NotSaved</p>
            <ul class="error">
                @foreach (var problem in _problems)
                {
                    <li>@problem</li>
                }
            </ul>
        </div>
    }

    @if (_message is { } message)
    {
        <p class="muted" id="pv-message">@message</p>
    }
</section>

@code {
    private const string Missing = Units.Missing;

    /// <summary>
    /// Which groups to show; all of them when null. The setup wizard (#302) shows the devices on one
    /// step and the site on another, through this one form rather than a copy of it.
    /// </summary>
    [Parameter] public IReadOnlyCollection<PvEditorSection>? Sections { get; set; }

    /// <summary>
    /// Values to put in the fields, as though typed: the wizard's device search fills the addresses it
    /// found. Applied when a new dictionary arrives; nothing is saved until Save is pressed.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, string>? Suggested { get; set; }

    /// <summary>Raised after a save that wrote something.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    private IReadOnlyDictionary<string, string>? _applied;

    protected override void OnParametersSet()
    {
        if (Suggested is null || ReferenceEquals(Suggested, _applied))
        {
            return;
        }

        _applied = Suggested;
        foreach (var (key, value) in Suggested)
        {
            if (_values.ContainsKey(key))
            {
                _values[key] = value;
            }
        }
    }

    private static (PvEditorSection Section, string Group, string[] Keys)[] Groups =>
    [
        (PvEditorSection.Identity, SettingsText.GroupIdentity, [PvSystemSettingKeys.Id, PvSystemSettingKeys.Name, PvSystemSettingKeys.Address, PvSystemSettingKeys.InstallDate]),
        (PvEditorSection.Location, SettingsText.GroupLocation, [PvSystemSettingKeys.Latitude, PvSystemSettingKeys.Longitude, PvSystemSettingKeys.TimeZone, PvSystemSettingKeys.AzimuthDegrees, PvSystemSettingKeys.TiltDegrees]),
        (PvEditorSection.Capacity, SettingsText.GroupCapacity, [PvSystemSettingKeys.CapacityKwp, PvSystemSettingKeys.InverterCapacityKw, PvSystemSettingKeys.LossFactor]),
        (PvEditorSection.HomeBattery, SettingsText.GroupHomeBattery, [PvSystemSettingKeys.HomeBatteryCapacityKWh, PvSystemSettingKeys.HomeBatteryChargeEfficiency]),
        (PvEditorSection.Inverter, SettingsText.Inverter, [PvSystemSettingKeys.InverterModel, PvSystemSettingKeys.InverterHost, PvSystemSettingKeys.InverterPort, PvSystemSettingKeys.InverterUnitId, PvSystemSettingKeys.InverterUnmeteredGridPhase]),
        (PvEditorSection.Charger, SettingsText.Charger, [PvSystemSettingKeys.ChargerId, PvSystemSettingKeys.ChargerModel, PvSystemSettingKeys.ChargerHost, PvSystemSettingKeys.ChargerPort, PvSystemSettingKeys.ChargerUnitId]),
    ];

    private static Dictionary<string, string> Labels => new(StringComparer.OrdinalIgnoreCase)
    {
        [PvSystemSettingKeys.Id] = SettingsText.FieldId,
        [PvSystemSettingKeys.Name] = SettingsText.FieldName,
        [PvSystemSettingKeys.Address] = SettingsText.FieldAddress,
        [PvSystemSettingKeys.InstallDate] = SettingsText.FieldCommissioned,
        [PvSystemSettingKeys.Latitude] = SettingsText.FieldLatitude,
        [PvSystemSettingKeys.Longitude] = SettingsText.FieldLongitude,
        [PvSystemSettingKeys.AzimuthDegrees] = SettingsText.FieldAzimuth,
        [PvSystemSettingKeys.TiltDegrees] = SettingsText.FieldTilt,
        [PvSystemSettingKeys.CapacityKwp] = SettingsText.FieldCapacityKwp,
        [PvSystemSettingKeys.InverterCapacityKw] = SettingsText.FieldInverterCapacity,
        [PvSystemSettingKeys.LossFactor] = SettingsText.FieldLossFactor,
        [PvSystemSettingKeys.TimeZone] = SettingsText.FieldTimeZone,
        [PvSystemSettingKeys.HomeBatteryCapacityKWh] = SettingsText.FieldHomeBatteryCapacity,
        [PvSystemSettingKeys.HomeBatteryChargeEfficiency] = SettingsText.FieldHomeBatteryEfficiency,
        [PvSystemSettingKeys.InverterModel] = SettingsText.FieldInverterModel,
        [PvSystemSettingKeys.InverterHost] = SettingsText.FieldInverterHost,
        [PvSystemSettingKeys.InverterPort] = SettingsText.FieldInverterPort,
        [PvSystemSettingKeys.InverterUnitId] = SettingsText.FieldInverterUnitId,
        [PvSystemSettingKeys.InverterUnmeteredGridPhase] = SettingsText.FieldUnmeteredPhase,
        [PvSystemSettingKeys.ChargerId] = SettingsText.FieldChargerId,
        [PvSystemSettingKeys.ChargerModel] = SettingsText.FieldChargerModel,
        [PvSystemSettingKeys.ChargerHost] = SettingsText.FieldChargerHost,
        [PvSystemSettingKeys.ChargerPort] = SettingsText.FieldChargerPort,
        [PvSystemSettingKeys.ChargerUnitId] = SettingsText.FieldChargerUnitId,
    };

    private static Dictionary<string, string> Hints => new(StringComparer.OrdinalIgnoreCase)
    {
        [PvSystemSettingKeys.Id] = SettingsText.HintId,
        [PvSystemSettingKeys.InstallDate] = "yyyy-MM-dd",
        [PvSystemSettingKeys.Latitude] = SettingsText.HintDecimalDegrees,
        [PvSystemSettingKeys.Longitude] = SettingsText.HintDecimalDegrees,
        [PvSystemSettingKeys.AzimuthDegrees] = SettingsText.HintAzimuth,
        [PvSystemSettingKeys.TiltDegrees] = SettingsText.HintTilt,
        [PvSystemSettingKeys.LossFactor] = SettingsText.HintLossFactor,
        [PvSystemSettingKeys.TimeZone] = SettingsText.HintTimeZone,
        [PvSystemSettingKeys.HomeBatteryCapacityKWh] = SettingsText.HintHomeBatteryCapacity,
        [PvSystemSettingKeys.HomeBatteryChargeEfficiency] = SettingsText.HintHomeBatteryEfficiency,
        [PvSystemSettingKeys.InverterUnmeteredGridPhase] = SettingsText.HintPhase,
        [PvSystemSettingKeys.InverterPort] = "502",
        [PvSystemSettingKeys.ChargerPort] = "502",
        [PvSystemSettingKeys.InverterUnitId] = "1",
        [PvSystemSettingKeys.ChargerUnitId] = "1",
    };

    private static readonly string[] InverterAddress =
        [PvSystemSettingKeys.InverterHost, PvSystemSettingKeys.InverterPort, PvSystemSettingKeys.InverterUnitId];

    private static readonly string[] ChargerAddress =
        [PvSystemSettingKeys.ChargerHost, PvSystemSettingKeys.ChargerPort, PvSystemSettingKeys.ChargerUnitId];

    private PvSystemSettings _settings = new(string.Empty, []);
    private Dictionary<string, string> _values = [];
    private List<ConfiguredSetting> _pending = [];
    private IReadOnlyList<string> _problems = [];
    private List<string> _warnings = [];
    private List<(string Role, DeviceProbeResult Result)> _probes = [];
    private string? _message;
    private bool _busy;

    // Editing device addresses redirects Modbus writes, so an open UI shows the form without letting
    // anyone use it. Restart is not held to this: it follows Stop, which an open UI already offers.
    // The password in force, not the startup one, so a password set on /setup unlocks this at once.
    private bool ReadOnly => !Web.Value.LoginEnforced(WebPassword);

    private bool Editable => !ReadOnly && _settings.Unavailable is null;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _settings = Editor.Read();
        _values = _settings.Settings.ToDictionary(
            setting => setting.Key, setting => setting.Saved ?? string.Empty, StringComparer.OrdinalIgnoreCase);
        _pending = [.. _settings.Pending];
    }

    // What the form holds that the next start would not already read.
    private Dictionary<string, string> Edits() =>
        _settings.Settings
            .Where(setting => _values.TryGetValue(setting.Key, out var value)
                && !string.Equals(value.Trim(), setting.Saved ?? string.Empty, StringComparison.Ordinal))
            .ToDictionary(setting => setting.Key, setting => _values[setting.Key].Trim(), StringComparer.OrdinalIgnoreCase);

    private async Task SaveAsync(bool confirmed)
    {
        var edits = Edits();

        if (edits.Count == 0)
        {
            return;
        }

        _message = null;
        _problems = [];

        if (!confirmed)
        {
            var warnings = Warnings(edits);

            if (warnings.Count > 0)
            {
                _warnings = warnings;
                return;
            }
        }

        _warnings = [];
        _busy = true;

        try
        {
            _probes = await ProbeAsync(edits);

            var result = Editor.Save(edits);

            if (!result.Saved)
            {
                _problems = Localized.Say(result.Problems, result.ProblemPhrases);
                return;
            }

            Reload();
            _message = _pending.Count > 0
                ? SettingsText.SavedRestart
                : SettingsText.SavedRunning;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void Revert(string key)
    {
        _message = null;
        _probes = [];
        var result = Editor.Revert(key);

        if (!result.Saved)
        {
            _problems = Localized.Say(result.Problems, result.ProblemPhrases);
            return;
        }

        _problems = [];
        Reload();
        _message = $"{Labels[key]} reverted; it comes from {SourceName(_settings[key])} again.";
    }

    private void Discard()
    {
        _problems = [];
        _warnings = [];
        _message = null;
        Reload();
    }

    // Changes that are allowed but cost something the form cannot show: asked for once, then saved.
    private List<string> Warnings(Dictionary<string, string> edits)
    {
        var warnings = new List<string>();

        if (edits.ContainsKey(PvSystemSettingKeys.Id))
        {
            warnings.Add(
                SettingsText.IdWarning);
        }

        if ((edits.TryGetValue(PvSystemSettingKeys.Latitude, out var latitude) && latitude.Length == 0)
            || (edits.TryGetValue(PvSystemSettingKeys.Longitude, out var longitude) && longitude.Length == 0))
        {
            warnings.Add(
                SettingsText.CoordinatesWarning);
        }

        return warnings;
    }

    // One read against each device whose address changed, before the save: a swapped inverter and
    // charger is invisible until it is running, and then it looks like a frozen battery.
    private async Task<List<(string Role, DeviceProbeResult Result)>> ProbeAsync(Dictionary<string, string> edits)
    {
        var probes = new List<(string, DeviceProbeResult)>();

        if (InverterAddress.Any(edits.ContainsKey) && Address(InverterAddress) is { } inverter)
        {
            probes.Add((SettingsText.Inverter, await Editor.ProbeAsync(PvDeviceRole.Inverter, inverter.Host, inverter.Port, inverter.UnitId)));
        }

        if (ChargerAddress.Any(edits.ContainsKey) && Address(ChargerAddress) is { } charger)
        {
            probes.Add((SettingsText.Charger, await Editor.ProbeAsync(PvDeviceRole.Charger, charger.Host, charger.Port, charger.UnitId)));
        }

        return probes;
    }

    // The address as the form now has it, with the same defaults the device options take; null when it
    // is not one the resolver would accept, which the save will say better than a probe could.
    private (string Host, int Port, byte UnitId)? Address(string[] keys)
    {
        var host = _values[keys[0]].Trim();
        var port = _values[keys[1]].Trim();
        var unit = _values[keys[2]].Trim();

        if (host.Length == 0)
        {
            return null;
        }

        var portNumber = 502;
        byte unitId = 1;

        if ((port.Length > 0 && !int.TryParse(port, out portNumber))
            || (unit.Length > 0 && !byte.TryParse(unit, out unitId)))
        {
            return null;
        }

        return (host, portNumber, unitId);
    }

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? Missing : value;

    private static string SourceName(ConfiguredSetting setting) => setting.Source switch
    {
        SettingSource.WebUi => SettingsText.SourceWebUi,
        SettingSource.Environment => SettingsText.SourceEnvironment,
        SettingSource.CommandLine => SettingsText.SourceCommandLine,
        SettingSource.AppSettings => string.IsNullOrEmpty(setting.SourceDetail) ? "appsettings.json" : setting.SourceDetail,
        _ => SettingsText.SourceDefault,
    };

    private static string SourcePhrase(ConfiguredSetting setting) => setting.Source switch
    {
        SettingSource.WebUi => SettingsText.PhraseThisPage,
        SettingSource.Environment => SettingsText.PhraseEnvironment,
        SettingSource.CommandLine => SettingsText.PhraseCommandLine,
        SettingSource.AppSettings => SourceName(setting),
        _ => SettingsText.PhraseDefault,
    };

    // What a typed value means where it does not say so itself: a bearing outside 0-360, or SolaX's
    // R/S/T for a phase, which is what the inverter's display shows and what an installer is likely to
    // type. Null when the value says it plainly, or is one the save will refuse anyway.
    private static string? Note(string key, string value)
    {
        value = value.Trim();

        if (key == PvSystemSettingKeys.AzimuthDegrees
            && double.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var bearing))
        {
            var normalised = ((bearing % 360) + 360) % 360;
            var facing = Localized.Format(SettingsText.Facing, Compass[(int)Math.Round(normalised / 45) % Compass.Length]);
            return normalised == bearing ? facing : Localized.Format(SettingsText.BearingNormalised, Units.Angle(normalised), facing);
        }

        if (key == PvSystemSettingKeys.InverterUnmeteredGridPhase)
        {
            return value.ToUpperInvariant() switch
            {
                "R" => SettingsText.PhaseR,
                "S" => SettingsText.PhaseS,
                "T" => SettingsText.PhaseT,
                _ => null,
            };
        }

        return null;
    }

    private static string[] Compass =>
        [SettingsText.North, SettingsText.NorthEast, SettingsText.East, SettingsText.SouthEast, SettingsText.South, SettingsText.SouthWest, SettingsText.West, SettingsText.NorthWest];

    private static string SourceTitle(ConfiguredSetting setting) => setting.Source switch
    {
        SettingSource.WebUi => Localized.Format(SettingsText.TitleWebUi, setting.SourceDetail),
        SettingSource.Environment =>
            Localized.Format(SettingsText.TitleEnvironment, setting.SourceDetail),
        SettingSource.CommandLine => SettingsText.TitleCommandLine,
        SettingSource.AppSettings => Localized.Format(SettingsText.TitleAppSettings, SourceName(setting)),
        _ => SettingsText.TitleDefault,
    };
}
