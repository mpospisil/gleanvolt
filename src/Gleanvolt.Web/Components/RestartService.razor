@inject IServiceShutdown Shutdown
@inject IJSRuntime JS

@*
    Restart, with its confirmation (issue #204). One component because it has two homes -- Health, next
    to Stop, and the pending-changes banner on /pv-system -- and the sentence it has to say before the
    click is the same in both and easy to let drift.

    Two clicks, like Stop, but for a different reason: nothing is lost, and it comes back by itself
    where a restart policy is watching. What the confirmation is for is the cost -- a charge that pauses,
    half a minute without a controller, a Solcast call spent -- and the one host where it does not come
    back at all.
*@

@if (_restarting && !Shutdown.RestartsByItself)
{
    @* Nothing on this host brings the process back (#301): the Windows zip, winget, dotnet run. A
       page that said "restarting" would leave the owner waiting for something that never happens. *@
    <p class="stopping" id="restart-progress">
        @SharedText.RestartManual
    </p>
}
else if (_restarting)
{
    <p class="stopping" id="restart-progress">
        @SharedText.RestartProgress
    </p>
    <span class="hint">
        @Localized.Rich(SharedText.RestartNotBack, @<code>docker ps -a</code>, @<code>systemctl status gleanvolt</code>)
    </span>
}
else if (_confirming)
{
    <label>@SharedText.RestartQuestion</label>
    <button type="button" class="danger" id="restart-confirm" @onclick="ConfirmAsync">@SharedText.RestartConfirm</button>
    <button type="button" class="secondary" @onclick="() => _confirming = false">@SharedText.Cancel</button>
    <span class="hint">
        @Localized.Rich(SharedText.RestartCost, @<code>restart: on-failure</code>, @<code>dotnet run</code>, @<code>docker run</code>)
    </span>
}
else
{
    <label>@(Label ?? SharedText.RestartLabel)</label>
    <button type="button" class="secondary restart" id="restart" @onclick="() => _confirming = true">@SharedText.Restart</button>
    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <span class="hint">@Hint</span>
    }
}

@code {
    /// <summary>What the button's line is called where it sits.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>A line under the button before it is pressed; none when empty.</summary>
    [Parameter]
    public string? Hint { get; set; }

    private bool _confirming;
    private bool _restarting;

    private async Task ConfirmAsync()
    {
        _confirming = false;
        _restarting = true;

        // The browser starts watching before the server goes away, so the reload does not depend on the
        // circuit surviving long enough to ask for it. A browser that has no script to run it is left
        // with Blazor's own reconnect prompt, which is where it would have been anyway.
        if (Shutdown.RestartsByItself)
        {
            try
            {
                await JS.InvokeVoidAsync("gleanvolt.reloadAfterRestart");
            }
            catch (JSException)
            {
            }
        }

        Shutdown.RequestRestart("Web UI");
    }
}
