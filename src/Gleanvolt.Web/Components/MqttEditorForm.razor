@inject IIntegrationsEditor Editor
@inject IOptions<WebOptions> Web
@inject Gleanvolt.Web.Auth.WebPasswordState WebPassword

@*
    The Home Assistant link: the MQTT broker Gleanvolt publishes its state and controls to. Like the
    installation's form, a save is for the next start -- the worker connects once with what it was
    given -- so each field says what is running until a restart applies it. The password is a secret:
    it goes to the secret store, never to the overrides file, and the box is always empty.

    "Test connection" connects once with what the form holds, under a client id of its own, so it never
    knocks the running link off the broker.
*@

<section class="controls pv-editor mqtt-editor" id="mqtt-editor">
    <div class="section-head">
        <h2>@SettingsText.HomeAssistantLink</h2>
    </div>

    <p class="muted">@SettingsText.MqttEditorIntro</p>

    @if (Pending > 0)
    {
        <div class="restart-banner" id="mqtt-pending" role="status">
            <span>
                <strong>@Localized.Format(Localized.Plural(Pending, SettingsText.ChangesSaved_One, SettingsText.ChangesSaved_Few, SettingsText.ChangesSaved_Other), Pending)</strong>
                @SettingsText.NotRunningUntilRestart
            </span>
            <a class="button-link" href="/settings/health">@SettingsText.RestartOnHealth</a>
        </div>
    }

    @if (_settings.Unavailable is { } unavailable)
    {
        <p class="error" id="mqtt-unavailable">@unavailable</p>
    }
    else if (ReadOnly)
    {
        <p class="muted" id="mqtt-readonly">
            @Localized.Rich(SettingsText.IntegrationsReadOnly, @<code>Web__PasswordHash</code>, @<code>hash-password</code>, @<code>.env</code>)
        </p>
    }

    <div class="control">
        <label class="check">
            <input type="checkbox" id="mqtt-enabled" disabled="@(!Editable || _busy)"
                   checked="@_enabled" @onchange="e => { _enabled = e.Value is true; Touch(); }" />
            @SettingsText.FieldMqttEnabled
        </label>
        <SettingPending Setting="_settings[IntegrationSettingKeys.MqttEnabled]" Editable="Editable" OnRevert="Revert" />
    </div>

    <div class="pv-fields">
        @foreach (var (key, label, hint) in Fields)
        {
            var setting = _settings[key];
            var id = "mqtt-" + key.Split(':')[^1].ToLowerInvariant();

            <div class="pv-field">
                <label for="@id">@label</label>
                <input id="@id" type="text" spellcheck="false" autocomplete="off"
                       placeholder="@hint"
                       disabled="@(!Editable || _busy)"
                       value="@_values[key]"
                       @oninput="e => { _values[key] = e.Value?.ToString() ?? string.Empty; Touch(); }" />
                <span class="source @(setting.IsEdited ? "edited" : null)">@SettingSources.Name(setting)</span>
                <SettingPending Setting="setting" Editable="Editable" OnRevert="Revert" />
            </div>
        }

        <div class="pv-field">
            <label for="mqtt-password">@SettingsText.FieldMqttPassword</label>
            <RevealInput Disabled="!Editable">
                <input id="mqtt-password" type="password" autocomplete="new-password" spellcheck="false"
                       placeholder="@(_settings.MqttPassword.IsSet ? SettingsText.Unchanged : SettingsText.NotSet)"
                       disabled="@(!Editable || _busy)"
                       value="@_password"
                       @oninput="e => { _password = e.Value?.ToString() ?? string.Empty; Touch(); }" />
            </RevealInput>
            <span class="source @(_settings.MqttPassword.Source == SettingSource.SecretStore ? "edited" : null)" id="mqtt-password-source">
                @(_settings.MqttPassword.IsSet ? SettingSources.Name(_settings.MqttPassword.Source) : SettingsText.NotSet)
            </span>
            @if (_settings.MqttPassword.IsPending)
            {
                <span class="field-pending">@SettingsText.PasswordRestartToApply</span>
            }
            <span class="hint">
                @Localized.Format(SettingsText.PasswordKeptInSecretStore, Localized.Say(_settings.SecretProtectionPhrase, _settings.SecretProtection))
            </span>
            @if (Editable && _settings.MqttPassword.Source == SettingSource.SecretStore)
            {
                <button type="button" class="link revert" id="mqtt-password-remove" disabled="@_busy" @onclick="RemovePassword">
                    @SettingsText.RemovePassword
                </button>
            }
        </div>
    </div>

    @if (Editable)
    {
        <div class="control actions">
            <button type="button" class="primary" id="mqtt-save" disabled="@(_busy || !HasEdits)" @onclick="Save">
                @SettingsText.SaveButton
            </button>
            <button type="button" class="secondary" id="mqtt-test" disabled="@(_busy || _values[IntegrationSettingKeys.MqttBrokerHost].Trim().Length == 0)" @onclick="TestAsync">
                @(_testing ? SettingsText.Testing : SettingsText.TestConnection)
            </button>
            <button type="button" class="secondary" disabled="@(_busy || !HasEdits)" @onclick="Discard">
                @SettingsText.DiscardChanges
            </button>
        </div>
    }

    @if (_test is { } test)
    {
        <p class="@(test.Connected ? "muted" : "error")" id="mqtt-test-result" role="status">@Localized.Say(test.MessagePhrase, test.Message)</p>
    }

    @if (_problems.Count > 0)
    {
        <div id="mqtt-problems">
            <p class="error">@SettingsText.NotSaved</p>
            <ul class="error">
                @foreach (var problem in _problems)
                {
                    <li>@problem</li>
                }
            </ul>
        </div>
    }

    @if (_message is { } message)
    {
        <p class="muted" id="mqtt-message">@message</p>
    }
</section>

@code {
    /// <summary>Raised after a save that wrote something.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    private static (string Key, string Label, string Hint)[] Fields =>
    [
        (IntegrationSettingKeys.MqttBrokerHost, SettingsText.FieldBrokerHost, SettingsText.HintBrokerHost),
        (IntegrationSettingKeys.MqttBrokerPort, SettingsText.FieldBrokerPort, "1883"),
        (IntegrationSettingKeys.MqttUsername, SettingsText.FieldMqttUsername, string.Empty),
        (IntegrationSettingKeys.MqttDiscoveryPrefix, SettingsText.FieldDiscoveryPrefix, "homeassistant"),
    ];

    private IntegrationSettings _settings = new(
        string.Empty, [], new SecretSettingState(false, SettingSource.Default, false), [], string.Empty);

    private Dictionary<string, string> _values = [];
    private bool _enabled;
    private string _password = string.Empty;
    private IReadOnlyList<string> _problems = [];
    private string? _message;
    private MqttTestResult? _test;
    private bool _busy;
    private bool _testing;

    private bool ReadOnly => !Web.Value.LoginEnforced(WebPassword);

    private bool Editable => !ReadOnly && _settings.Unavailable is null;

    private int Pending =>
        _settings.PendingCount(IntegrationSettingKeys.Mqtt) + (_settings.MqttPassword.IsPending ? 1 : 0);

    private bool HasEdits => Edits().Count > 0 || _password.Length > 0;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _settings = Editor.Read();
        _values = IntegrationSettingKeys.Mqtt.ToDictionary(
            key => key, key => _settings[key].Saved ?? string.Empty, StringComparer.OrdinalIgnoreCase);
        _enabled = bool.TryParse(_values[IntegrationSettingKeys.MqttEnabled], out var on) && on;
        _password = string.Empty;
    }

    private void Touch()
    {
        _message = null;
        _problems = [];
        _test = null;
    }

    // What the form holds that the next start would not already read. The checkbox counts as an edit
    // only when it differs from what is saved, read as a boolean.
    private Dictionary<string, string> Edits()
    {
        var edits = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var saved = bool.TryParse(_settings[IntegrationSettingKeys.MqttEnabled].Saved, out var on) && on;

        if (_enabled != saved)
        {
            edits[IntegrationSettingKeys.MqttEnabled] = _enabled ? "true" : "false";
        }

        foreach (var (key, _, _) in Fields)
        {
            if (!string.Equals(_values[key].Trim(), _settings[key].Saved ?? string.Empty, StringComparison.Ordinal))
            {
                edits[key] = _values[key].Trim();
            }
        }

        return edits;
    }

    private async Task Save()
    {
        if (!Editable || _busy)
        {
            return;
        }

        _busy = true;
        Touch();

        try
        {
            var result = Editor.Save(Edits(), _password.Length > 0 ? _password : null);

            if (!result.Saved)
            {
                _problems = Localized.Say(result.Problems, result.ProblemPhrases);
                return;
            }

            Reload();
            _message = Pending > 0 ? SettingsText.SavedRestart : SettingsText.SavedRunning;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void RemovePassword()
    {
        Touch();
        var result = Editor.Save(new Dictionary<string, string>(), string.Empty);

        if (!result.Saved)
        {
            _problems = Localized.Say(result.Problems, result.ProblemPhrases);
            return;
        }

        Reload();
        _message = SettingsText.PasswordRemoved;
    }

    private async Task TestAsync()
    {
        if (!Editable || _busy)
        {
            return;
        }

        _busy = true;
        _testing = true;
        Touch();

        try
        {
            var port = int.TryParse(_values[IntegrationSettingKeys.MqttBrokerPort].Trim() is { Length: > 0 } typed ? typed : "1883", out var number)
                ? number
                : 0;

            _test = await Editor.TestMqttAsync(
                _values[IntegrationSettingKeys.MqttBrokerHost],
                port,
                _values[IntegrationSettingKeys.MqttUsername],
                _password.Length > 0 ? _password : null);
        }
        finally
        {
            _busy = false;
            _testing = false;
        }
    }

    private void Revert(string key)
    {
        Touch();
        var result = Editor.Revert(key);

        if (!result.Saved)
        {
            _problems = Localized.Say(result.Problems, result.ProblemPhrases);
            return;
        }

        Reload();
    }

    private void Discard()
    {
        Touch();
        Reload();
    }
}
