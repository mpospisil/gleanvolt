@* One telemetry value, with its meaning one tap away: MQTT discovery has nowhere to put an explanation,
   this page does, and README's "what each entity means" table is what Hint is drawn from. Since #255 the
   hint sits in an InfoTip beside the label rather than under the value, so a grid of them reads as
   figures first. *@
<div class="stat">
    <div class="label">
        @Label
        @if (!string.IsNullOrWhiteSpace(Hint))
        {
            <InfoTip Topic="@Label" End="End">
                <p>@Hint</p>
            </InfoTip>
        }
    </div>
    <div class="value">@Value</div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Hint { get; set; }

    /// <summary>Opens the tip leftwards, for a figure near the right edge.</summary>
    [Parameter] public bool End { get; set; }
}
