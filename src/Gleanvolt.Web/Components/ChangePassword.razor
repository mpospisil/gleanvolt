@inject WebPasswordState Password
@inject WebPasswordService Passwords

@*
    Settings → Password (#301): a new password for someone who knows the current one. Interactive, like
    the rest of Settings -- it sets no cookie, it only replaces the hash. That replacement signs every
    browser out, this one included, so the result is the new recovery key and a way back to sign-in.
*@

@if (Password.IsSet)
{
    <section class="controls pv-editor" id="password">
        <div class="section-head">
            <h2>@SharedText.ChangePasswordTitle</h2>
        </div>

        @if (_recoveryKey is not null)
        {
            <RecoveryKeyPanel Key="@_recoveryKey" Intro="@SharedText.ChangeDoneIntro"
                              ContinueHref="/login" ContinueText="@SharedText.SignInAgain" />
        }
        else
        {
            <p class="muted">@SharedText.ChangePasswordHint</p>

            @if (_error is not null)
            {
                <p class="error" role="alert">@_error</p>
            }

            <form @onsubmit="Change">
                <div class="pv-fields">
                    <div class="pv-field">
                        <label for="password-current">@SharedText.CurrentPassword</label>
                        <input id="password-current" type="password" @bind="_current" autocomplete="current-password" />
                    </div>
                    <div class="pv-field"></div>
                    <div class="pv-field">
                        <label for="password-new">@SharedText.NewPassword</label>
                        <input id="password-new" type="password" @bind="_next" autocomplete="new-password" />
                    </div>
                    <div class="pv-field">
                        <label for="password-repeat">@SharedText.RepeatPassword</label>
                        <input id="password-repeat" type="password" @bind="_confirm" autocomplete="new-password" />
                    </div>
                </div>
                <div class="control actions">
                    <button type="submit" class="primary" id="password-change">@SharedText.ChangePasswordButton</button>
                </div>
            </form>
        }
    </section>
}

@code {
    private string _current = "";
    private string _next = "";
    private string _confirm = "";
    private string? _error;
    private string? _recoveryKey;

    private void Change()
    {
        if (_next != _confirm)
        {
            _error = SharedText.PasswordsDiffer;
            return;
        }

        var result = Passwords.Change(_current, _next);

        // Cleared whichever way it went: none of the three should sit in the page's memory.
        _current = _next = _confirm = "";

        if (!result.Succeeded)
        {
            _error = Pages.ForgotPassword.Describe(result.Error);
            return;
        }

        _error = null;
        _recoveryKey = result.RecoveryKey;
    }
}
