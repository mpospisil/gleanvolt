@implements IDisposable
@inject IExternalProviders Providers
@inject TimeProvider Time

@*
    Plugins that knock and wait for the owner (provider pairing): each row has the code the plugin shows
    itself, so the owner can tell a plugin they started from one they did not. Accept hands the plugin the
    shared provider token. There is deliberately no link to the plugin's own page: the registry does not
    carry it, and a page a stranger names is not one to open from here.

    Accept is allowed without Gleanvolt's login, here and in the Wizard: the owner chose that over the token
    panel's read-only rule, so a plugin can be paired on an install without a password. Setting a password
    closes it.

    Changed is not raised when a waiting request expires, so while anything waits the list is also read
    again every few seconds.
*@

@* Outside the list: the likeliest failure is a request that expired, which leaves the list empty. *@
@if (_message is { } message)
{
    <p class="error pairing-message">@message</p>
}

@if (_requests.Count > 0)
{
    <div id="pairing-requests" class="pairing-requests">
        <h3>@SettingsText.PairingTitle</h3>
        <p class="muted">@SettingsText.PairingIntro</p>

        @foreach (var request in _requests)
        {
            <div class="pairing-request" id="pairing-@request.Id">
                <p>
                    <strong>@request.ProviderName</strong>
                    <span class="muted">(@request.ProviderId)</span>
                    @(" ")
                    <span class="pairing-source">@(request.OnThisMachine ? SettingsText.PairingThisMachine : request.Source)</span>
                </p>
                <p>@SettingsText.PairingCode <code class="pairing-code">@request.Code</code></p>

                @if (!request.OnThisMachine)
                {
                    <p class="muted pairing-hint">@SettingsText.PairingCheckCode</p>
                }

                @if (request.Block != PairingBlock.None)
                {
                    <p class="warning pairing-block">@BlockText(request.Block)</p>
                }

                <button type="button" class="pairing-accept" disabled="@(request.Block != PairingBlock.None || _busy)"
                        @onclick="() => AcceptAsync(request.Id)">@SettingsText.PairingAccept</button>
                <button type="button" class="secondary pairing-reject" disabled="@_busy"
                        @onclick="() => Reject(request.Id)">@SettingsText.PairingReject</button>
            </div>
        }
    </div>
}

@code {
    private static readonly TimeSpan Reread = TimeSpan.FromSeconds(5);

    private readonly ViewerCulture _viewer = new();
    private IReadOnlyList<PairingRequestView> _requests = [];
    private ITimer? _timer;
    private string? _message;
    private bool _busy;

    protected override void OnInitialized()
    {
        _requests = Providers.Pairing;
        Providers.Changed += Refresh;
        _timer = Time.CreateTimer(_ => Refresh(), null, Reread, Reread);
    }

    public void Dispose()
    {
        Providers.Changed -= Refresh;
        _timer?.Dispose();
    }

    private void Refresh() => _ = InvokeAsync(_viewer.Wrap(() =>
    {
        _requests = Providers.Pairing;
        StateHasChanged();
    }));

    private async Task AcceptAsync(string id)
    {
        _busy = true;
        _message = null;

        try
        {
            // False: the request expired or became blocked between the render and the click.
            if (!await Providers.AcceptPairingAsync(id))
            {
                _message = SettingsText.PairingGone;
            }
        }
        catch (InvalidOperationException)
        {
            // The token could not be made; the request stays, so the owner can try again.
            _message = SettingsText.ExternalTokenFailed;
        }
        finally
        {
            _busy = false;
            _requests = Providers.Pairing;
        }
    }

    private void Reject(string id)
    {
        _message = null;
        Providers.RejectPairing(id);
        _requests = Providers.Pairing;
    }

    private static string BlockText(PairingBlock block) => block switch
    {
        PairingBlock.Duplicate => SettingsText.PairingBlockDuplicate,
        PairingBlock.KindOff => SettingsText.PairingBlockKindOff,
        PairingBlock.AnotherProvider => SettingsText.PairingBlockAnotherProvider,
        _ => "",
    };
}
