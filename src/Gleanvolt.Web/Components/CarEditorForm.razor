@inject IEvEditor Editor
@inject IOptions<WebOptions> Web
@inject Gleanvolt.Web.Auth.WebPasswordState WebPassword

@*
    The car, editable (issue #214). Everything below this form on /car is what the process is running
    with; this is what the next start will read — the same split, and the same overrides file, as
    /pv-system's form (#204).

    One <select> is the only control here that changes which fields exist. It removes two startup
    failures by construction: two live feeds cannot both be enabled, because picking one disables the
    others in the same save, and the Data Act portal cannot be arranged beside a live feed by accident.

    What it cannot do is probe. The feed is built at startup out of these very keys, so there is
    nothing running to test them against — and a cold volkswagen.de sign-in wants an emailed code
    anyway. Save, restart, sign in, ask the car; the page says so rather than letting a green save look
    like a working feed. Since #227 all four of those are on this one page, so what used to be a link
    to /vehicle-portal is a pointer down the page.
*@

<section class="controls pv-editor car-editor" id="car-editor">
    <h2>@CarText.Edit</h2>

    @if (_pending.Count > 0 || _pendingSecrets.Count > 0 || _settings.FeedIsPending)
    {
        <div class="alert pending" id="car-pending">
            <p>
                <strong>@CarText.SavedNotApplied</strong> —
                @Localized.Format(Localized.Plural(PendingCount, CarText.ChangesTakeEffect_One, CarText.ChangesTakeEffect_Few, CarText.ChangesTakeEffect_Other), PendingCount)
            </p>
            <ul>
                @if (_settings.FeedIsPending)
                {
                    <li>@Localized.Format(CarText.FeedChange, FeedName(_settings.RunningFeed), FeedName(_settings.Feed))</li>
                }
                @foreach (var setting in _pending)
                {
                    <li>@Label(setting.Key): @Show(setting.Running) → @Show(setting.Saved)</li>
                }
                @*
                    Named, never valued. A pending-changes banner that printed "hunter2 → correct-horse"
                    would undo every other precaution on this page in one line.
                *@
                @foreach (var secret in _pendingSecrets)
                {
                    <li>@Label(secret.Key): @(secret.Stored ? CarText.SecretSet : CarText.SecretRemoved)</li>
                }
            </ul>
            <div class="control">
                <RestartService Label="@CarText.ApplyThem" />
            </div>
        </div>
    }

    @if (_settings.Unavailable is { } unavailable)
    {
        <p class="error" id="car-unavailable">@unavailable</p>
    }
    else if (ReadOnly)
    {
        <p class="muted" id="car-readonly">
            @Localized.Rich(CarText.CarReadOnly, @<code>Web__PasswordHash</code>, @<code>hash-password</code>, @<code>.env</code>)
        </p>
    }
    else
    {
        <p class="muted">
            @Localized.Rich(CarText.CarSaveNote, @<code>@_settings.OverridesPath</code>, @<code>.env</code>, @<a href="#account">@CarText.CarSaveNote_2</a>)
        </p>
    }

    <h3>@CarText.Manufacturer</h3>

    <div class="pv-fields">
        <div class="pv-field">
            <label for="car-feed">@CarText.WhatReadsThisCar</label>
            <select id="car-feed" disabled="@(!Editable)"
                    value="@_feed.ToString()"
                    @onchange="e => Choose(e.Value?.ToString())">
                @foreach (var feed in VehicleFeeds.All)
                {
                    <option value="@feed.ToString()">@FeedName(feed)</option>
                }
            </select>
            <span class="source">@FeedFreshness(_feed)</span>
        </div>
    </div>

    <p class="table-note muted" id="car-feed-note">@FeedNote(_feed)</p>

    @if (VehicleFeeds.Fields(_feed).Count > 0)
    {
        <div class="pv-fields">
            @foreach (var key in VehicleFeeds.Fields(_feed))
            {
                @if (key == EvSettingKeys.DataActClientId)
                {
                    continue;
                }

                @if (EvSettingKeys.IsSecret(key))
                {
                    @Password(key)
                }
                else if (key == EvSettingKeys.DataActBrand)
                {
                    @Brand(key)
                }
                else
                {
                    @Field(key)
                }
            }
        </div>

        @if (_feed == VehicleFeed.DataAct)
        {
            @*
                Documentation for a failure rather than a field to fill: the table above knows every
                brand's sign-in id, and this is what to do on the day one of them changes.
            *@
            <details class="car-escape-hatch">
                <summary>@CarText.SignInIdChanged</summary>
                <p class="muted">
                    @CarText.SignInIdChangedNote
                </p>
                <div class="pv-fields">
                    @Field(EvSettingKeys.DataActClientId)
                </div>
            </details>
        }
    }

    <h3>@CarText.TheCar</h3>

    <p class="muted">
        @Localized.Format(CarText.CarFieldsNote, _settings.ChargerMinAmps, _settings.ChargerMaxAmps)
    </p>

    <div class="pv-fields">
        @Field(EvSettingKeys.Id)
        @Field(EvSettingKeys.Name)
        @Field(EvSettingKeys.Make)
        @Field(EvSettingKeys.Model)
        @Phases()
        @Field(EvSettingKeys.MinChargingCurrentAmps)
        @Field(EvSettingKeys.MaxChargingCurrentAmps)
        @Field(EvSettingKeys.BatteryCapacityKWh)
        @Field(EvSettingKeys.ChargeEfficiency)
    </div>

    @if (Editable)
    {
        <div class="control actions">
            <button type="button" class="primary" id="car-save" disabled="@(_busy || !HasChanges)" @onclick="@Save">
                @(_busy ? CarText.Checking : CarText.SaveButton)
            </button>
            <button type="button" class="secondary" disabled="@(_busy || !HasChanges)" @onclick="Discard">
                @CarText.DiscardChanges
            </button>
        </div>
    }

    @if (_problems.Count > 0)
    {
        <div id="car-problems">
            <p class="error">@CarText.NotSaved</p>
            <ul class="error">
                @foreach (var problem in _problems)
                {
                    <li>@problem</li>
                }
            </ul>
        </div>
    }

    @if (_message is { } message)
    {
        <p class="muted" id="car-message">
            @message
            <a href="#account">@CarText.ProveIt</a>.
        </p>
    }
</section>

@code {
    private const string Missing = Units.Missing;

    private static Dictionary<string, string> Labels => new(StringComparer.OrdinalIgnoreCase)
    {
        [EvSettingKeys.Id] = CarText.FieldId,
        [EvSettingKeys.Name] = CarText.FieldName,
        [EvSettingKeys.Make] = CarText.FieldMake,
        [EvSettingKeys.Model] = CarText.FieldModel,
        [EvSettingKeys.BatteryCapacityKWh] = CarText.FieldUsablePack,
        [EvSettingKeys.ChargeEfficiency] = CarText.FieldChargeEfficiency,
        [EvSettingKeys.Phases] = CarText.FieldPhases,
        [EvSettingKeys.MinChargingCurrentAmps] = CarText.FieldMinCurrent,
        [EvSettingKeys.MaxChargingCurrentAmps] = CarText.FieldMaxCurrent,
        [EvSettingKeys.TelemetryTopic] = "Topic",
        [EvSettingKeys.WebsiteEnabled] = "volkswagen.de",
        [EvSettingKeys.WebsiteUsername] = CarText.FieldVwId,
        [EvSettingKeys.WebsitePassword] = CarText.FieldPassword,
        [EvSettingKeys.WebsiteVin] = CarText.FieldVin,
        [EvSettingKeys.SkodaEnabled] = "MyŠkoda",
        [EvSettingKeys.SkodaVin] = CarText.FieldVin,
        [EvSettingKeys.DataActEnabled] = CarText.FieldDataAct,
        [EvSettingKeys.DataActBrand] = CarText.FieldBrand,
        [EvSettingKeys.DataActClientId] = CarText.FieldClientId,
        [EvSettingKeys.DataActUsername] = CarText.FieldVwId,
        [EvSettingKeys.DataActPassword] = CarText.FieldPassword,
        [EvSettingKeys.DataActVin] = CarText.FieldVin,
        [EvSettingKeys.MqttEnabled] = CarText.FieldOwnTopic,
    };

    private static Dictionary<string, string> Hints => new(StringComparer.OrdinalIgnoreCase)
    {
        [EvSettingKeys.Id] = CarText.HintId,
        [EvSettingKeys.BatteryCapacityKWh] = CarText.HintUsablePack,
        [EvSettingKeys.ChargeEfficiency] = CarText.HintEfficiency,
        [EvSettingKeys.MinChargingCurrentAmps] = CarText.HintMinCurrent,
        [EvSettingKeys.MaxChargingCurrentAmps] = CarText.HintMaxCurrent,
        [EvSettingKeys.TelemetryTopic] = "one concrete topic, no wildcards",
        [EvSettingKeys.WebsiteVin] = CarText.Hint17Characters,
        [EvSettingKeys.SkodaVin] = CarText.Hint17Characters,
        [EvSettingKeys.DataActVin] = CarText.Hint17Characters,
        [EvSettingKeys.DataActClientId] = "…@apps_vw-dilab_com",
    };

    private EvSettings _settings = Empty;
    private Dictionary<string, string> _values = [];
    private Dictionary<string, string> _passwords = [];
    private VehicleFeed _feed;
    private List<ConfiguredSetting> _pending = [];
    private List<EvSecret> _pendingSecrets = [];
    private IReadOnlyList<string> _problems = [];
    private string? _message;
    private bool _busy;

    private static EvSettings Empty { get; } = new(
        string.Empty, [], [], VehicleFeed.ChargeOnly, VehicleFeed.ChargeOnly, [], string.Empty, 0, 0);

    // These fields are a manufacturer account, so the rule #204 set for the device addresses applies
    // at least as strongly: an open UI shows the form without letting anyone use it.
    // The password in force, not the startup one, so a password set on /setup unlocks this at once.
    private bool ReadOnly => !Web.Value.LoginEnforced(WebPassword);

    private bool Editable => !ReadOnly && _settings.Unavailable is null;

    private int PendingCount => _pending.Count + _pendingSecrets.Count + (_settings.FeedIsPending ? 1 : 0);

    private bool HasChanges => _feed != _settings.Feed || Edits().Count > 0;

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _settings = Editor.Read();
        _values = _settings.Settings.ToDictionary(
            setting => setting.Key, setting => setting.Saved ?? string.Empty, StringComparer.OrdinalIgnoreCase);

        // Always empty, on every load and after every save: a password field that rendered its value
        // back would put a bearer-equivalent secret on the wire for every browser that opened the page.
        _passwords = EvSettingKeys.Secrets.ToDictionary(key => key, _ => string.Empty, StringComparer.OrdinalIgnoreCase);

        _feed = _settings.Feed;
        _pending = [.. _settings.Pending];
        _pendingSecrets = [.. _settings.PendingSecrets];
    }

    private void Choose(string? value)
    {
        _message = null;
        _problems = [];

        if (Enum.TryParse<VehicleFeed>(value, out var feed))
        {
            _feed = feed;
        }
    }

    // What the form holds that the next start would not already read. Hidden feeds contribute nothing:
    // switching manufacturer leaves the old account's fields exactly as they were, so switching back
    // does not mean typing a VIN in again.
    private Dictionary<string, string> Edits()
    {
        var edits = _settings.Settings
            .Where(setting => _values.TryGetValue(setting.Key, out var value)
                && !string.Equals(value.Trim(), setting.Saved ?? string.Empty, StringComparison.Ordinal))
            .ToDictionary(setting => setting.Key, setting => _values[setting.Key].Trim(), StringComparer.OrdinalIgnoreCase);

        // An empty password box means unchanged, never cleared. Clearing is the Remove button, which
        // goes through Revert.
        foreach (var (key, typed) in _passwords)
        {
            if (!string.IsNullOrWhiteSpace(typed))
            {
                edits[key] = typed;
            }
        }

        return edits;
    }

    private void Save()
    {
        var edits = Edits();
        var switching = _feed != _settings.Feed;

        if (!switching && edits.Count == 0)
        {
            return;
        }

        _message = null;
        _problems = [];
        _busy = true;

        try
        {
            var result = switching ? Editor.SaveFeed(_feed, edits) : Editor.Save(edits);

            if (!result.Saved)
            {
                _problems = Localized.Say(result.Problems, result.ProblemPhrases);
                return;
            }

            Reload();
            _message = PendingCount > 0
                ? CarText.SavedRestartSignIn
                : CarText.SavedRunning;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Revert(string key)
    {
        _message = null;
        var result = Editor.Revert(key);

        if (!result.Saved)
        {
            _problems = Localized.Say(result.Problems, result.ProblemPhrases);
            return;
        }

        _problems = [];
        Reload();
        _message = $"{Label(key)} removed; it comes from {SourceName(_settings[key])} again.";
    }

    private void RemoveSecret(string key)
    {
        _message = null;
        var result = Editor.Revert(key);

        if (!result.Saved)
        {
            _problems = Localized.Say(result.Problems, result.ProblemPhrases);
            return;
        }

        _problems = [];
        Reload();
        _message = "The stored password was removed.";
    }

    private void Discard()
    {
        _problems = [];
        _message = null;
        Reload();
    }

    // The fields are Razor templates rather than markup repeated five times: every one of them has to
    // carry the same provenance line and the same Revert, and the two that do not — a password, which
    // is never read back, and a choice, which is a <select> — differ only where they must.

    private RenderFragment Field(string key) => @<div class="pv-field">
        <label for="@Id(key)">@Label(key)</label>
        <input id="@Id(key)" type="text" spellcheck="false" autocomplete="off"
               placeholder="@Hints.GetValueOrDefault(key)"
               disabled="@(!Editable || _busy)"
               value="@_values[key]"
               @oninput="e => _values[key] = e.Value?.ToString() ?? string.Empty" />
        @Provenance(key)
    </div>;

    private RenderFragment Brand(string key) => @<div class="pv-field">
        <label for="@Id(key)">@Label(key)</label>
        <select id="@Id(key)" disabled="@(!Editable || _busy)"
                value="@_values[key]"
                @onchange="e => _values[key] = e.Value?.ToString() ?? string.Empty">
            <option value="">—</option>
            @foreach (var brand in _settings.Brands)
            {
                <option value="@brand.Name">@brand.Label</option>
            }
        </select>
        @Provenance(key)
    </div>;

    // 1, 2 or 3, because the one that goes wrong quietly is a single-phase car behind a three-phase
    // wallbox: unset, every power figure the controller reasons with is overstated threefold.
    private RenderFragment Phases() => @<div class="pv-field">
        <label for="@Id(EvSettingKeys.Phases)">@Label(EvSettingKeys.Phases)</label>
        <select id="@Id(EvSettingKeys.Phases)" disabled="@(!Editable || _busy)"
                value="@_values[EvSettingKeys.Phases]"
                @onchange="e => _values[EvSettingKeys.Phases] = e.Value?.ToString() ?? string.Empty">
            <option value="">@CarText.PhasesNotStated</option>
            <option value="1">@CarText.PhasesSingle</option>
            <option value="2">2</option>
            <option value="3">@CarText.PhasesThree</option>
        </select>
        @Provenance(EvSettingKeys.Phases)
    </div>;

    private RenderFragment Password(string key) => @<div class="pv-field">
        <label for="@Id(key)">@Label(key)</label>
        <input id="@Id(key)" type="password" autocomplete="new-password" spellcheck="false"
               placeholder="@(_settings.Secret(key).Stored ? CarText.Unchanged : CarText.NotSet)"
               disabled="@(!Editable || _busy)"
               value="@_passwords[key]"
               @oninput="e => _passwords[key] = e.Value?.ToString() ?? string.Empty" />
        <span class="source @(_settings.Secret(key).IsEdited ? "edited" : null)">@SecretSource(_settings.Secret(key))</span>
        @if (_settings.Secret(key).IsEdited && Editable)
        {
            <button type="button" class="link revert" id="@(Id(key))-remove" disabled="@_busy" @onclick="() => RemoveSecret(key)">
                @CarText.Remove
            </button>
        }
        @*
            An owner typing a password into a browser deserves to be told where it ends up, in words
            taken from the store itself so this cannot drift into claiming more than is true.
        *@
        <span class="hint">
            @Localized.Format(CarText.KeptInSecretStore, Localized.Say(_settings.SecretProtectionPhrase, _settings.SecretProtection))
        </span>
    </div>;

    private RenderFragment Provenance(string key) => @<text>
        <span class="source @(_settings[key].IsEdited ? "edited" : null)" title="@SourceTitle(_settings[key])">
            @SourceName(_settings[key])
        </span>
        @if (_settings[key].IsEdited && Editable)
        {
            <button type="button" class="link revert" id="@(Id(key))-revert" disabled="@_busy" @onclick="() => Revert(key)">
                @Localized.Format(CarText.RevertTo, Show(_settings[key].Underlying))
            </button>
        }
    </text>;

    private static string Label(string key) => Labels.GetValueOrDefault(key, key);

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? Missing : value;

    private static string Id(string key) => "car-" + key.Replace(':', '-');

    private static string FeedName(VehicleFeed feed) => feed switch
    {
        VehicleFeed.Volkswagen => "Volkswagen",
        VehicleFeed.Skoda => "Škoda",
        VehicleFeed.DataAct => CarText.FeedDataAct,
        VehicleFeed.OwnTopic => CarText.FeedOwnTopic,
        _ => CarText.FeedNone,
    };

    private static string FeedFreshness(VehicleFeed feed) => feed switch
    {
        VehicleFeed.Volkswagen => CarText.FreshVolkswagen,
        VehicleFeed.Skoda => CarText.FreshSkoda,
        VehicleFeed.DataAct => CarText.FreshDataAct,
        VehicleFeed.OwnTopic => CarText.FreshOwnTopic,
        _ => CarText.FreshNone,
    };

    private static string FeedNote(VehicleFeed feed) => feed switch
    {
        VehicleFeed.Volkswagen =>
            CarText.NoteVolkswagen,
        VehicleFeed.Skoda =>
            CarText.NoteSkoda,
        VehicleFeed.DataAct =>
            CarText.NoteDataAct,
        VehicleFeed.OwnTopic =>
            CarText.NoteOwnTopic,
        _ =>
            CarText.NoteNone,
    };

    private static string SecretSource(EvSecret secret) => secret.Source switch
    {
        SettingSource.SecretStore => CarText.SourceSecretStore,
        SettingSource.Environment => Localized.Format(CarText.SourceEnvironmentDetail, secret.SourceDetail),
        SettingSource.CommandLine => CarText.SourceCommandLine,
        SettingSource.AppSettings => "appsettings.json",
        _ => CarText.NotSet,
    };

    private static string SourceName(ConfiguredSetting setting) => setting.Source switch
    {
        SettingSource.WebUi => CarText.SourceWebUi,
        SettingSource.SecretStore => CarText.SourceSecretStore,
        SettingSource.Environment => CarText.SourceEnvironment,
        SettingSource.CommandLine => CarText.SourceCommandLine,
        SettingSource.AppSettings => string.IsNullOrEmpty(setting.SourceDetail) ? "appsettings.json" : setting.SourceDetail,
        _ => CarText.SourceDefault,
    };

    private static string SourceTitle(ConfiguredSetting setting) => setting.Source switch
    {
        SettingSource.WebUi => Localized.Format(CarText.TitleWebUi, setting.SourceDetail),
        SettingSource.Environment =>
            Localized.Format(CarText.TitleEnvironment, setting.SourceDetail),
        SettingSource.CommandLine => CarText.TitleCommandLine,
        SettingSource.AppSettings => Localized.Format(CarText.TitleAppSettings, SourceName(setting)),
        _ => CarText.TitleDefault,
    };
}
