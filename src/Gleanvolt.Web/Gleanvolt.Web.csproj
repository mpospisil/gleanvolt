<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>Gleanvolt.Web</PackageId>
    <Description>The self-hosted Blazor dashboard for the Gleanvolt, as a Razor class library: live telemetry, charge control, session history and the forecast plan.</Description>
  </PropertyGroup>

  <!--
    The shared framework rather than the Microsoft.AspNetCore.Components.Web package the RCL template
    offers: these components only ever run server-side, inside the worker, so there is nothing to gain
    from staying WebAssembly-compatible and a duplicate copy of the assembly to avoid.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    So the day chart's arithmetic (EnergyChartSeries) can be tested directly. Turning kWh buckets into
    a watt series is where the honesty of that chart lives: the coverage division, and the holes left
    where nothing was observed. The alternative was inferring both from rendered markup, or making a
    detail of one page part of this library's public surface.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Gleanvolt.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gleanvolt.Core\Gleanvolt.Core.csproj" />
  </ItemGroup>

  <!--
    The UI's text (#290). One .resx per area of the UI under Resources/, English in the neutral file
    and each translation beside it (PlanText.cs.resx). The neutral file also gets a generated class
    (Resources.PlanText.SomeKey) rather than being read through IStringLocalizer by key: a key that
    does not exist is then a compile error instead of a page that quietly shows the key, and the
    narratives, static classes with no DI to inject a localizer into, read text the same way the
    pages do. The class reads CurrentUICulture on every access, so it follows the circuit's culture.
  -->
  <ItemGroup>
    <NeutralResx Include="Resources\*.resx" Exclude="Resources\*.*.resx" />
    <EmbeddedResource Update="@(NeutralResx)">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>$(RootNamespace).Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>%(Filename)</StronglyTypedClassName>
      <!-- Public, because DataAnnotations only reads a message from a public property. -->
      <PublicClass>true</PublicClass>
      <StronglyTypedFileName>$(IntermediateOutputPath)%(Filename).Resources.g.cs</StronglyTypedFileName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    The pseudo-locale (qps-ploc): every neutral string with its vowels accented and in brackets,
    generated from the English rather than checked in, so it can never fall behind. Text on a page
    that does not look like "[Óvéřvíéw]" under it was never moved into a resource. Debug builds only;
    the published image has no use for it, and WebUiCultures only offers it in Development anyway.
  -->
  <Target Name="GeneratePseudoLocale" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Debug'">
    <MakeDir Directories="$(IntermediateOutputPath)pseudo" />
    <XslTransformation XmlInputPaths="%(NeutralResx.FullPath)" XslInputPath="Resources\pseudo-locale.xslt"
                       OutputPaths="$(IntermediateOutputPath)pseudo\%(NeutralResx.Filename).qps-ploc.resx" />
    <ItemGroup>
      <_PseudoResx Include="@(NeutralResx->'$(IntermediateOutputPath)pseudo\%(Filename).qps-ploc.resx')" />
      <EmbeddedResource Include="@(_PseudoResx)" ManifestResourceName="$(RootNamespace).Resources.%(_PseudoResx.Filename)"
                        WithCulture="true" Culture="qps-ploc" />
    </ItemGroup>
  </Target>

</Project>
