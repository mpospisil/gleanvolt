{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gleanvolt-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Controller": {
    "TimeZone": "",
    "PollIntervalSeconds": 5
  },
  "Pv": {
    "Id": "",
    "Name": "",
    "Address": "",
    "Latitude": null,
    "Longitude": null,
    "AzimuthDegrees": null,
    "TiltDegrees": null,
    "CapacityKwp": null,
    "InverterCapacityKw": null,
    "LossFactor": null,
    "InstallDate": "",
    "Inverter": {
      "Model": "SolaX X3-HYB-G4 PRO",
      "Host": "192.168.2.10",
      "Port": 502,
      "UnitId": 1
    },
    "Chargers": [
      {
        "Id": "charger",
        "Model": "SolaX X1/X3-HAC",
        "Host": "192.168.2.6",
        "Port": 502,
        "UnitId": 1
      }
    ]
  },
  "Solcast": {
    "Enabled": true,
    "BaseUrl": "https://api.solcast.com.au/",
    "ResourceId": "your-solcast-resource-id",
    "RefreshInterval": "03:00:00"
  },
  "Weather": {
    "BaseUrl": "https://api.openweathermap.org/",
    "Units": "metric",
    "RequestTimeout": "00:00:05"
  },
  "ChargeControl": {
    "DryRun": false,
    "NominalVoltage": 230,
    "Phases": 3,
    "MinChargingCurrentAmps": 6,
    "MaxChargingCurrentAmps": 16,
    "CurrentStepAmps": 1,
    "PauseCurrentAmps": 0,
    "SurplusAverageWindow": "00:03:00",
    "CurrentChangeThresholdAmps": 1,
    "ResumeHysteresisWatts": 200,
    "BatteryFullSocPercent": 95,
    "BatteryReleaseSocPercent": 90,
    "CompletionPowerThresholdWatts": 200,
    "CompletionDwell": "00:02:00",
    "Forecast": {
      "FullByTime": "19:00:00",
      "BatteryCapacityKWh": 9.0,
      "ChargeEfficiency": 0.95,
      "BaselineHouseLoadWatts": 350,
      "ForecastConfidence": "P10",
      "MinBatterySocFloorPercent": 50,
      "FloorResumeMarginPercent": 5,
      "FloorGuardReserveWatts": 750,
      "DailyEvTargetKWh": 15,
      "SessionEnergyTargetKWh": 0,
      "EnableBatteryLoan": true,
      "MaxLoanPowerWatts": 2500,
      "MinBridgeSurplusWatts": 2000,
      "MaxDailyLoanKWh": 4,
      "LoanSocMarginPercent": 2,
      "MinViableWindow": "00:30:00",
      "MinRunTime": "00:10:00",
      "MinPauseTime": "00:15:00",
      "FinalGuardBefore": "01:00:00",
      "StaleForecastAfter": "04:00:00",
      "AutoArmBatteryHoldAtFloor": true,
      "HoldReleaseMarginPercent": 2,
      "BiasMinPeriods": 4,
      "BiasClampMin": 0.5,
      "BiasClampMax": 1.2,
      "TrustBandMin": 0.6,
      "TrustBandMax": 1.4,
      "TrustBreachPeriods": 3
    },
    "Targeted": {
      "SafetyMargin": "00:15:00",
      "MaxHorizon": "1.12:00:00",
      "GridBridge": true,
      "JustInTime": {
        "RestSocPercent": 80,
        "ReleaseSlack": "00:30:00"
      }
    }
  },
  "SessionStore": {
    "Enabled": true,
    "Path": "data/sessions.db",
    "SampleInterval": "00:00:30",
    "FlushInterval": "00:01:00",
    "RetentionDays": 365,
    "RecordUncontrolledSessions": false
  },
  "EnergyMonitor": {
    "Enabled": true,
    "Path": "data/energy.db",
    "Interval": "00:15:00",
    "MaxGap": "00:05:00",
    "RetentionDays": 0
  },
  "BatteryHold": {
    "Enabled": false,
    "DryRun": true,
    "Duration": "00:01:00",
    "TargetChangeThresholdWatts": 100
  },
  "HomeAssistant": {
    "Enabled": false,
    "BrokerHost": "localhost",
    "BrokerPort": 1883,
    "DiscoveryPrefix": "homeassistant",
    "BaseTopic": "gleanvolt",
    "DeviceId": "",
    "StatusInterval": "00:00:15"
  },
  "Vehicle": {
    "Enabled": false,
    "BrokerHost": "localhost",
    "BrokerPort": 1883,
    "MaxAge": "12:00:00",
    "DataAct": {
      "Enabled": false
    }
  },
  "Ev": {
    "Vehicles": [
      {
        "Id": "",
        "Name": "",
        "Make": "",
        "Model": "",
        "BatteryCapacityKWh": 0,
        "ChargeEfficiency": 0.9,
        "Phases": null,
        "MinChargingCurrentAmps": null,
        "MaxChargingCurrentAmps": null,
        "Telemetry": {
          "Topic": "gleanvolt/vehicle/state"
        }
      }
    ]
  },
  "Web": {
    "Enabled": true,
    "Port": 8090
  },
  "Api": {
    "Enabled": false,
    "MaxQueryRange": "31.00:00:00",
    "MaxSessions": 500
  }
}
