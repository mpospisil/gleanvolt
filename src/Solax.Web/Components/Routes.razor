@*
    Routes are discovered in this assembly, not the host's: the pages live in Solax.Web and the
    worker only hosts them.

    AuthorizeRouteView rather than plain RouteView: it re-checks each routed page's [Authorize]
    attribute against AuthorizationOptions.DefaultPolicy on every navigation, including the
    client-side route changes Blazor's own router performs inside an already-open circuit that
    UseAuthorization's HTTP-level check never sees. Program.cs sets DefaultPolicy from
    Web:RequireAuthentication, so this same markup is what enforces the login requirement when it is
    on and imposes nothing when it is off.
*@
<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Routes).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <p>No such page. This build serves <a href="/">/</a> and <a href="health">/health</a>.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
