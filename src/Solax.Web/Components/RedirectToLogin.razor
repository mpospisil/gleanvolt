@* Sends an unauthenticated visitor to the login page, carrying where they were headed so a
   successful sign-in lands them back there rather than on the dashboard regardless. *@
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo(
            $"/login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}",
            forceLoad: true);
    }
}
