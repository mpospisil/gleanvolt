@page "/sessions"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IChargingSessionStore Store
@inject TimeProvider Time

@*
    Phase 4 (#49). SessionStore already records every controlled session to SQLite -- this is the
    first way to look at any of it. Read-only: IChargingSessionStore's query members (GetSessionsAsync,
    ExportAsync) already existed for this, so nothing here reaches past the interface into SQLite.
*@

<PageTitle>Charging sessions — SolaX Local Controller</PageTitle>

<h1>Charging sessions</h1>

<div class="control range-control">
    <label for="range">Show</label>
    <select id="range" @bind="_rangeDays" @bind:after="LoadAsync">
        <option value="7">Last 7 days</option>
        <option value="30">Last 30 days</option>
        <option value="90">Last 90 days</option>
        <option value="365">Last year</option>
    </select>
</div>

@if (_error)
{
    <p class="muted">Charging session history isn't available right now.</p>
}
else if (_sessions is null)
{
    <p class="muted">Loading…</p>
}
else if (_sessions.Count == 0)
{
    <p class="muted">No sessions in this range.</p>
}
else
{
    <table class="sessions">
        <thead>
            <tr>
                <th>Started</th>
                <th>Duration</th>
                <th>Strategy</th>
                <th>Delivered</th>
                <th>Solar share</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var session in _sessions)
            {
                <tr>
                    <td>
                        <a href="@($"/sessions/{session.Id}")">@Local(session.StartedAt)</a>
                        @if (session.IsOpen)
                        {
                            <span class="muted">&nbsp;(in progress)</span>
                        }
                    </td>
                    <td>@SessionFormatting.FormatDuration(session.Duration(Time.GetUtcNow()))</td>
                    <td>@session.FormatStrategy()</td>
                    <td>@((session.EnergyDeliveredWh / 1000).ToString("F2")) kWh</td>
                    <td>@(session.SolarFraction is { } fraction ? $"{fraction * 100:F0}%" : "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private int _rangeDays = 30;
    private IReadOnlyList<ChargingSession>? _sessions;
    private bool _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = false;
        try
        {
            var to = Time.GetUtcNow();
            var from = to - TimeSpan.FromDays(_rangeDays);
            _sessions = await Store.GetSessionsAsync(from, to, CancellationToken.None);
        }
        catch (Exception)
        {
            // The store isn't ready -- SessionStore:Enabled is false, or the file couldn't be opened
            // -- and that must read as "not available", not crash the page. Recording's own failures
            // are already silent by design (SessionRecordingWorker); browsing degrades the same way.
            _sessions = null;
            _error = true;
        }
    }

    private string Local(DateTimeOffset value) =>
        TimeZoneInfo.ConvertTime(value, Time.LocalTimeZone).ToString("yyyy-MM-dd HH:mm");
}
