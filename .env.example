# Local developer secrets for the Gleanvolt.Worker app.
#
# Copy this file to ".env" (which is gitignored) and fill in real values. On startup the worker
# loads the nearest ".env" file into the process environment, so these reach the app whether it is
# started with `dotnet run` or the VS Code debugger. Real system/CI environment variables take
# precedence over anything set here.
#
# Keys use the ASP.NET Core convention: "__" (double underscore) separates configuration sections,
# so Solcast__ApiKey binds to the "Solcast:ApiKey" setting.

# Solcast API key (secret) -- get it from your Solcast account.
Solcast__ApiKey=your-solcast-api-key

# Optional: override non-secret Solcast settings here instead of appsettings.json if you prefer.
# Solcast__ResourceId=your-solcast-resource-id

# OpenWeatherMap key (secret). Optional: with it and the site's coordinates, the weather each charging
# session ran in is recorded -- two calls per session, so the free plan is plenty. Without either, no
# weather call is made and sessions are recorded without it.
Weather__ApiKey=your-openweathermap-api-key

# Where this PV system is, and what it is made of. Non-secret, so appsettings.json is the usual home
# for these; they are listed here because a development machine often points at different hardware
# than the committed defaults do.
#
# Pv__Id=home-roof
# Pv__Name=Home Roof
# Pv__Latitude=50.0755
# Pv__Longitude=14.4378
# Pv__Inverter__Host=192.168.2.10
# Pv__Chargers__0__Host=192.168.2.6
#
# Retired: Weather__Latitude, Weather__Longitude, Solax__Inverter__*, Solax__EvCharger__* and
# Solax__PollIntervalSeconds. Setting any of them now stops the worker at startup with a message
# naming its replacement -- being quietly pointed at a default device is the failure that refusal
# exists to prevent.
