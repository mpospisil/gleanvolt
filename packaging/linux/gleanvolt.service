# The Gleanvolt controller as a systemd service, installed by the .deb package (issue #205).
#
# Do not edit this file: an upgrade replaces it. Settings belong in /etc/gleanvolt/gleanvolt.env,
# which the package never overwrites, and anything about the unit itself in a drop-in:
#
#   sudo systemctl edit gleanvolt

[Unit]
Description=Gleanvolt solar and EV charging controller
Documentation=https://github.com/mpospisil/gleanvolt
# The inverter and charger are on the LAN, and the first poll should not race the network coming up.
# Not a hard requirement: the controller survives unreachable devices and reconnects on its own.
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
# Readiness is reported by the app itself (AddSystemd in Program.cs), so `systemctl start` returns once
# the host has actually started, and a configuration the startup resolver refuses is a failed start.
Type=notify
User=gleanvolt
Group=gleanvolt

# The content root is the install directory: appsettings.json and the web UI's static assets are read
# from there. The working directory is the writable one, so a relative path the settings below do not
# cover still lands somewhere the service can write rather than in a read-only /opt.
WorkingDirectory=/var/lib/gleanvolt
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_CONTENTROOT=/opt/gleanvolt
# No diagnostic IPC socket, as in the container image.
Environment=DOTNET_EnableDiagnostics=0

# Every file the controller writes, absolute. Relative paths in appsettings.json resolve against two
# different roots (the SQLite stores against the content root, the vehicle files against the working
# directory), and the content root here is read-only. PackagingTests asserts that every "…Path"
# setting in appsettings.json has a line here, so a new one cannot quietly land in /opt.
Environment=SessionStore__Path=/var/lib/gleanvolt/sessions.db
Environment=EnergyMonitor__Path=/var/lib/gleanvolt/energy.db
# The secret store's directory (issue #215): the volkswagen.de session and the MyŠkoda API key, each
# written 0600. It is the same directory the files were in before, under their own names, so an
# upgrade from a build that had two path settings never costs a fresh sign-in. ProtectSystem=strict
# and ProtectHome=true below are what keeps the rest of the filesystem out of reach of this service;
# what keeps other accounts out of this directory is its own mode, set by the postinstall script.
Environment=Secrets__Directory=/var/lib/gleanvolt
# The PV system as edited on the web UI's /pv-system page (issue #204). It overrides gleanvolt.env
# key by key, and "Revert" on that page -- or deleting this file -- goes back to it.
Environment=Pv__OverridesPath=/var/lib/gleanvolt/pv-system.json
# Serilog's rolling file sink, which keeps its own 14 days. Kept beside the journal rather than
# replaced by it: on a Raspberry Pi the journal is in RAM by default and is gone after a reboot, and
# the log of the run that ended badly is the one worth having.
Environment=Serilog__WriteTo__1__Args__path=/var/log/gleanvolt/gleanvolt-.log

# The operator's settings. Read after the lines above, so anything here wins -- including the paths.
EnvironmentFile=-/etc/gleanvolt/gleanvolt.env

ExecStart=/opt/gleanvolt/Gleanvolt.Worker

# The exit code is the contract HostShutdown documents, read here exactly as `restart: on-failure`
# reads it in docker-compose.yml:
#   0    Stop service in the web UI or Home Assistant -> stays down until `systemctl start gleanvolt`
#   75   Restart in the web UI (e.g. to apply a /pv-system edit) -> restarted, like a crash, but
#        recognisably on purpose
#   143  SIGTERM (systemctl stop, reboot) -> a stop systemd asked for is never restarted, and an
#        enabled unit starts again at boot
#   else a crash -> restarted
Restart=on-failure
RestartSec=10
# 143 is how a graceful SIGTERM ends, not a failure; without this every `systemctl stop` is logged as one.
SuccessExitStatus=143
# The default 90s would do, but say it: a graceful stop releases the charger, and being SIGKILLed part
# way through that is the one thing it must not be. Matches stop_grace_period in docker-compose.yml.
TimeoutStopSec=60

# Hardening that costs the controller nothing: it needs the network and its two writable directories.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/gleanvolt /var/log/gleanvolt

[Install]
WantedBy=multi-user.target
