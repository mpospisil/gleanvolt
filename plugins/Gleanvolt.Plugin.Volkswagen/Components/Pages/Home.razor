@page "/"
@implements IDisposable
@inject AccountStore Account
@inject VwWebsiteSignIn SignIn
@inject VolkswagenFeed Feed
@inject VolkswagenPoller Poller
@inject VwWebsiteSessionStore Session
@inject Gleanvolt.Providers.Client.Vehicle.VehicleProviderConnection Connection
@inject TimeProvider Time

@*
    The plugin's page (#410), shown in Gleanvolt's Car page: the account, the sign-in with the emailed
    code in the same four states as Gleanvolt's built-in volkswagen.de sign-in, the last reading and the
    feed's status. Opening it never starts a sign-in: only the buttons reach VW.
*@

<PageTitle>Volkswagen</PageTitle>

<h1>Volkswagen</h1>

<p id="status" class="@StatusClass">@StatusText</p>

<section>
    <h2>@PageText.LastReading</h2>

    @if (Feed.LastReading is { } reading)
    {
        <dl id="reading">
            <dt>@PageText.Soc</dt>
            <dd id="reading-soc">@(reading.SocPercent is { } soc ? $"{soc:0} %" : PageText.NotSaid.ToString())</dd>
            <dt>@PageText.Range</dt>
            <dd>@(reading.RangeMetres is { } metres ? $"{metres / 1000:0} km" : PageText.NotSaid.ToString())</dd>
            <dt>@PageText.Plug</dt>
            <dd id="reading-plug">@Plug(reading.PlugState)</dd>
            <dt>@PageText.Charging</dt>
            <dd id="reading-charge">@Charge(reading.ChargeState)@(reading.ChargeTimeRemaining is { } left && reading.ChargeState == CarChargeState.Charging ? ", " + PageText.ToGo.Format($"{(int)left.TotalHours}:{left.Minutes:00}") : null)</dd>
            <dt>@PageText.CapturedByCar</dt>
            <dd id="reading-captured">@Local(reading.CapturedAt)</dd>
            <dt>@PageText.Asked</dt>
            <dd>@(Feed.LastReadAt is { } at ? Local(at) : PageText.NotYet.ToString())</dd>
        </dl>
    }
    else
    {
        <p class="muted" id="reading-none">@PageText.NoReadingYet</p>
    }
</section>

<section>
    <h2>@PageText.SignInHeading</h2>

    <p class="muted">@PageText.SignInIntro</p>

    @if (SignIn.State is { Message: { } message } state)
    {
        <p id="signin-state" class="@(state.Step == SignInStep.Failed ? "error" : state.Step == SignInStep.SignedIn ? "ok" : null)">@message</p>
    }

    @if (SignIn.State.Step == SignInStep.CodeRequired)
    {
        <label for="code">@PageText.CodeLabel</label>
        <input id="code" autocomplete="one-time-code" inputmode="numeric" @bind="_code" @bind:event="oninput" />
        <div class="actions">
            <button type="button" id="code-submit" disabled="@_busy" @onclick="SubmitCodeAsync">@PageText.SubmitCode</button>
        </div>
    }

    <div class="actions">
        <button type="button" id="signin" class="@(SignIn.State.Step == SignInStep.CodeRequired ? "secondary" : null)"
                disabled="@(_busy || !Account.Current.IsComplete)" @onclick="SignInAsync">@PageText.SignIn</button>
        <button type="button" id="forget" class="secondary" disabled="@_busy" @onclick="Forget">@PageText.Forget</button>
    </div>

    <p class="muted">@(Session.Exists ? PageText.SessionSaved : PageText.NoSession) @PageText.KeptAs.Format(Session.Protection)</p>
</section>

<section>
    <h2>@PageText.AccountHeading</h2>

    <label for="username">@PageText.VwId</label>
    <input id="username" type="email" autocomplete="username" @bind="_username" />

    <label for="password">@PageText.Password</label>
    <input id="password" type="password" autocomplete="current-password" @bind="_password"
           placeholder="@(string.IsNullOrEmpty(Account.Current.Password) ? null : PageText.PasswordSaved.ToString())" />

    <label for="vin">@PageText.Vin</label>
    <input id="vin" autocomplete="off" @bind="_vin" />

    <div class="actions">
        <button type="button" id="account-save" class="secondary" disabled="@_busy" @onclick="SaveAccount">@PageText.SaveAccount</button>
    </div>

    @if (_accountMessage is { } saved)
    {
        <p id="account-message" class="@(_accountFailed ? "error" : "muted")">@saved</p>
    }

    <p class="muted">@PageText.AccountWarning</p>
</section>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _vin = string.Empty;
    private string _code = string.Empty;
    private Words? _accountMessage;
    private bool _accountFailed;
    private bool _busy;

    protected override void OnInitialized()
    {
        _username = Account.Current.Username;
        _vin = Account.Current.Vin;
        Feed.Changed += Refresh;
        Connection.Welcomed += OnWelcomed;
    }

    public void Dispose()
    {
        Feed.Changed -= Refresh;
        Connection.Welcomed -= OnWelcomed;
    }

    private void OnWelcomed(VehicleWelcome welcome) => Refresh();

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private string StatusText => Feed.Status switch
    {
        null => PageText.StatusWaiting.ToString(),
        { Healthy: true } => PageText.StatusReading.ToString(),
        _ => (Feed.StatusWords ?? PageText.StatusNotReading).ToString(),
    };

    private string? StatusClass => Feed.Status switch
    {
        { Healthy: true } => "ok",
        { NeedsOwner: true } => "error",
        _ => null,
    };

    private void SaveAccount()
    {
        _accountFailed = !Account.Save(_username, _password, _vin);
        _password = string.Empty;
        _accountMessage = _accountFailed
            ? PageText.AccountNotSaved
            : Account.Current.IsComplete ? PageText.AccountSavedSignIn : PageText.AccountIncomplete;
    }

    private async Task SignInAsync()
    {
        _busy = true;

        try
        {
            if (await SignIn.SignInAsync() is { Step: SignInStep.SignedIn })
            {
                Resume();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitCodeAsync()
    {
        _busy = true;

        try
        {
            if (await SignIn.SubmitAsync(_code) is { Step: SignInStep.SignedIn })
            {
                _code = string.Empty;
                Resume();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void Forget()
    {
        SignIn.SignOut();
        Feed.Stop(PageText.Forgotten);
    }

    // Signed in: back on the clock, starting with a read now.
    private void Resume()
    {
        Feed.Resume();
        Poller.Wake();
    }

    private string Local(DateTimeOffset at)
    {
        var zone = Connection.Car?.TimeZone is { Length: > 0 } id && TimeZoneInfo.TryFindSystemTimeZoneById(id, out var found)
            ? found
            : Time.LocalTimeZone;
        return TimeZoneInfo.ConvertTime(at, zone).ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);
    }

    private static Words Plug(CarPlugState? state) => state switch
    {
        CarPlugState.Connected => PageText.PlugConnected,
        CarPlugState.Disconnected => PageText.PlugDisconnected,
        _ => PageText.NotSaid,
    };

    private static Words Charge(CarChargeState? state) => state switch
    {
        CarChargeState.Charging => PageText.ChargeCharging,
        CarChargeState.Complete => PageText.ChargeComplete,
        CarChargeState.Idle => PageText.ChargeIdle,
        _ => PageText.NotSaid,
    };
}
