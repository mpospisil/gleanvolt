@page "/"
@implements IDisposable
@inject AccountStore Account
@inject VwWebsiteSignIn SignIn
@inject VolkswagenFeed Feed
@inject VolkswagenPoller Poller
@inject VwWebsiteSessionStore Session
@inject Gleanvolt.Providers.Client.Vehicle.VehicleProviderConnection Connection
@inject TimeProvider Time

@*
    The plugin's page (#410), shown in Gleanvolt's Car page: the account, the sign-in with the emailed
    code in the same four states as Gleanvolt's built-in volkswagen.de sign-in, the last reading and the
    feed's status. Opening it never starts a sign-in: only the buttons reach VW.
*@

<PageTitle>Volkswagen</PageTitle>

<h1>Volkswagen</h1>

<p id="status" class="@StatusClass">@StatusText</p>

<section>
    <h2>The last reading</h2>

    @if (Feed.LastReading is { } reading)
    {
        <dl id="reading">
            <dt>State of charge</dt>
            <dd id="reading-soc">@(reading.SocPercent is { } soc ? $"{soc:0} %" : "not said")</dd>
            <dt>Range</dt>
            <dd>@(reading.RangeMetres is { } metres ? $"{metres / 1000:0} km" : "not said")</dd>
            <dt>Plug</dt>
            <dd id="reading-plug">@Plug(reading.PlugState)</dd>
            <dt>Charging</dt>
            <dd id="reading-charge">@Charge(reading.ChargeState)@(reading.ChargeTimeRemaining is { } left && reading.ChargeState == CarChargeState.Charging ? $", {left.TotalHours:0}:{left.Minutes:00} to go" : null)</dd>
            <dt>Captured by the car</dt>
            <dd id="reading-captured">@Local(reading.CapturedAt)</dd>
            <dt>Asked</dt>
            <dd>@(Feed.LastReadAt is { } at ? Local(at) : "not yet")</dd>
        </dl>
    }
    else
    {
        <p class="muted" id="reading-none">No reading yet.</p>
    }
</section>

<section>
    <h2>Sign in to volkswagen.de</h2>

    <p class="muted">
        A cold sign-in always makes Volkswagen email a one-time code. Once you have entered it, this
        browser is remembered, so a restart of the plugin should not need another. If Volkswagen asks for a
        code again, the plugin stops reading the car until you sign in here; it never signs in by itself on a
        clock, which is how an account gets locked.
    </p>

    @if (SignIn.State is { Message: { } message } state)
    {
        <p id="signin-state" class="@(state.Step == SignInStep.Failed ? "error" : state.Step == SignInStep.SignedIn ? "ok" : null)">@message</p>
    }

    @if (SignIn.State.Step == SignInStep.CodeRequired)
    {
        <label for="code">The code from the email</label>
        <input id="code" autocomplete="one-time-code" inputmode="numeric" @bind="_code" @bind:event="oninput" />
        <div class="actions">
            <button type="button" id="code-submit" disabled="@_busy" @onclick="SubmitCodeAsync">Submit the code</button>
        </div>
    }

    <div class="actions">
        <button type="button" id="signin" class="@(SignIn.State.Step == SignInStep.CodeRequired ? "secondary" : null)"
                disabled="@(_busy || !Account.Current.IsComplete)" @onclick="SignInAsync">Sign in</button>
        <button type="button" id="forget" class="secondary" disabled="@_busy" @onclick="Forget">Forget the session</button>
    </div>

    <p class="muted">@(Session.Exists ? "A signed-in session is saved." : "No session is saved.") Kept as @Session.Protection.</p>
</section>

<section>
    <h2>The account</h2>

    <label for="username">VW ID (email)</label>
    <input id="username" type="email" autocomplete="username" @bind="_username" />

    <label for="password">Password</label>
    <input id="password" type="password" autocomplete="current-password" @bind="_password"
           placeholder="@(string.IsNullOrEmpty(Account.Current.Password) ? null : "Saved. Leave empty to keep it.")" />

    <label for="vin">VIN</label>
    <input id="vin" autocomplete="off" @bind="_vin" />

    <div class="actions">
        <button type="button" id="account-save" class="secondary" disabled="@_busy" @onclick="SaveAccount">Save the account</button>
    </div>

    @if (_accountMessage is { } saved)
    {
        <p id="account-message" class="@(_accountFailed ? "error" : "muted")">@saved</p>
    }

    <p class="muted">
        The password and the session are passwords to your Volkswagen account, which also unlocks and locates
        the car. They are kept in the plugin's data directory, never logged and never shown here again.
    </p>
</section>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _vin = string.Empty;
    private string _code = string.Empty;
    private string? _accountMessage;
    private bool _accountFailed;
    private bool _busy;

    protected override void OnInitialized()
    {
        _username = Account.Current.Username;
        _vin = Account.Current.Vin;
        Feed.Changed += Refresh;
        Connection.Welcomed += OnWelcomed;
    }

    public void Dispose()
    {
        Feed.Changed -= Refresh;
        Connection.Welcomed -= OnWelcomed;
    }

    private void OnWelcomed(VehicleWelcome welcome) => Refresh();

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private string StatusText => Feed.Status switch
    {
        null => "Waiting for the first reading.",
        { Healthy: true } => "Reading the car.",
        { Message: { } message } => message,
        _ => "Not reading the car.",
    };

    private string? StatusClass => Feed.Status switch
    {
        { Healthy: true } => "ok",
        { NeedsOwner: true } => "error",
        _ => null,
    };

    private void SaveAccount()
    {
        _accountFailed = !Account.Save(_username, _password, _vin);
        _password = string.Empty;
        _accountMessage = _accountFailed
            ? "The account could not be saved: the data directory is not writable."
            : Account.Current.IsComplete ? "Saved. Press Sign in." : "Saved. The VW ID, the password and the VIN are all needed.";
    }

    private async Task SignInAsync()
    {
        _busy = true;

        try
        {
            if (await SignIn.SignInAsync() is { Step: SignInStep.SignedIn })
            {
                Resume();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitCodeAsync()
    {
        _busy = true;

        try
        {
            if (await SignIn.SubmitAsync(_code) is { Step: SignInStep.SignedIn })
            {
                _code = string.Empty;
                Resume();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void Forget()
    {
        SignIn.SignOut();
        Feed.Stop("You forgot the session.");
    }

    // Signed in: back on the clock, starting with a read now.
    private void Resume()
    {
        Feed.Resume();
        Poller.Wake();
    }

    private string Local(DateTimeOffset at)
    {
        var zone = Connection.Car?.TimeZone is { Length: > 0 } id && TimeZoneInfo.TryFindSystemTimeZoneById(id, out var found)
            ? found
            : Time.LocalTimeZone;
        return TimeZoneInfo.ConvertTime(at, zone).ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string Plug(CarPlugState? state) => state switch
    {
        CarPlugState.Connected => "connected",
        CarPlugState.Disconnected => "disconnected",
        _ => "not said",
    };

    private static string Charge(CarChargeState? state) => state switch
    {
        CarChargeState.Charging => "charging",
        CarChargeState.Complete => "complete",
        CarChargeState.Idle => "not charging",
        _ => "not said",
    };
}
