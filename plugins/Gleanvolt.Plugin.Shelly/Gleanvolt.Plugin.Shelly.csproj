<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The Shelly TopAC Portable EV Charger as a charger plugin (#429, #435): the first charger driver that runs
    outside Gleanvolt. Gleanvolt is set to the "External plugin" charger driver, and this reads and commands the
    charger over its local Gen2 RPC API, with its own page for the charger's address. Built with the solution,
    never packed, and not shipped: only a plugin that stands in for a built-in ships (#426). It references only
    the provider SDK: nothing of Gleanvolt.Core, Gleanvolt.Devices or Gleanvolt.Infrastructure.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UserSecretsId>gleanvolt-plugin-shelly</UserSecretsId>

    <!-- As the OpenWeather plugin: Blazor's script comes in a pack the SDK adds only when it sees .razor files. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gleanvolt.Hosting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gleanvolt.Providers.Client\Gleanvolt.Providers.Client.csproj" />
  </ItemGroup>

</Project>
